!.gitignore

#
#Generic
#

.directory
.mailmap
*.orig
*.rej
*.*~
.hg/
*.kdev*
.DS_Store
CMakeLists.txt.user
*.bak
*.patch
*.diff
*.REMOTE.*
*.BACKUP.*
*.BASE.*
*.LOCAL.*

#
# IDE & other softwares
#
/.settings/
/.externalToolBuilders/*
/.vs
# exclude in all levels
nbproject/
.sync.ffs_db
*.kate-swp
reset.sh

#
# Eclipse
#
*.pydevproject
.metadata
.gradle
tmp/
*.tmp
*.swp
*~.nib
local.properties
.settings/
.loadpath
.project
.cproject
.vscode
.idea

#
# Agent tooling
#
.agents/plans/**
.claude/settings.local.json

#
# The travel graph's generated SQL: kept locally in the base checkout, not in git
# (wow-bots hub, .claude/docs/server-tools.md, Travel graph)
#
/data/sql/playerbots/updates/*_playerbots_travelnode*_merged-*.sql
# The known danger table's generated rows (awareness; the hub's tools/awareness/danger-build.js)
/data/sql/playerbots/updates/*_playerbots_known_danger_rows.sql
