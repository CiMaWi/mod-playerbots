#

# Distances are in yards
Playerbots.FarDistance = 20.0
Playerbots.SightDistance = 100.0
Playerbots.SpellDistance = 28.5
Playerbots.ShootDistance = 5.0
Playerbots.HealDistance = 38.5
Playerbots.LootDistance = 15.0
Playerbots.FleeDistance = 5.0
Playerbots.AggroDistance = 22
Playerbots.TooCloseDistance = 5.0
Playerbots.MeleeDistance = 0.75
Playerbots.FollowDistance = 1.5
Playerbots.WhisperDistance = 6000.0
Playerbots.ContactDistance = 0.45
Playerbots.AoeRadius = 10
Playerbots.RpgDistance = 200
Playerbots.GrindDistance = 75.0
Playerbots.ReactDistance = 150.0

# Caps each bot's own sight range (yards) on world maps (the continents), so real players can see farther than bots.
# With Visibility.Distance.Continents = 250 in worldserver.conf, real players see 250 yards and bots still show to them
# out to 250, while each bot sees the player and everything else (and keeps map cells active) only to this range.
# Instances, battlegrounds, Wintergrasp and objects with their own visibility distance keep their ranges.
# Needs the core's per-player sight cap (Player::SetSightRangeCap). Applied at bot login; changing it needs a relog.
# Default: 0 (off: bots see as far as real players, the map range)
Playerbots.BotSightRangeCap = 0

#
#
####################################################################################################

####################################################################################################
# THRESHOLDS
#

# Health/Mana levels
Playerbots.CriticalHealth = 25
Playerbots.LowHealth = 45
Playerbots.MediumHealth = 65
Playerbots.AlmostFullHealth = 85
Playerbots.LowMana = 15
Playerbots.MediumMana = 40
Playerbots.HighMana = 65

#
#
####################################################################################################

####################################################################################################
# QUESTS
#

# Bots pick their quest rewards
# yes = picks the most useful item, no = list all rewards, ask = pick useful item and lists if multiple
Playerbots.AutoPickReward = yes

# Sync quests with player (bots will complete quests the moment you hand them in and will not loot quest items.)
# Default: 1 (enabled)
Playerbots.SyncQuestWithPlayer = 1

# Bots will auto-complete quests for the player when handing in bots' quests
# Default: 0 (disabled)
Playerbots.SyncQuestForPlayer = 0

# Bots will drop obsolete quests
# Default: 1 (enabled)
Playerbots.DropObsoleteQuests = 1

#
#
####################################################################################################

####################################################################################################
# COMBAT
#

# Auto add dungeon/raid strategies when entering the instance if implemented
Playerbots.ApplyInstanceStrategies = 1

# Enable auto avoid aoe strategy
# Default: 1 (enabled)
Playerbots.AutoAvoidAoe = 1

# Only avoid aoe spells with a radius smaller than this value
Playerbots.MaxAoeAvoidRadius = 15.0

# A whitelist of aoe spell IDs that should not be avoided
Playerbots.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# Enable healer bot save mana strategy
# Default: 1 (enabled)
Playerbots.AutoSaveMana = 1

# Healer bot save mana threshold
# Default: 60 (60%)
Playerbots.SaveManaThreshold = 60

# Allow Paladin bots to use greater (class-wide) blessings when group size warrants it,
# instead of single-target blessings. Recipients and ranks are chosen by the blessing planner.
# 0 = disabled (single-target only)
# 1 = enabled in raid groups only
# 2 = enabled in all groups
# Default: 2
Playerbots.AutoGreaterBlessings = 2

# Seconds of remaining duration below which a paladin refreshes a blessing it owns.
# Default: 60
Playerbots.BlessingRefreshThresholdSeconds = 60

# Enable bots to use group reagent buffs: Gift of the Wild, Arcane Brilliance,
# Prayer of Fortitude, Prayer of Spirit, and Prayer of Shadow Protection.
# 0 = disabled
# 1 = enabled in raid groups only
# 2 = enabled in all groups
# Default: 2 (all groups)
Playerbots.AutoPartyBuffs = 2

# Bots tell the group when they attempt to use a reagent-based greater blessing or group buff
# but have to fall back to the single-target version because they are out of reagents.
# Default: 1 (enabled)
Playerbots.TellWhenMissingBuffReagents = 1

# Cooldown for the missing buff reagent message, in seconds.
# Default: 300 (5 minutes)
Playerbots.MissingBuffReagentMessageCooldown = 300

# When a ready check is issued out of combat, bots refresh missing/short buffs before reporting ready.
# A bot that still has buff work it can perform stays not-ready until the ready check ends; this
# includes missing reagents (the cast is attempted and fails). Uses the always-on "force rebuff"
# strategy: bots with strategy sets saved before this feature keep their saved set - reset their
# strategies or use "nc +force rebuff" to opt them in. The "rebuff" chat command starts the same
# buff pass without a ready check and works regardless of this setting.
# Default: 0 (disabled)
Playerbots.ForceRebuffOnReadyCheck = 0

# During a force-rebuff pass (ready check or the "rebuff" command), a buff is topped off (recast)
# once it drops more than this many seconds below its full duration, so buffs are refreshed toward
# maximum remaining time to last the fight. The effective margin never drops below the time the
# pass has already run, so small values are safe.
# Default: 60
Playerbots.ForceRebuffMarginSecs = 60

#
#
####################################################################################################

####################################################################################################
# CHEATS
#

# Enable/Disable maintenance command
# Learn all available spells and skills, assign talent points, refresh consumables, repair, enchant equipment, socket gems, etc.
# Applies if bot's level is above Playerbots.MinEnchantingBotLevel
# Default: 1 (enabled)
Playerbots.MaintenanceCommand = 1

# Enable/Disable specific maintenance command functionality for altbots
# Disable to prevent players from giving free bags, spells, skill levels, etc. to their altbots
# Default: 1 (enabled)
Playerbots.AltMaintenanceAmmo = 1
Playerbots.AltMaintenanceFood = 1
Playerbots.AltMaintenanceReagents = 1
Playerbots.AltMaintenanceConsumables = 1
Playerbots.AltMaintenancePotions = 1

Playerbots.AltMaintenanceBags = 1
Playerbots.AltMaintenanceMounts = 1
Playerbots.AltMaintenanceSkills = 1

# "Special Spells" consist of any spells listed in Playerbots.RandomBotSpellIds and Death Gate for Death Knights
Playerbots.AltMaintenanceClassSpells = 1
Playerbots.AltMaintenanceAvailableSpells = 1
Playerbots.AltMaintenanceSpecialSpells = 1
Playerbots.AltMaintenanceTalentTree = 1
Playerbots.AltMaintenanceGlyphs = 1
Playerbots.AltMaintenanceGemsEnchants = 1

Playerbots.AltMaintenancePet = 1
Playerbots.AltMaintenancePetTalents = 1

Playerbots.AltMaintenanceReputation = 1
Playerbots.AltMaintenanceAttunementQuests = 1
Playerbots.AltMaintenanceKeyring = 1

# Enable/Disable autogear command, which automatically upgrades bots' gear
# The quality is limited by AutoGearQualityLimit and AutoGearScoreLimit
# In-game syntax (the argument can only request at or below the configured limits):
#   autogear            - gear to the configured AutoGearQualityLimit / AutoGearScoreLimit
#   autogear green      - cap quality to uncommon (also: white/common, blue/rare, purple/epic,
#                         orange/legendary, artifact, heirloom)
#   autogear match      - match the commanding player's average item level, computed over the slots the
#                         player actually has filled so empty slots do not drag the target down
#   autogear 200        - target a specific item level (clamped to AutoGearScoreLimit when that is non-zero).
#                         Only positive whole numbers are accepted; negative or malformed values are rejected
#   autogear reset      - erase all equipped gear and regear from scratch (combinable: autogear reset green,
#                         autogear reset 200, autogear reset match)
#   autogear bis        - separate BiS command, see AutoGearBisCommand below
# Default: 1 (enabled)
Playerbots.AutoGearCommand = 1

# Enable/Disable autogear command on altbots
# Default: 1 (enabled)
Playerbots.AutoGearCommandAltBots = 1

# If 1 (enabled) chat command: autogear bis, gives bots BiS gear from the playerbots_bis_gear table
# whose item-level floor matches AutoGearScoreLimit (e.g. 290 = ICC, 245 = ToC,
# 125 = Kara, 78 = MC). See the AutoGearScoreLimit comment below for the full list.
# chat command: autogear bis x, (x must be positive integer) will give items based on value of x.
# If x is bigger than AutoGearScoreLimit, bis wont be given, if lower it will match x when giving items.
# Commands falls back to autogear when no tier matches or the table is empty for the bot's class/spec.
# Requires AutoGearQualityLimit = 4 and AutoGearCommand = 1.
# If AutoGearCommandAltBots = 1 it will be anbled for alt bots.
# Default: 0 (disabled)
Playerbots.AutoGearBisCommand = 0

# Equipment quality limitation for autogear command (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# Default: 3 (rare)
Playerbots.AutoGearQualityLimit = 3

# Equipment item level (not gearscore) limitation for autogear command (0 = no limit)
# Classic
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# TBC
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# WotLK
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# Default: 0 (no limit)
Playerbots.AutoGearScoreLimit = 0

# Enable/Disable cheats for bots
# "food" (bots eat or drink without using food or drinks from their inventory)
# "gold" (bots have infinite gold)
# "health" (bots immediately regenerate lost health)
# "mana" (bots have infinite mana)
# "power" (bots have infinite energy, rage, and runic power)
# "taxi" (bots may use all flight paths, though they will not actually learn them)
# "raid" (bots use certain cheats implemented into raid strategies)
# To use multiple cheats, separate them by commas below (e.g., to enable all, use "gold,health,mana,power,raid,taxi")
# Default: food, taxi, and raid are enabled
# "food" no longer feeds persistent bots (random bots that keep their possessions under honest travel, outside
# Playerbots.Upkeep.HandoutShare): they eat and drink what they bought, looted or conjured, and rest without it
Playerbots.BotCheats = "food,taxi,raid"

# List of attunement quests (comma-separated list of quest IDs) that are automatically completed for all bots.
# While mod-playerbots does not restore removed attunement requirements, other mods, such as mod-individual-progression, may do so.
# This is meant to exclude bots from such requirements.
#
# Defaults:
# Caverns of Time - Part 1
# - 10279, To The Master's Lair
# - 10277, The Caverns of Time
# Caverns of Time - Part 2 (Escape from Durnholde Keep)
# - 10282, Old Hillsbrad
# - 10283, Taretha's Diversion
# - 10284, Escape from Durnholde
# - 10285, Return to Andormu
# Caverns of Time - Part 2 (The Black Morass)
# - 10296, The Black Morass
# - 10297, The Opening of the Dark Portal
# - 10298, Hero of the Brood
# Magister's Terrace
# - 11481, Crisis at the Sunwell
# - 11482, Duty Calls
# - 11488, Magisters' Terrace
# - 11490, The Scryer's Scryer
# - 11492, Hard to Kill
# Serpentshrine Cavern
# - 10901, The Cudgel of Kar'desh
# Tempest Keep: The Eye
# - 10888, Trial of the Naaru: Magtheridon
# Battle for Mount Hyjal (Hyjal Summit)
# - 10445, The Vials of Eternity
# Black Temple
# - 10985, A Distraction for Akama
Playerbots.AttunementQuests = 10279,10277,10282,10283,10284,10285,10296,10297,10298,11481,11482,11488,11490,11492,10901,10888,10445,10985

#
#
####################################################################################################

####################################################################################################
# FLIGHTPATH
#

# Min random delay before the 1st follower bot clicks the flight-master (ms)
Playerbots.BotTaxiDelayMinMs = 350

# Upper bound for the overall taxi delay window (ms) – larger spreads big raids
Playerbots.BotTaxiDelayMaxMs = 5000

# Fixed gap added per group-slot so bots never take off together (ms)
Playerbots.BotTaxiGapMs = 200

# Extra small randomness added to each gap so launches don’t look robotic (ms)
Playerbots.BotTaxiGapJitterMs = 100

#
#
####################################################################################################

####################################################################################################
# PROFESSIONS
#

# Percentage of randombots in each class bucket that receive a class-matching
# weighted profession combination. The remaining randombots use the weighted
# random sane-pair profession pool.
# Default: 30
Playerbots.ClassMatchingProfessionChance = 30

# Automatically adds the 'master fishing' strategy to bots that have the fishing skill when the bots master fishes.
# Default: 1 (Enabled)
Playerbots.EnableFishingWithMaster = 1

# Distance from itself (in yards) that a bot with a master will search for water to fish
Playerbots.FishingDistanceFromMaster = 10.0

# Distance from itself (in yards) that a bot without a master will search for water to fish
# Currently not relevant since masterless bots will not fish
Playerbots.FishingDistance = 40.0

# Distance from water (in yards) beyond which a bot will remove the 'master fishing' strategy
Playerbots.EndFishingWithMaster = 30.0

#
#
####################################################################################################

#######################################
#                                     #
# RANDOMBOT-SPECIFIC SETTINGS         #
#                                     #
#######################################

####################################################################################################
# GENERAL
#

# Enable/Disable randomly generated password for randombot accounts
Playerbots.RandomBotRandomPassword = 0

# Minimum and maximum levels for randombots
Playerbots.RandomBotMinLevel = 1
Playerbots.RandomBotMaxLevel = 80

# Sync max randombot level with max level of online players
# Default: 0 (disabled)
Playerbots.SyncLevelWithPlayers = 0

# Concentrate randombots teleporting into level-appropriate open-world zones that hold a real
# (non-GM) player. Falls back to normal teleporting behaviour when no player's zone matches.
# Best paired with Playerbots.SyncLevelWithPlayers.
# Default: 0 (disabled)
Playerbots.RandomBotConcentrateInPlayerZone = 0

# Mark many quests ≤ bot level as complete (slows down bot creation)
# Default: 0 (disabled)
Playerbots.PreQuests = 0

# Enable LFG for randombots
# Default: 1 (enabled)
Playerbots.RandomBotJoinLfg = 1

# Allow randombots to join the Dungeon Finder for dungeons and raids of an expansion they have outleveled
# If disabled, randombots above level 60 do not queue for classic entries and randombots above level 70
# do not queue for TBC entries, even where the entry's level range allows it (Stratholme is 55-65)
# Seasonal bosses are exempt
# Default: 1 (enabled)
Playerbots.RandomBotJoinLfgOutleveledExpansion = 1

# Percentage ratio of Alliance and Horde randombots
Playerbots.RandomBotAllianceRatio = 50
Playerbots.RandomBotHordeRatio = 50

# Disable logging in of death knight bots
Playerbots.DisableDeathKnightLogin = 0

# Enable simulated expansion limitation for talents and glyphs
# If enabled, limits talent trees to 6 rows plus the middle talent of the 7th row for bots until level 61
# and 8 rows plus the middle talent of the 9th row for bots from level 61 until level 71
# Default: 0 (disabled)
Playerbots.LimitTalentsExpansion = 0

# Configure randombot trading (0: Disabled, 1: Enabled, 2: Only Buy, 3: Only Sell)
# Default: 1 (enabled)
Playerbots.EnableRandomBotTrading = 1

# Configure message prefixes which will be excluded in analysis in trade action to open trade window
Playerbots.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

# Allow bots to send mail. When disabled, bots will not mail items or money in
# response to chat commands ("send mail").
# Default: 1 (enabled)
Playerbots.BotSendMailEnabled = 1

#
#
####################################################################################################

####################################################################################################
# LEVELS
#

# Disable randombots being generated with a random level
# If disabled, every randombot starts on a specified level (but can still level up by killing mobs and questing)
Playerbots.DisableRandomLevels = 0

# Set randombots' starting level here if "Playerbots.DisableRandomLevels" is enabled
Playerbots.RandombotStartingLevel = 1

# Chance randombot has min level on first randomize
# Default: 0.1 (10%)
Playerbots.RandomBotMinLevelChance = 0.1

# Chance randombot has max level on first randomize
# Default 0.1 (10%)
Playerbots.RandomBotMaxLevelChance = 0.1

# Fix the level of randombots (they won't level up)
# Default: 0 (disabled)
Playerbots.RandomBotFixedLevel = 0

# Set RandomBotMaxLevel bots to RandomBotMinLevel
# Refused while Playerbots.Population.Persistent = 1 (see POPULATION)
# Default: 0 (disabled)
Playerbots.DowngradeMaxLevelBot = 0

# Set XP rate for randombots (Default: 1.0)
# Server XP Rate * Playerbots.RandomBotXPRate
Playerbots.RandomBotXPRate = 1.0

#
#
####################################################################################################

####################################################################################################
# POPULATION
#
# Persistent population: random bots keep their progress like the characters of real players.
#
# Persistence mode: with it on, no code path lowers a random bot's level.
#   - The periodic randomize never rerolls a bot (also not one below level 3) and never downgrades a
#     max-level bot: it refreshes gear and talents at the bot's current level.
#   - The console commands "playerbots rndbot init" re-initialise a bot at its current level and
#     "playerbots rndbot clear" keeps it (the level stays, the XP within the level is reset).
#   - Playerbots.DowngradeMaxLevelBot, Playerbots.ResetBotLevel.Enabled and
#     Playerbots.LevelBrackets.Enabled are refused: a warning at startup and on ".reload config" for
#     each one that is set, and the level management below does not run.
#   - Any other path that would give a random bot a lower level (bot "init=" commands at a lower
#     master level, for example) keeps the bot's current level and logs a warning.
#   - Characters created from now on stay at their creation level (1, Death Knights 55) and level up
#     by playing; Playerbots.DisableRandomLevels and Playerbots.RandombotStartingLevel are not applied.
# Levels still go up (quests, kills). Picked up by ".reload config".
# Default: 0 (off, upstream behaviour)
Playerbots.Population.Persistent = 0

# Roster above the online cap, rotated by schedule. More random bot characters exist than are online
# (the count Playerbots.RandomBotCountMode sets stays the online cap); every IntervalSeconds the rotation
# swaps online bots for offline ones of the same faction. Each bot is owed a share of online time
# (cap / eligible roster); a bot a real player knows (Playerbots.Acquaintance.Enable, score >=
# AcquaintedMinScore) is owed AcquaintedSharePct, as far as the cap allows. The most over-served
# online bots make way for the most owed offline ones; a bot in a group, battleground, arena queue,
# instance, combat or flight is not logged out. Bots away on an arena server (ladder) never log in
# and do not count toward the cap. The schedule lives in memory (a restart starts it afresh).
# GM commands: ".playerbots population status" and ".playerbots population selftest".
# Default: 0 (off, upstream behaviour)
Playerbots.Population.Rotation.Enable = 0

# Random bot characters in the roster. Accounts are made at startup for max(this, the online cap);
# with more characters on the random bot accounts, the oldest (lowest guids) form the roster.
# With Playerbots.Population.Persistent = 1 as well, the startup factory makes characters only up
# to this count (not every account full), so bots ".playerbots population resize" deleted stay
# deleted, and the accounts get a tenth more slots for a resize's new bots. Set it to the count of a
# resize's done line before the next start.
# 0 = every character on the random bot accounts.
# Default: 2500
Playerbots.Population.Rotation.RosterSize = 2500

# Seconds between two rotation ticks (minimum 10)
# Default: 300
Playerbots.Population.Rotation.IntervalSeconds = 300

# Mean length of an online session in minutes: each tick swaps about online x interval / mean session
# bots.
# Default: 120
Playerbots.Population.Rotation.MeanSessionMinutes = 120

# A swapped bot stays online (and a bot logged out stays offline) at least this many minutes before
# the rotation swaps it again (at most MeanSessionMinutes).
# Default: 30
Playerbots.Population.Rotation.MinSessionMinutes = 30

# Online share per day (percent) owed to a bot a real player knows. Never below the fair share
# cap / roster; lowered when the acquainted bots alone would exceed the cap.
# Default: 90
Playerbots.Population.Rotation.AcquaintedSharePct = 90

# The acquaintance score from which a bot counts as known (Playerbots.Acquaintance.*; minimum 1).
# Default: 1
Playerbots.Population.Rotation.AcquaintedMinScore = 1

# Level-range balance by levelling speed. The levels below the max level form ranges of RangeSize
# levels (1-9, 10-19, ..., 70-79), the max level a range of its own. Each range's target is an equal
# share of the population, the max level range MaxLevelWeightPct of one share. Every IntervalMinutes
# the ranges are counted (the rotation roster when Rotation.Enable = 1, else the online random bots;
# no DB query) and each range gets an XP multiplier (times Playerbots.RandomBotXPRate): over its
# target the range's bots level faster, under it slower; not for bots grouped with a real player.
# With the rotation on, bots of an over-target range are also owed less online time and those of an
# under-target range more (LogoutPreferencePct). The controller is slow on purpose: it learns over
# days how long each range takes (ResponseHours); a quick change of counts moves it only a little
# (GainPct). No level ever goes down. GM command: ".playerbots population status".
# Default: 0 (off, upstream behaviour)
Playerbots.Population.Balance.Enable = 0

# Minutes between two counts of the ranges
# Default: 10
Playerbots.Population.Balance.IntervalMinutes = 10

# Levels per range below the max level (raised if there would be more than 32 ranges)
# Default: 10
Playerbots.Population.Balance.RangeSize = 10

# Target of the max level range against one other range's, in percent (200 = double share)
# Default: 200
Playerbots.Population.Balance.MaxLevelWeightPct = 200

# Bounds of the XP multiplier, in percent (minimum 1-100, maximum 100 or more)
# Default: 50, 300
Playerbots.Population.Balance.MinMultiplierPct = 50
Playerbots.Population.Balance.MaxMultiplierPct = 300

# No correction while a range is within this many percent of its target (at least the counting noise
# of a small range: one standard deviation, 100 / sqrt(target) percent)
# Default: 10
Playerbots.Population.Balance.DeadbandPct = 10

# How strongly the multiplier follows the current count: percent of log(count / target), the count
# smoothed over 6 hours
# Default: 50
Playerbots.Population.Balance.GainPct = 50

# The hours over which the measured count of a range is smoothed (counting noise). Shorter reacts
# faster and counts more noise; 6 is the tuned value, a short value is for tests only
# (in a run of minutes use 0.05)
# Default: 6
Playerbots.Population.Balance.SmoothingHours = 6

# How fast the multiplier learns: a range twice its target for this many hours has its multiplier
# raised about 2x more. Keep it at least the time a bot needs from level 1 to the max level; shorter
# lets the bots bunch into waves.
# Default: 384 (16 days)
Playerbots.Population.Balance.ResponseHours = 384

# With Rotation.Enable = 1: the online share of a range twice (half) its target is weighted
# 1 - (1 +) this percent (maximum 90; 0 = no logout preference)
# Default: 25
Playerbots.Population.Balance.LogoutPreferencePct = 25

#
# Playerbots.Population.Retire.Enable (H4)
# Description: In a level range persistently over its Balance target, deletes offline roster
#              bots no real player knows, so new level-1 bots can take their place. A bot is
#              kept when a real player has an acquaintance score above Retire.MaxScore with it,
#              it is in a guild with a real player's character, on a real player's friend list,
#              in any arena team or group, leads a guild, is named in a ladder roster, is away on
#              an arena server, is online, or sits on a lab-bots clone account. A range never
#              falls below its target; the range of level 1 is never retired from. Only random
#              bot characters are deleted (completely: also their playerbots and mod-ollama-chat
#              rows), never another character; the account stays, and a new bot of the same
#              class (level 1; a death knight at its start level) is created on it right after,
#              so the character count stays constant. No pass runs while a replacement is owed;
#              one given up (Retire.CreateAttempts) pauses the retires until ".reload config"
#              and the factory refills the account at the next startup. One log line per
#              retire and per creation.
#              Needs Population.Persistent = 1, Acquaintance.Enable = 1, Rotation.Enable = 1 and
#              Balance.Enable = 1 (or Retire.TestRange); else one error line and nothing happens.
#              Keep it 0 on labs with lab-bots clones.
# Default:     0 - off
#              1 - on (see Retire.DryRun)
Playerbots.Population.Retire.Enable = 0

# Playerbots.Population.Retire.DryRun
# Description: Logs "would retire" and "would create" lines; deletes and creates nothing.
#              Switching to 0 (".reload config")
#              waits one interval before the first delete, as does switching Retire.Enable on.
# Default:     1 - logs only
#              0 - deletes
Playerbots.Population.Retire.DryRun = 1

# Playerbots.Population.Retire.IntervalSeconds
# Description: Seconds between two passes (minimum 10)
# Default: 600
Playerbots.Population.Retire.IntervalSeconds = 600

# Playerbots.Population.Retire.MaxPerPass
# Playerbots.Population.Retire.MaxPerHour
# Description: Bots retired at most per pass and per sliding hour (dry-run picks count too).
#              Each retire runs a few synchronous queries on the world thread (the core's delete).
# Default: 1, 10
Playerbots.Population.Retire.MaxPerPass = 1
Playerbots.Population.Retire.MaxPerHour = 10

# Playerbots.Population.Retire.MaxScore
# Description: The highest acquaintance score a retired bot may have with any real player.
#              0 = never-met bots only. Higher values allow barely-met bots; they go only after
#              every never-met candidate of the range.
# Default: 0
Playerbots.Population.Retire.MaxScore = 0

# Playerbots.Population.Retire.PersistMinutes
# Description: A range is retired from once it has been over its target (beyond the Balance
#              deadband) for this many minutes
# Default: 60
Playerbots.Population.Retire.PersistMinutes = 60

# Playerbots.Population.Retire.Candidates
# Description: Bots a pass checks against the database (guild, friends, arena teams, groups,
#              ladder roster), 1-500
# Default: 50
Playerbots.Population.Retire.Candidates = 50

# Playerbots.Population.Retire.TestRange
# Playerbots.Population.Retire.TestTarget
# Description: Test only: retire from this range ("first-last", e.g. "1-9") down to this
#              target instead of the Balance ranges. Empty = off.
# Default: "", 0
Playerbots.Population.Retire.TestRange = ""
Playerbots.Population.Retire.TestTarget = 0

# Playerbots.Population.Retire.CreateAttempts
# Description: Tries per replacement, 1-10: a failed creation is tried again one interval later,
#              a saved row not found a few seconds later. Then it is given up: one error line,
#              the retires pause until ".reload config", and the roster is short by one until
#              the next restart.
# Default: 3
Playerbots.Population.Retire.CreateAttempts = 3

# Playerbots.Population.Retire.SummaryMinutes
# Description: Minutes between two summary lines (retires, creations, failures, owed
#              replacements, roster size and the random bot accounts' character count).
#              0 = no summary.
# Default: 60
Playerbots.Population.Retire.SummaryMinutes = 60

#
#
####################################################################################################

####################################################################################################
# RANDOM BOT LEVEL MANAGEMENT (LEVEL BRACKETS + LEVEL RESET)
#
# Two independent, opt-in sub-features for managing random bot levels over time. Both pick up
# changed values on the standard ".reload config" GM command.
#
#   - Level Brackets: periodically redistributes random bots across configurable per-faction level
#     brackets, optionally weighting the distribution toward brackets that contain real (non-bot)
#     players. This complements Playerbots.DowngradeMaxLevelBot-style behavior: instead of a
#     one-shot downgrade, it continuously rebalances the whole random bot population across brackets
#     over time.
#
#   - Level Reset: when a random bot reaches a configured max level, resets it back down to a lower
#     level via a full PlayerbotFactory randomize, with an optional percent chance (optionally
#     scaled by level), an optional minimum played-time restriction, and an optional "skip" that
#     sends a bot straight to a different level as soon as it reaches a configured trigger level.
#
# NOTE: Level Reset overlaps with Playerbots.DowngradeMaxLevelBot, which downgrades a bot that is
#       already at RandomBotMaxLevel to RandomBotMinLevel the next time it is periodically
#       re-randomized. Level Reset instead acts immediately (or on a played-time timer) as soon as a
#       bot reaches the configured level, with its own chance/played-time controls. Do not normally
#       enable both Playerbots.DowngradeMaxLevelBot and Playerbots.ResetBotLevel.Enabled at the
#       same time.
#

##############################################
# Level Brackets
##############################################

# Enables the level brackets feature.
# Default: 0 (disabled)
Playerbots.LevelBrackets.Enabled = 0

# The frequency (in seconds) at which the bot level distribution check is performed.
# Default: 300
Playerbots.LevelBrackets.CheckFrequency = 300

# The frequency (in seconds) at which pending level resets are processed for safe bots and flagged
# bots that failed safety checks initially.
# Default: 15
Playerbots.LevelBrackets.CheckFlaggedFrequency = 15

# Maximum number of flagged bots to process per pending level change step.
# 0 = unlimited (process all flagged bots each step)
# Default: 5
Playerbots.LevelBrackets.FlaggedProcessLimit = 5

# When enabled, bots in a guild led by a real (non-bot) player are excluded from bot bracket
# calculations and will not be level changed or flagged. Backed by the shared PlayerbotGuildMgr
# guild cache (validated at startup and refreshed hourly), which also covers offline players; a
# guild counts as real when its leader is not a random-bot account.
# Default: 1 (enabled)
Playerbots.LevelBrackets.IgnoreGuildBotsWithRealPlayers = 1

# When enabled, bots that are members of arena teams are excluded from bot bracket calculations
# and will not be level changed or flagged. This prevents bots in arena teams from being changed,
# which would break team compositions.
# Default: 1 (enabled)
Playerbots.LevelBrackets.IgnoreArenaTeamBots = 1

# Ignore bots that are on real players' friends lists from any brackets.
# Default: 1 (enabled)
Playerbots.LevelBrackets.IgnoreFriendListed = 1

# Comma-separated list of bot names to exclude from all bracket checks. Names must match the
# character name exactly (character names are stored capitalized, e.g. "Thrall").
# Default: ""
Playerbots.LevelBrackets.ExcludeNames =

# The number of level brackets used for bot distribution. Both Alliance and Horde should have the
# same number of brackets defined below.
# Default: 9
#
# IMPORTANT: If you extend the number of brackets beyond 9, you must add configuration lines for
#            the additional bracket lines below (e.g. Range10, Range11, etc.) to both your
#            playerbots.conf and this playerbots.conf.dist. Ensure that the sum of the Pct values
#            for each faction remains 100.
Playerbots.LevelBrackets.NumRanges = 9

# Enables dynamic recalculation of bot distribution percentages based on the number of non-bot
# players present in each level bracket. This overrides any custom brackets in the conf.
# Default: 0 (disabled)
Playerbots.LevelBrackets.Dynamic.UseDynamicDistribution = 0

# Controls how much extra weight is given to brackets (level ranges) that contain real (non-bot)
# players, when dynamic distribution is enabled. The higher this value, the more bots move to the
# same level brackets where real players are found, but the effect is gentle, not extreme. A value
# of 0.0 means bots always distribute evenly across all brackets, regardless of where players are.
# The default value of 1.0 gives a mild, balanced effect. Raising this to 3.0, 5.0, or higher makes
# bots concentrate more in brackets with real players. The value is a multiplier (not a percent):
# 0.0 = no extra effect, 1.0 = minimal, 3.0 = stronger, 5.0 = strong but not extreme. Experiment
# based on your total bot count and real player counts to find a good number for your server. If
# you want a large congestion of bots in your level bracket for solo play, 10-15 is recommended.
# What to expect:
#   - With 1.0 (default): if 6/10 real players are in one bracket, that bracket gets about 12.77%
#     of bots. All-empty brackets get about 10.69% each.
#   - With 3.0: same scenario: bracket gets about 15.73% of bots. All-empty brackets: 9.93% each.
#   - With 5.0: bracket with 6/10 real players gets 18.31%. All-empty brackets: 9.28% each.
#   - If all real players are in one bracket and weight is 5.0, that bracket gets about 21.56% of
#     bots (others: 9.80% each).
#   - With 0.0: every bracket always gets the same number of bots (e.g., 11.11% each for 9
#     brackets).
# Formula (per bracket):
#   bracket_weight = 1.0 + (RealPlayerWeight x (1 / TotalRealPlayers) x log(1 + RealPlayersInBracket))
#   All bracket weights are normalized to total 100%.
# Default: 1.0
Playerbots.LevelBrackets.Dynamic.RealPlayerWeight = 1.0

# If enabled, both Alliance and Horde must have identical bracket definitions (same number, same
# level bounds). All real players (regardless of faction) influence the dynamic distribution for
# both factions.
# Default: 0 (disabled)
# NOTE: If the brackets do not match when enabled, SyncFactions is forcibly disabled for that
#       session and an error is logged; the server will not fail to start over this.
Playerbots.LevelBrackets.Dynamic.SyncFactions = 0

##############################################
# Alliance Level Brackets Configuration
##############################################
# The following settings define the level brackets for Alliance bots. For each bracket, specify:
#
#    Playerbots.LevelBrackets.Alliance.RangeX.Lower
#        Description: The lower bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Alliance.RangeX.Upper
#        Description: The upper bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Alliance.RangeX.Pct
#        Description: The desired percentage of Alliance bots that should fall into bracket X.
#
# EXAMPLE:
#   The default configuration below defines 9 brackets: Range1 covers levels 1-9, Range2 covers
#   levels 10-19, Range3 covers levels 20-29, and so on.
#
#   To customize or add a new bracket (for example, to isolate level 60 in its own bracket):
#       - Set Range7.Lower = 60 and Range7.Upper = 60, then adjust the Pct values for Range6 and
#         Range8 accordingly.
#
#   To add an extra bracket beyond the default 9:
#       1. Increase Playerbots.LevelBrackets.NumRanges to the desired number.
#       2. Add configuration lines for the new RangeX.Lower, RangeX.Upper, and RangeX.Pct.
#
# NOTE: The sum of all Pct values for the Alliance brackets must equal 100.
#
Playerbots.LevelBrackets.Alliance.Range1.Lower = 1
Playerbots.LevelBrackets.Alliance.Range1.Upper = 9
Playerbots.LevelBrackets.Alliance.Range1.Pct   = 12

Playerbots.LevelBrackets.Alliance.Range2.Lower = 10
Playerbots.LevelBrackets.Alliance.Range2.Upper = 19
Playerbots.LevelBrackets.Alliance.Range2.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range3.Lower = 20
Playerbots.LevelBrackets.Alliance.Range3.Upper = 29
Playerbots.LevelBrackets.Alliance.Range3.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range4.Lower = 30
Playerbots.LevelBrackets.Alliance.Range4.Upper = 39
Playerbots.LevelBrackets.Alliance.Range4.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range5.Lower = 40
Playerbots.LevelBrackets.Alliance.Range5.Upper = 49
Playerbots.LevelBrackets.Alliance.Range5.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range6.Lower = 50
Playerbots.LevelBrackets.Alliance.Range6.Upper = 59
Playerbots.LevelBrackets.Alliance.Range6.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range7.Lower = 60
Playerbots.LevelBrackets.Alliance.Range7.Upper = 69
Playerbots.LevelBrackets.Alliance.Range7.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range8.Lower = 70
Playerbots.LevelBrackets.Alliance.Range8.Upper = 79
Playerbots.LevelBrackets.Alliance.Range8.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range9.Lower = 80
Playerbots.LevelBrackets.Alliance.Range9.Upper = 80
Playerbots.LevelBrackets.Alliance.Range9.Pct   = 11

##############################################
# Horde Level Brackets Configuration
##############################################
# The following settings define the level brackets for Horde bots. For each bracket, specify:
#
#    Playerbots.LevelBrackets.Horde.RangeX.Lower
#        Description: The lower bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Horde.RangeX.Upper
#        Description: The upper bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Horde.RangeX.Pct
#        Description: The desired percentage of Horde bots that should fall into bracket X.
#
# EXAMPLE:
#   The default configuration below defines 9 brackets: Range1 covers levels 1-9, Range2 covers
#   levels 10-19, Range3 covers levels 20-29, and so on.
#
#   To customize or add a new bracket (for example, to isolate level 70 in its own bracket):
#       - Set Range8.Lower = 70 and Range8.Upper = 70, then adjust the Pct values for the adjacent
#         ranges.
#
# NOTE: The sum of all Pct values for the Horde brackets must equal 100.
#
Playerbots.LevelBrackets.Horde.Range1.Lower = 1
Playerbots.LevelBrackets.Horde.Range1.Upper = 9
Playerbots.LevelBrackets.Horde.Range1.Pct   = 12

Playerbots.LevelBrackets.Horde.Range2.Lower = 10
Playerbots.LevelBrackets.Horde.Range2.Upper = 19
Playerbots.LevelBrackets.Horde.Range2.Pct   = 11

Playerbots.LevelBrackets.Horde.Range3.Lower = 20
Playerbots.LevelBrackets.Horde.Range3.Upper = 29
Playerbots.LevelBrackets.Horde.Range3.Pct   = 11

Playerbots.LevelBrackets.Horde.Range4.Lower = 30
Playerbots.LevelBrackets.Horde.Range4.Upper = 39
Playerbots.LevelBrackets.Horde.Range4.Pct   = 11

Playerbots.LevelBrackets.Horde.Range5.Lower = 40
Playerbots.LevelBrackets.Horde.Range5.Upper = 49
Playerbots.LevelBrackets.Horde.Range5.Pct   = 11

Playerbots.LevelBrackets.Horde.Range6.Lower = 50
Playerbots.LevelBrackets.Horde.Range6.Upper = 59
Playerbots.LevelBrackets.Horde.Range6.Pct   = 11

Playerbots.LevelBrackets.Horde.Range7.Lower = 60
Playerbots.LevelBrackets.Horde.Range7.Upper = 69
Playerbots.LevelBrackets.Horde.Range7.Pct   = 11

Playerbots.LevelBrackets.Horde.Range8.Lower = 70
Playerbots.LevelBrackets.Horde.Range8.Upper = 79
Playerbots.LevelBrackets.Horde.Range8.Pct   = 11

Playerbots.LevelBrackets.Horde.Range9.Lower = 80
Playerbots.LevelBrackets.Horde.Range9.Upper = 80
Playerbots.LevelBrackets.Horde.Range9.Pct   = 11

##############################################
# Level Reset
##############################################

# Enables the level reset feature.
# Default: 0 (disabled)
Playerbots.ResetBotLevel.Enabled = 0

# The maximum level a bot can reach before being reset.
# Default:     80
# Valid range: 2-80 (or 0 to disable the max-level reset check; SkipFromLevel/SkipToLevel still apply)
Playerbots.ResetBotLevel.MaxLevel = 80

# The level bots will be reset to. For Death Knights, if this is below the heroic starting level,
# they will be reset to the heroic starting level instead.
# Default:     1
# Valid range: 1-79 and < MaxLevel
Playerbots.ResetBotLevel.ResetToLevel = 1

# When a bot reaches exactly this level, it is sent directly to the level specified by SkipToLevel.
# This setting is not affected by ScaledChance or RestrictTimePlayed.
# Default:     0 (disabled)
# Valid range: 1-80 and < MaxLevel (or 0 to disable)
Playerbots.ResetBotLevel.SkipFromLevel = 0

# The level bots will be sent to when they reach SkipFromLevel. For Death Knights, if this is below
# the heroic starting level, they will be reset to the heroic starting level instead.
# Default:     1
# Valid range: 1-80 and <= MaxLevel
Playerbots.ResetBotLevel.SkipToLevel = 1

# The percent chance a bot has to have its level reset when reaching the max level (or the
# configured played time at max level).
# Default:     100
# Valid range: 0-100
Playerbots.ResetBotLevel.ResetChance = 100

# If enabled, the reset chance is (re-)rolled every level-up and scales based on the distance
# between the bot's level and MaxLevel. Bots have a small chance of resetting at lower levels,
# increasing as they approach MaxLevel, where the chance reaches ResetChance.
# Default: 0 (disabled)
Playerbots.ResetBotLevel.ScaledChance = 0

# If enabled, bots at MaxLevel will only have their level reset once they have played at least
# MinTimePlayed seconds at that level.
# Default: 0 (disabled)
Playerbots.ResetBotLevel.RestrictTimePlayed = 0

# If RestrictTimePlayed is enabled, the minimum time (in seconds) a bot must have played at its
# current level before a reset can occur at MaxLevel.
# Default: 86400 (3600 = 1 hour, 86400 = 1 day, 604800 = 1 week)
Playerbots.ResetBotLevel.MinTimePlayed = 86400

# If RestrictTimePlayed is enabled, the frequency (in seconds) at which the played-time check is
# performed for bots at or above MaxLevel.
# Default: 864
# Recommended: 1% of MinTimePlayed, or 300 seconds, whichever is higher.
Playerbots.ResetBotLevel.PlayedTimeCheckFrequency = 864

# When enabled, bots in a guild led by a real (non-bot) player are excluded from level reset
# processing. Backed by the same shared PlayerbotGuildMgr guild cache used by
# Playerbots.LevelBrackets.IgnoreGuildBotsWithRealPlayers (validated at startup and refreshed
# hourly), which also covers offline players; a guild counts as real when its leader is not a
# random-bot account.
# Default: 0 (disabled)
Playerbots.ResetBotLevel.IgnoreGuildBotsWithRealPlayers = 0

# Comma-separated list of bot names to exclude from level reset processing. Names must match the
# character name exactly (character names are stored capitalized, e.g. "Thrall").
# Default: "" (empty)
Playerbots.ResetBotLevel.ExcludeNames =

#
#
####################################################################################################

####################################################################################################
# GEAR
#

# Randombots automatically receive upgraded equipment on levelup
# Default: 1 (enabled)
Playerbots.AutoUpgradeEquip = 1

# Enable/disable which (if any) randombots preserve their current equipment and spec during login
# and periodic randomization (i.e., persistence).
# Default: 1 (enabled)
Playerbots.EquipAndSpecPersistence = 1

# If EquipAndSpecPersistence is enabled, equipment and talent persistence will affect randombots of this
# level or higher.
# Default: 1 (enable persistence for randombots of at least level 1 (i.e., all levels))
Playerbots.EquipAndSpecPersistenceLevel = 1

# Equipment quality limitation for randombots (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# This also sets the maximum quality that can be generated by autogear for randombots and altbots
# Default: 3 (rare)
Playerbots.RandomGearQualityLimit = 3

# Equipment item level (not gearscore) limitation for randombots (0 = no limit)
# Classic
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# TBC
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# WotLK
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# Default: 0 (no limit)
Playerbots.RandomGearScoreLimit = 0

# Prefer armor of the class's ideal type: apply 3x score multiplier to class-appropriate armor.
# When enabled, Warriors strongly prefer plate, Shamans prefer mail, etc.
# A truly superior item can still win (no hard filtering), but same-quality
# armor of the preferred type will score 3x higher and be equipped instead.
#
# ARMOR TYPE PREFERENCES:
#   Plate:   Warriors, Paladins, Death Knights
#   Mail:    Hunters, Shamans
#   Leather: Rogues, Druids
#   Cloth:   Priests, Mages, Warlocks
#
# Default: 0 (disabled)
Playerbots.PreferClassArmorType = 0

# When enabled, bots prefer spec-appropriate weapons based on speed and weapon type during autogear.
# Examples: Arms Warriors favor slow 2H axes/polearms (Axe Specialization), Combat Rogues
# favor a slow MH with a fast OH, and Enhancement Shamans favor synchronized slow 1H weapons.
# Default: 0 (disabled)
Playerbots.PreferredSpecWeapons = 0

# Set minimum level of bots that will enchant and socket gems into their equipment with maintenance
# If greater than RandomBotMaxlevel, bots will not automatically enchant equipment or socket gems
# Default: 60
Playerbots.MinEnchantingBotLevel = 60

# Enable expansion limitation for bot enchants and gems
# If enabled, bots will not use TBC enchants until level 61 or WotLK enchants and gems until level 71
# Default: 1 (enabled)
Playerbots.LimitEnchantExpansion = 1

# Enable expansion limitation for gear
# If enabled, bots will not equip TBC gear until level 61 or WotLK gear until level 71
# Default: 1 (enabled)
Playerbots.LimitGearExpansion = 1

# Chance randombot will have less-than-optimized generated gear
# Set between 0 (0%) and 1 (100%)
Playerbots.RandomGearLoweringChance = 0

# Unobtainable or unusable items (comma-separated list of item IDs)
# Defaults: Chilton Wand (12468), Frenzyheart Insignia of Fury test/on-use row (44869),
#           Oracle Talisman of Ablution test/on-use row (44870), Totem of the Earthen Ring (46978)
Playerbots.UnobtainableItems = 12468,44869,44870,46978

# Randombots check player's gearscore level and deny the group invitation if it's too low
# Default: 0 (disabled)
Playerbots.GearScoreCheck = 0

# Only set wolf pets for hunters for optimal raid performance (0 = disabled, 1 = enabled only for max-level bots, 2 = enabled)
# Default: 0 (disabled)
Playerbots.HunterWolfPet = 0

# Default pet stance when a bot summons a pet
# 0 = Passive, 1 = Defensive, 2 = Aggressive
# Default: 1 (Defensive)
Playerbots.DefaultPetStance = 1

# Enable/disable debug messages about pet commands
# 0 = Disabled, 1 = Enabled
# Default = 0 (disabled)
Playerbots.PetChatCommandDebug = 0

# Prohibit hunter bots from creating pets with any family ID listed below in ExcludedHunterPetFamilies
# See the creature_family database table for all pet families by ID (note: ID for spiders is 3)
Playerbots.ExcludedHunterPetFamilies = ""

#
#
####################################################################################################

####################################################################################################
# ACTIVITY
#

# BotActiveAlone
# - Controls how many bots are active when no real players are nearby.
# - Think of it as a rough percentage: 10 means approximately 10% of bots will be active.
#   Not exact — the actual number may vary slightly per rotation cycle.
# - The active bots rotate: every <DurationSeconds> a different set of bots takes a turn.
# - The real number of active bots will always be higher than this value, because bots in
#   combat, dungeons, battlegrounds, LFG queue, groups with real players, etc. are always
#   forced active on top of this (see force rules below).
# - Set to 100 (with SmartScale off) = all bots always active. Maximum server load.
# - Set to 0 = only bots that match a force rule below will be active.
#
# BotActiveAloneDurationSeconds
# - How often the active roster rotates (in seconds). A different group of bots wakes up
#   and the previous group may go idle.
# - This is a minimum, not exact. If a bot is in combat or meets any force rule when the
#   rotation happens, it stays active until those conditions end — it won't be cut off
#   mid-fight just because its turn expired.
#
Playerbots.BotActiveAlone = 10
Playerbots.BotActiveAloneDurationSeconds = 30

# Force-active rules (1 = on, 0 = off)
# These override the percentage above. If any of these conditions is true, the bot stays active.
#
# InRadius  - A real player is within this many yards (set to 0 to disable).
# InZone    - A real player is in the same zone (e.g. Elwynn Forest).
# InMap     - A real player is on the same continent (e.g. Eastern Kingdoms).
# IsFriend  - A real player has this bot on their friends list.
# InGuild   - This bot is in a guild that has a real player in it.
#
# Bots are also always forced active (not configurable) when:
#   in combat, inside a dungeon/raid/BG, in a BG or LFG queue,
#   grouped with a real player, or controlled by a real player.
#
Playerbots.BotActiveAloneForceWhenInRadius = 150
Playerbots.BotActiveAloneForceWhenInZone = 1
Playerbots.BotActiveAloneForceWhenInMap = 0
Playerbots.BotActiveAloneForceWhenIsFriend = 0
Playerbots.BotActiveAloneForceWhenInGuild = 1

# Headless test player (for unattended tests; 1 = on, 0 = off)
# Enables the GM/console commands
#   .playerbots testplayer login <character> [route=<name>]
#   .playerbots testplayer route <name>|none
#   .playerbots testplayer logout
#   .playerbots testplayer status
#   .playerbots testplayer whisper <character> <text>
#   .playerbots testplayer group <character>|none
# They log a character of the account below in through a server-side session without a client and without bot AI,
# so the bots count it as a real player (the force-active rules above apply), and walk it along a named route in a
# loop (stormwind-loop, elwynn-questing). A missing character is created (human warrior). The account must exist
# and must not be a random-bot account. The test player does not count as a real player for
# DisabledWithoutRealPlayer = 1 (it is not registered with the session manager); leave that option at 0 for tests.
#
Playerbots.TestPlayer.Enable = 0
Playerbots.TestPlayer.Account = "WBTEST"

# PvP test harness (for unattended tests; 1 = on, 0 = off)
# Enables the GM/console commands
#   .playerbots pvptest arena <teamA|name,name> <teamB|name,name> [map=na|be|rl|ds|rv|random] [rated=0|1] [seed=<n>]
#   .playerbots pvptest status
#   .playerbots pvptest stop
#   .playerbots pvptest plan start total=<n> [concurrency=<n>] [seed=<base>] [map=...] [pool=<pool>]
#   .playerbots pvptest plan status
#   .playerbots pvptest plan stop
#   .playerbots pvptest duel <botA> <botB>
#   .playerbots pvptest brawl <bot,bot,...> vs <bot,bot,...>
# "arena" forces one 2v2 arena match between two random-bot sides, each a 2v2 arena team name (quoted if it has
# spaces) or two bot names. All four bots must be at the maximum level. Offline bots are logged in, taken out of
# their groups and BG queues, put into one group per side and invited straight into a new arena (no queue wait).
# The match is unrated unless rated=1 (needs two arena teams). The map is drawn from the seed unless map= names it.
# The command returns at once; the result ("PVPTEST ... Winner: ...") goes to the playerbots log, to the issuing
# player and to "status". Afterwards the bots leave the arena, the two groups are disbanded and the bots' strategies
# are reset; bots the harness logged in stay online.
# "plan start" runs total=<n> matches in a row, up to concurrency=<n> at once (default 1, at most 4 and at most what
# the pool fits). Match k (1-based) replays seed <base>+k-1 (the base is drawn when seed= is missing). The pool is
#   random                 (default) random disjoint 2v2 sides of maximum-level random bots, drawn per match from the
#                          seed; bots with a real player and bots in a running match are left out. The candidates
#                          are read from the database once, when the plan starts.
#   teams:<A>;<B>;...      2v2 arena teams, two per match (quote the whole option if a name has spaces)
#   bots:<name>,<name>,... a list of bots, four per match
#   comps:<class>/<spec>+<class>/<spec>[;...]
#                          mirrored comps from the maximum-level random bots, one class/spec per slot (warlock/afflic
#                          or warlock/affliction, priest/shadow): side A takes a bot of each slot, side B a bot of the
#                          same class and spec with the nearest gear (summed item level of the equipment). Several
#                          comps (separated by ;) take turns. The candidates and their specs (from the talents of the
#                          active spec) are read from the database once, when the plan starts. A comp short of bots
#                          makes the plan wait ("plan status" says which slot); "plan stop" ends it.
# plan start also takes skill=<hi>:<lo> (needs Playerbots.Skill.Enable = 1): A plays at skill <hi> on odd matches and <lo>
# on even ones, B the other way round. arena takes skillA=<n> and skillB=<n>. The skill is set in memory when the
# match counts and restored from the bot's stored profile at tear-down (also after "stop"); the profile is never
# written. Each side of the record has forced {comp, skill} (null when nothing was forced).
# A match that cannot gather its bots is recorded as failed and the plan goes on; "plan stop" ends the running
# matches (recorded as stopped) and launches no more. One plan at a time; "stop" also stops the plan.
# Every finished, failed or stopped match appends one JSON line (schema 1, kind arena: id, plan, index, time, seed,
# map, outcome, winner, fightMs, totalMs and per side the bots with class, spec, gear score, damage, healing,
# killing blows, deaths; skill is null until the bots have one) to <LogsDir>/pvptest/matches-<YYYYMMDD>.jsonl. The
# line is built in memory; a writer thread owns the file. The line also carries the server and a match id (always);
# with Playerbots.MatchLog.Enable it also carries the ratings, honor and the real flag (see there).
# "duel" and "brawl" force an unrated fight in the open world (not in a battleground): the bots (maximum-level random
# bots, at most 5 per side) are logged in, taken out of groups, queues and combat, and teleported to FightLocation
# below, side A and side B facing each other. A duel is one bot against one bot (any factions): the first bot casts
# the duel spell, the second accepts through its duel strategy, full health and mana are restored first. A brawl has
# several bots per side; the two sides must be of opposite factions (same-faction bots are not hostile; use a duel),
# the bots are PvP-flagged, pointed at each other and re-pointed when a target dies; it ends when one side has no
# living bot. Unrated; nothing touches arena teams or ratings. When the fight is over (or the timeout below passes)
# the bots are revived, restored, taken out of combat and teleported back to where they were. One fight at a time.
# Each fight appends one JSON line like an arena match, with kind duel or brawl, arenaType 0, rated false, map = the
# zone name, faction = the real faction of the side, entered = the bot took part; damage and healing are counted
# for the hits and heals between the bots of the fight only.
# FightLocation "<map> <x> <y> <z> <o>": an open-world spot in a contested zone that allows duels and is no PvP
# prohibited zone (checked on arrival, else the fight is recorded as failed), away from towns and guards. The default
# is the Hillsbrad Foothills spot (Eastern Kingdoms), the "HillsbradFoothills" entry of game_tele.
# TimeoutSeconds (60..3600): a match without a winner by then is ended as a draw.
#
Playerbots.PvpTest.Enable = 0
Playerbots.PvpTest.TimeoutSeconds = 900
Playerbots.PvpTest.FightLocation = "0 -436.657 -581.254 53.5944 1.25917"

# World log (on when Dir is set)
# The server writes the world log to Dir, the session folder the hub's tools/ac.js sets on every start (empty = off):
# append-only CSV segments per stream (event, state, meta, decision, recorder), each with a header row, named
# <stream>-<yyyymmddhh>.csv after the UTC hour of their rows (<stream>-<yyyymmddhhmm>.csv when SegmentMinutes is below
# 60). The streams, columns and words are in the hub's .claude/docs/world-log.md. Dir is read at startup only.
# StateSeconds (5..3600): one state row per online player this often; real players and the bots within 100 yd of one
# also every 5 s.
# SegmentMinutes (1..60, rounded down to a divisor of 60): segment length; values below 60 are for tests.
# QueueRows (1..10000000): rows per stream that may wait for the writer; more are dropped and counted (meta drops rows
# every hour and at stop). The three numbers are re-read on .reload config (a meta reload row).
# Event rows (every player, real players too) include GoldIn/GoldOut (copper), ItemIn/ItemOut (item id, count), Death
# (creature, player, player_pet, environment), DeathReturn, QuestDone (quest id), PvpKill/PvpDeath (other player's
# guid; arena, battleground, world), Honesty<Kind> (module shortcuts), Stuck and Travel. The source of gold and of a
# return from death is the bot action that ran, as a word (loot, quest, vendor, repair, train, flight, mail, trade,
# corpse, spirit_healer) or the action's name, else "other".
# Recorder (bots): each bot keeps a ring of its last RecorderSeconds (0..3600, 0 = off): a position a second, the last
# RecorderActions (1..4096) actions its non-combat and dead engines executed with trigger and result (the combat
# engine's are left out), its last RecorderEvents (1..4096) events. A trigger dumps the ring as one case on the
# recorder stream: a Stuck event, a trip abort or leg failure, a second death within 10 minutes, a last-resort
# teleport, no movement for 5 minutes while busy, the same action failing 10 times in a row, a mark. At most one case
# per bot per RecorderCooldownSeconds (0..86400); a mark (the user's request) ignores it. About 9.5 KB per bot with
# the defaults (meta start row ring_bytes).
# Ring sizes apply to rings allocated after a reload; the cooldown too.
# Console: "playerbots worldlog status" (rows written, dropped and waiting per stream; the recorder's rings and cases),
# "playerbots worldlog selftest", "playerbots worldlog case <bot>" (a case of that bot now). In game (any player):
# ".wlog mark <text>" (a mark row at your place and a case of each bot within 60 yd).
#
Playerbots.WorldLog.Dir = ""
Playerbots.WorldLog.StateSeconds = 60
Playerbots.WorldLog.SegmentMinutes = 60
Playerbots.WorldLog.QueueRows = 200000
Playerbots.WorldLog.RecorderSeconds = 300
Playerbots.WorldLog.RecorderActions = 128
Playerbots.WorldLog.RecorderEvents = 64
Playerbots.WorldLog.RecorderCooldownSeconds = 600

# Acquaintances (1 = on, 0 = off)
# When 1, the server records which random bots each real player has met and how well: one row per (player, bot)
# pair in the playerbots table playerbots_acquaintance with a score, flags (group, whisper, partychat, trade, duel,
# guild, pvpkill, battleground, nearby) and the raw tallies the score comes from. Only real players' characters count
# (no bot AI attached, so the owner's own alt bots do not), and only random bots on the other side. The hooks only
# queue an event; the world thread counts it. All rows are loaded with one query at startup; changed rows are written
# every FlushSeconds (5..3600) by one asynchronous transaction, and after a real player's logout and at shutdown.
# Turning it on with a config reload loads the rows at the next tick; turning it off writes the changed rows once.
# GM command: .playerbots acquaintances [<player>] | stats | record <player> <bot> <kind> (record is a test aid that
# counts an event as the hooks do). With 0 (default) nothing is tracked, loaded or written.
#
# Score weights (points). The strongest are direct interactions and an explicitly invited group, then the guild;
# the weakest is plain closeness:
#   PointsDirect: a whisper to the bot, party chat in a group with the bot, a trade, a duel; at most once per
#     DirectCooldownSeconds per pair (the four share the cooldown).
#   PointsGroupJoin: the bot joins a group the real player leads (not dungeon finder or battleground groups); at most
#     once per GroupJoinCooldownSeconds per pair. PointsPerGroupMinute: per full minute in the same group.
#   PointsGuildJoin: the bot or the player joins the guild of the other (same cooldown as the group join).
#     PointsPerGuildHour: per full hour both are online in the same guild.
#   PointsPvpKill: one killed the other (cooldown as direct).
#   PointsPerNearbyMinute: per full minute near each other or on the same battleground team.
#   MaxScore caps the score of a pair; the score never falls while the weights stay.
#
# Time samplers (world thread, over the online real players only):
#   GroupSampleSeconds (1..3600): the random bots in the player's group get group time, those in the player's
#     battleground or arena team battleground time, those in a dungeon finder group nearby time.
#   GuildSampleSeconds (5..3600): the online random bots of the player's guild get guild time.
#   NearbyIntervalSeconds (0..3600, 0 = off): the random bots within NearbyRadius yards (1..100; same map and phase,
#     not in a battleground, not in the player's group) get nearby time. The weakest kind; turn it off on its own.
#
Playerbots.Acquaintance.Enable = 0
Playerbots.Acquaintance.FlushSeconds = 30
Playerbots.Acquaintance.DirectCooldownSeconds = 60
Playerbots.Acquaintance.GroupJoinCooldownSeconds = 600
Playerbots.Acquaintance.PointsDirect = 10
Playerbots.Acquaintance.PointsGroupJoin = 20
Playerbots.Acquaintance.PointsGuildJoin = 15
Playerbots.Acquaintance.PointsPvpKill = 5
Playerbots.Acquaintance.PointsPerGroupMinute = 5
Playerbots.Acquaintance.PointsPerGuildHour = 6
Playerbots.Acquaintance.PointsPerNearbyMinute = 1
Playerbots.Acquaintance.MaxScore = 1000000
Playerbots.Acquaintance.GroupSampleSeconds = 10
Playerbots.Acquaintance.GuildSampleSeconds = 60
Playerbots.Acquaintance.NearbyIntervalSeconds = 10
Playerbots.Acquaintance.NearbyRadius = 30

# Runtime arena team moves (1 = on, 0 = off)
# When 1, the GM/console commands .playerbots ladder depart <arenaTeamId> | arrive <arenaTeamId> | status [<id>] move
# one random bot arena team out of and back into the running server. depart stops the members queueing, waits until
# none of them is queued or in a battleground (refused while the team is pinned, see Playerbots.Ladder.ContactMinutes),
# logs them out, saves the team and drops it from memory (no DB row is deleted); arrive loads the team again from its
# DB rows with async queries and lets the members log in; an arrive while a depart still waits cancels the depart.
# Also: .playerbots ladder teams [pinned|busy] (the teams in memory with rating, MMR, members online, time hosted,
# busy and pinned), pin <arenaTeamId> [minutes] (a GM pin, test aid; 0 unpins), drain (no arena team member queues;
# queued members and running matches carry on; not kept over a restart) and undrain. Meant for the hub's ladder
# tooling. With 0 (default) the commands refuse unless Playerbots.Ladder.Role is set.
Playerbots.Ladder.Enable = 0

# Ladder role of this server (0 = off, 1 = main, 2 = arena instance). Read at startup.
# 0 (default): as without the option; the moves follow Playerbots.Ladder.Enable and keep who is away in memory only.
# 1 and 2 turn the moves on (whatever Playerbots.Ladder.Enable says) and keep a roster in the playerbots table
# playerbots_ladder_roster, written only by depart and arrive and loaded at startup.
# 1 (main): a member of a team that departed is away: it never logs in, also after a restart, and its team is dropped
# from memory at startup (no DB writes). Bots never auto-queue for rated arenas (the
# RandomBotAutoJoinBGRatedArena*Count options count as 0): main's arena matches come from the ladder only.
# 2 (arena instance): only the bots the roster hosts log in (the online cap is their count at most) and every other
# arena team is dropped from memory at startup (no DB writes; an empty roster hosts nothing). Bot arena teams are
# never created, deleted, formed or recruited for (RandomBotArenaTeam*Count count as 0; DeleteRandomBotArenaTeams,
# ArenaTeam.Formation.Enable and ArenaRecruit.Enable as 0).
Playerbots.Ladder.Role = 0

# Name of this server in .playerbots ladder status (e.g. main, arena1). Default: empty
Playerbots.Ladder.ServerId = ""

# Match log: every arena match that ends on this server (a match of bots, a harness match, a match with a real player)
# appends exactly one JSON line to <LogsDir>/pvptest/matches-<YYYYMMDD>.jsonl, the file and schema 1 of the PvP test
# harness (Playerbots.PvpTest.*), with these keys added: server (Playerbots.Ladder.ServerId, "main" when empty), matchId
# (<server>-<process start YYYYMMDDHHMMSS UTC>-<n>), source (organic, harness or player), real (a real player took
# part), ratingsKnown, per side teamName, teamRatingBefore/After and mmrBefore/After (null for an unrated match) and per
# bot real, honor, personalBefore/After, mmrChange and the cast counts (casts), which are counted for every bot of an
# arena from the moment its gates open. A harness match keeps its own record and id (m-...) and gets the same fields.
# One "MATCHLOG:" line per record in the log; .playerbots matchlog status shows the counts and the writer queue.
# The hooks run on the arena maps' threads and cost one capture per match; with 0 they return at once and no bot counts.
# Default: 0 (off: only harness matches write records)
Playerbots.MatchLog.Enable = 0

# Match traces (needs Playerbots.MatchLog.Enable = 1): one arena match in N (chosen by the FNV-1a hash of its match id)
# keeps a trace, written at its end as one JSON line to <LogsDir>/pvptest/traces-<YYYYMMDD>.jsonl with the match id of
# its record: units (guid, name, side A/B, class) and events with the time in ms since the gates opened: casts of the
# participants (cast_start for spells with a cast time, cast_finish, cancel; triggered spells and auto-repeat shots
# are left out), CC auras applied and removed (cc_on, cc_off: stun, root, fear, silence, sleep, polymorph, disorient,
# horror, incapacitate, charm, freeze, banish, shackle, turn, sap, disarm), deaths, the executed actions of the skill
# categories (action) and the positions and health every second (pos), then an end row with the winner side. Pets
# and totems are not traced (a pet's CC and kills name its owner). With 0 the hooks return after one test.
# .playerbots matchlog status shows the traces line; .playerbots matchlog traceselftest checks the format.
# Default: 0 (off)
Playerbots.MatchLog.TraceEvery = 0

# The caps of one trace: events (16-1000000) and the estimated bytes of its line (4096-67108864). A trace that reaches
# one keeps its deaths (a small reserve), drops every other later event, and ends with a "truncated" row (reason
# events or bytes, the number dropped). Defaults: 20000, 4194304
Playerbots.MatchLog.TraceMaxEvents = 20000
Playerbots.MatchLog.TraceMaxBytes = 4194304

# Natural tracer (G0e; 1 = on, 0 = off): a traced unit leaves a row every 100 ms (IntervalMs) and event rows, so the
# naturalness of bots (turns, reaction times, paths, cast timing) is measured from data. Traced are: the bots of a
# harness match started with trace=1 (.playerbots pvptest arena ... trace=1, or plan start ... trace=1), the players
# of organic arena matches (with Organic = 1; needs Playerbots.MatchLog.Enable = 1), and players switched on by a GM
# (.playerbots natural trace <player> on|off). Rows are buffered per unit and written by a writer thread to
# <Dir>/trace-<YYYYMMDD>.jsonl, one JSON object per line: "t" ms since the unit's trace start, "k" kind, "u" player
# guid counter, "m" match id (joins the match record of matches-<date>.jsonl; skill is never written; "" for a GM
# trace), then by kind:
#   start: src (harness, organic, gm), side (A, B or null), cls (class id), bot (true/false), iv (interval ms)
#   pos (at most one per interval slot, taken at the unit's first update in the slot; a missed slot is not
#     back-filled): x, y, z, o (facing), mf (movement flags), mov (moving), spl (spline active), run (run speed),
#     tg (target guid counter, 0 none), vi (victim), hp (health %), cs (current spell, channel first, 0 none), st
#     (its state), ce (elapsed ms of a cast, null for none or a channel), cr (remaining ms)
#   target (a target change, at the update it was seen): tg
#   cast_start (a cast with a cast time begins; a bot's from its CastSpell, a player's from the spell prepare): s
#     (spell), tg, ct (cast time ms)
#   cast_finish: s, tg; cancel: s, self (true = cancelled by the caster); interrupt (a bot's cast was interrupted): s
#   mv (a real player's movement packet, as received): op (opcode), mf, x, y, z, o
#   truncated (MaxRowsPerUnit reached; later rows are dropped); end: rows (kept), dropped
# Bots are sampled at the top of their AI update before any gate, other players after their update. With 0 (or no
# traced unit) every hook returns after one test. .playerbots natural status shows the counters, .playerbots natural
# selftest checks the sampler, .playerbots natural sample <N|off|config> overrides SampleEvery at runtime (off also
# ends every running trace). PerfMonitor rows: NaturalTraceSample, NaturalTraceEvent, NaturalTraceStart.
# A .reload config from 1 to 0 only stops new traces: running ones go on until their match ends, the unit logs out
# or .playerbots natural sample off ends them.
# Default: 0 (off)
Playerbots.Natural.Trace.Enable = 0

# Most units traced at once (1-1000); an organic match is traced whole or not at all. Default: 8
Playerbots.Natural.Trace.MaxUnits = 8

# One match in N is traced (chosen by the FNV-1a hash of its match id, as Playerbots.MatchLog.TraceEvery): harness
# matches with trace=1 and, with Organic = 1, organic arena matches. 1 = every such match, 0 = none. Default: 1
Playerbots.Natural.Trace.SampleEvery = 1

# 1 = organic arena matches chosen by SampleEvery are traced too (all their players); .playerbots natural organic
# <on|off|config> overrides it at runtime. Default: 0
Playerbots.Natural.Trace.Organic = 0

# The directory of the trace files; empty = <LogsDir>/natural. Created when missing. With Format = binary it is the
# root of the per-instance folders (see Format). Default: ""
Playerbots.Natural.Trace.Dir = ""

# The sample interval in ms (50-1000). Default: 100
Playerbots.Natural.Trace.IntervalMs = 100

# Rows kept per traced unit (100-10000000); then a truncated row and the rest dropped. Default: 200000 (5.5 h)
Playerbots.Natural.Trace.MaxRowsPerUnit = 200000

# The format of the trace files (G0i): jsonl = <Dir>/trace-<YYYYMMDD>.jsonl as above; binary = one file per traced
# match, <Dir>/<instance>/<YYYY-MM-DD>/<match id>.ntr (instance = Playerbots.Ladder.ServerId, main when empty; the day
# is the UTC day of the match's first trace start, so a match across midnight stays in one file while its traces
# overlap: a unit traced after every other trace of its match ended takes the day of its own start, after midnight a
# second file in the new day's folder; a GM trace is one file per session, gm-<guid counter>-<unix seconds>.ntr). A
# binary file is little endian: a versioned header (match id, instance, source, interval, a field table of the row
# kinds and fields above), then one block of rows per flushed batch of a unit (a pos row 49 bytes, about a quarter of
# its JSON); readers decode by the file's own field table. The writer thread creates the folders and opens a file per
# batch (no handle kept); a failed write is cut back to the file's size before it. Read at each trace start: a
# .reload config switches new traces only. An unknown value is logged and jsonl is used. Default: jsonl
Playerbots.Natural.Trace.Format = "jsonl"

# Natural reaction times and attention. Needs Playerbots.Skill.Enable = 1. With 1, the skill multiplier of the notice
# categories (interrupts, defensive cooldowns, dispels, crowd control, crowd-control breaks, target switches; see
# Playerbots.Skill.Notice*) waits a human reaction time instead of the uniform notice delay, counted from the event's
# start (the first time the bot considers the action after a quiet gap): log-normal with the median and log-space
# sigma lerped from skill 1 to skill 99 (along Playerbots.Skill.CurveExponent), at least MinMs, drawn once per event
# from a hash (no roll per tick). An event whose hostile target stands outside the bot's view cone (ConeDegrees wide)
# adds BehindPenaltyMin..MaxMs, and an event of another category than the one the bot last noticed (within
# FocusTimeoutMs) adds SwitchCostMin..MaxMs (one focus at a time). Playerbots.Skill.NoticeMissPercent* still misses
# whole events (for NoticeWindowMs). Contexts: where it applies (Arena, Battleground, World = open-world PvP, Pve, All);
# elsewhere the uniform notice delay stays. The default leaves out World: in G0h2-b's lab run the model's arm cost
# measurably more per tick (mostly the faster checks it comes with), so open-world PvP keeps the cheap uniform delay.
# Bots with a game-client master follow Playerbots.Skill.ExemptRealMasterBots.
# The medians follow the plan's estimate (about 220 ms at skill 99, about 600 ms at skill 20); sigma 0.25 is the
# spread of a simple visual reaction (about 6 % of the draws at skill 99 are raised to the minimum), 0.45 that of a
# choice under load. On a running server the options change after .reload config (re-reads the file) followed by
# .playerbots rndbot reload (re-reads the playerbots options; .reload config alone does not); changed medians and
# sigmas reach a logged-in bot at its next skill load. A bot whose engine was built while neither this option nor
# D4's noticing (Playerbots.Skill.Notice*) was on has no "skill" strategy: Enable takes effect for it only when its
# engine is rebuilt (its next login). .playerbots tactics show <bot> lists the bot's values (GM only),
# .playerbots tactics selftest reaction checks the maths. Medians 50-10000 ms, sigmas 0-2, penalties and times
# 0-10000 ms, cone 10-360 degrees.
# Default: 0 (off: the uniform notice delay, as before), Contexts "Arena,Battleground"
Playerbots.Natural.Reaction.Enable = 0
Playerbots.Natural.Reaction.MedianMsAtSkill1 = 690
Playerbots.Natural.Reaction.MedianMsAtSkill99 = 220
Playerbots.Natural.Reaction.SigmaAtSkill1 = 0.45
Playerbots.Natural.Reaction.SigmaAtSkill99 = 0.25
Playerbots.Natural.Reaction.MinMs = 150
Playerbots.Natural.Reaction.BehindPenaltyMinMs = 150
Playerbots.Natural.Reaction.BehindPenaltyMaxMs = 400
Playerbots.Natural.Reaction.SwitchCostMinMs = 100
Playerbots.Natural.Reaction.SwitchCostMaxMs = 300
Playerbots.Natural.Reaction.ConeDegrees = 200
Playerbots.Natural.Reaction.FocusTimeoutMs = 2000
Playerbots.Natural.Reaction.Contexts = "Arena,Battleground"

# End to end (with Playerbots.Natural.Reaction.Enable): the reaction counts from the event's server time instead of the
# bot's first look at it, taken from what a player in its seat sees: an enemy cast from its cast bar (a channel from its
# base duration, so a hasted channel looks a little older), a debuff to dispel and a crowd control to break from the
# aura's duration and time left (the newest such aura: a wrong pick is late, never early). Defensive cooldowns, crowd
# control and target switches have no visible start and count from the first look, and so does a start more than 3 s
# old. The target is the reaction plus PingMs (the modelled round trip: half to see the event, half for the answer to
# reach the server), DisplayMs (the client's frame and display) and ServerTickMs (the server's ticks; -1 = half the
# bot's last map update). The bot passes at its first AI check at or after the target minus its own check latency
# (learnt from how far its passes miss their targets; at a steady interval its mean overshoot), so its action lands on
# the target on average; a bot that first looks after that (busy, or a cast seen late) acts at once. No check is woken
# for it. It acts only where Playerbots.Natural.Cadence's faster check runs (Cadence.Enable, its Contexts, in combat in
# a started match), and the latency is capped at Cadence.CheckMs: at upstream's slower interval the latency would eat
# most of the draw, so elsewhere the reaction counts from the first look as without it. The engine's pass stands for the
# server's action (the bot's spell is handled in the same update). The playerbots.reaction trace lines add stamp (ms
# from the server time to the first look), src (0 first look, 1 cast bar, 2 aura, 3 a cast bar or aura older than
# 3 s: first look), target, e2e (server time to the pass; -1 missed), lat (the latency mean) and at (the pass's server
# ms). Ping and display 0-10000 ms, ServerTickMs -1 to 1000.
# Default: 0 (off: from the first look, as before), PingMs 60, DisplayMs 30, ServerTickMs -1
Playerbots.Natural.Reaction.EndToEnd = 0
Playerbots.Natural.Reaction.PingMs = 60
Playerbots.Natural.Reaction.DisplayMs = 30
Playerbots.Natural.Reaction.ServerTickMs = -1

# Reaction types (G0h3, with Playerbots.Natural.Reaction.Enable in its Contexts): each part has its own Enable
# (default 0: the reaction as above) and prices at attribute 1 and 99 (Playerbots.Skill.Attributes.*; with their
# defaults every ability is the skill), lerped along Playerbots.Skill.CurveExponent. Every cost lies inside the
# reaction (the trace's ready), so the end-to-end target keeps its sum. The playerbots.reaction trace lines add type
# (0 simple, 1 choice, 2 anticipated), options, load (other events pending), ease (0 common, 1 rare, 2 focus target,
# 3 new target), think (ms), cost (choice + load + ease + think, ms), busy and own (see Reeval).
# Choice (Wisdom): Hick's law, MsPerDoubling per doubling of the real options (one option: none; at most MaxOptions,
#   1-64). Counted from what the bot has already built: a target switch and crowd control from its attackers list;
#   an interrupt and a dispel are one option (no count without a new scan). 0-2000 ms.
# Load (Focus): per other pending event (at most MaxEvents, 1-5) MsPerEvent more and MissPercentPerEvent (0-100) more
#   miss share; an event that outranks every pending one (interrupt, defensive, cc break, dispel, crowd control, target
#   switch) keeps TopProtect (0-1) of both off.
# Ease (Dexterity): the price of the answer's button: Common (interrupts, dispels, crowd control) < Rare (defensive
#   cooldowns, cc breaks, strangulate, mass dispel) < Focus (an action on the focus target, G4e; below FocusDexterity,
#   1-99, a new target's price) < NewTarget (a target switch, or an action on an enemy other than the bot's target).
#   Each price is raised to 1 ms above the one before at both ends if needed, so the order holds at every Dexterity.
# Think (Wisdom): a decision's time, the Shortcut (the first event seen, no judgement: today's interrupt) or the Deep
#   check (charged by later tactics, which take it DeepPercent, 0-100, of the time); PatienceWaitMs (Patience trait 0
#   and 100, straight line) is how long a bot waits for a better moment (read by later tactics).
# Anticipate (Foresight): an interrupt the opponent memory predicts (the enemy cast the same spell the time before)
#   saves Share (0-0.95) of the draw, never below MinMs; it is no choice. Needs Memory.Enable for the memory to fill.
# Queue (Speed): a bot whose own cast or GCD ends before its next check checks MinMs-MaxMs after the end instead
#   (never later; its own timer, no wake-up), as a human mashing the button.
# Reeval (the user's notes of 2026-10-30): Enable stops the bot's own cast (MinOwnRemainingMs or more left) for a kick
#   of its target's cast of at least ImportantCastMs (a stand-in for judging the spell) that the own cast would end
#   too late for, once its reaction to the cast bar is over (draw and shortcut think cost, end to end from the bar's
#   start) and its interrupt is ready; the kick follows in the same check. Once per enemy cast; after a stop the kick
#   did not follow (its trigger or a higher action picked something else) none for 30 s. An opt-in stand-in until
#   G5b's judgement: it never weighs the own cast (a heal on a dying partner is stopped too). BusySkip drops a kick
#   that a bot busy with its own cast, the kick's cooldown or the GCD would land only within BusyMarginMs of the
#   cast's end or after it, when being busy is what makes it late (one late from its reaction alone is tried).
#   The trace's busy field: 1 stopped its own cast for the kick, 2 skipped; own: ms of own cast within the event.
# Memory (DT.12): per bot and match (cleared when it ends), the cast bars the bot sees on its target and attackers
#   (at most 8 enemies) at its own checks; a bar gone before its end without a visible interrupt (school lock,
#   silence, stun, fear, death) is a cancel. The fake rate counts from MinCasts (1-100) casts; a bar gone within
#   EndToleranceMs of its end finished. Anticipate reads it.
# Movement: avoid aoe as a reaction, stamped with the ground effect's start (a trap or trigger NPC: the first look);
#   only bots with the avoid aoe strategy have it (Playerbots.AutoAvoidAoe, bots with a real master).
# Times 0-10000 ms. On a running server .reload config then .playerbots rndbot reload switch the parts; changed
# prices reach a logged-in bot at its next skill load. .playerbots tactics show <bot> lists the bot's prices.
# Default: every part 0; the prices below
Playerbots.Natural.Reaction.Choice.Enable = 0
Playerbots.Natural.Reaction.Choice.MsPerDoublingAtSkill1 = 120
Playerbots.Natural.Reaction.Choice.MsPerDoublingAtSkill99 = 50
Playerbots.Natural.Reaction.Choice.MaxOptions = 8
Playerbots.Natural.Reaction.Load.Enable = 0
Playerbots.Natural.Reaction.Load.MsPerEventAtSkill1 = 200
Playerbots.Natural.Reaction.Load.MsPerEventAtSkill99 = 80
Playerbots.Natural.Reaction.Load.MissPercentPerEventAtSkill1 = 10
Playerbots.Natural.Reaction.Load.MissPercentPerEventAtSkill99 = 2
Playerbots.Natural.Reaction.Load.TopProtectAtSkill1 = 0
Playerbots.Natural.Reaction.Load.TopProtectAtSkill99 = 0.8
Playerbots.Natural.Reaction.Load.MaxEvents = 3
Playerbots.Natural.Reaction.Ease.Enable = 0
Playerbots.Natural.Reaction.Ease.CommonMsAtSkill1 = 0
Playerbots.Natural.Reaction.Ease.CommonMsAtSkill99 = 0
Playerbots.Natural.Reaction.Ease.RareMsAtSkill1 = 250
Playerbots.Natural.Reaction.Ease.RareMsAtSkill99 = 80
Playerbots.Natural.Reaction.Ease.FocusMsAtSkill1 = 350
Playerbots.Natural.Reaction.Ease.FocusMsAtSkill99 = 120
Playerbots.Natural.Reaction.Ease.NewTargetMsAtSkill1 = 450
Playerbots.Natural.Reaction.Ease.NewTargetMsAtSkill99 = 180
Playerbots.Natural.Reaction.Ease.FocusDexterity = 40
Playerbots.Natural.Reaction.Think.Enable = 0
Playerbots.Natural.Reaction.Think.ShortcutMsAtSkill1 = 40
Playerbots.Natural.Reaction.Think.ShortcutMsAtSkill99 = 20
Playerbots.Natural.Reaction.Think.DeepMsAtSkill1 = 400
Playerbots.Natural.Reaction.Think.DeepMsAtSkill99 = 150
Playerbots.Natural.Reaction.Think.DeepPercentAtSkill1 = 0
Playerbots.Natural.Reaction.Think.DeepPercentAtSkill99 = 100
Playerbots.Natural.Reaction.Think.PatienceWaitMsAt0 = 0
Playerbots.Natural.Reaction.Think.PatienceWaitMsAt100 = 1500
Playerbots.Natural.Reaction.Anticipate.Enable = 0
Playerbots.Natural.Reaction.Anticipate.ShareAtSkill1 = 0.1
Playerbots.Natural.Reaction.Anticipate.ShareAtSkill99 = 0.5
Playerbots.Natural.Reaction.Queue.Enable = 0
Playerbots.Natural.Reaction.Queue.MinMsAtSkill1 = 60
Playerbots.Natural.Reaction.Queue.MaxMsAtSkill1 = 250
Playerbots.Natural.Reaction.Queue.MinMsAtSkill99 = 10
Playerbots.Natural.Reaction.Queue.MaxMsAtSkill99 = 80
Playerbots.Natural.Reaction.Reeval.Enable = 0
Playerbots.Natural.Reaction.Reeval.ImportantCastMs = 1500
Playerbots.Natural.Reaction.Reeval.MinOwnRemainingMs = 300
Playerbots.Natural.Reaction.Reeval.BusySkip = 0
Playerbots.Natural.Reaction.Reeval.BusyMarginMs = 100
Playerbots.Natural.Reaction.Memory.Enable = 0
Playerbots.Natural.Reaction.Memory.MinCasts = 3
Playerbots.Natural.Reaction.Memory.EndToleranceMs = 150
Playerbots.Natural.Reaction.Movement.Enable = 0
# Positioning: regain los, break los and pillar step (G2e, G2f) as reactions, stamped by the first query; a reaction only
# like Movement (no notice counter, no D4 delay). Default: 0 (they go at once)
Playerbots.Natural.Reaction.Positioning.Enable = 0

# Natural cadence: bots in Contexts check their AI at least every CheckMs (20-1000) in combat in a started match
# (battleground and arena gates open; open-world PvP fights when World is listed) instead of upstream's combat
# interval (2.5 x Playerbots.ReactDelay in battlegrounds and arenas with Playerbots.FastReactInBG), and upstream's
# per-bot stagger of 0-200 ms (guid % 201) becomes guid % (StaggerMs + 1) there (0-200). Out of combat, and for every
# bot outside Contexts, the interval and the stagger stay. Where this and Playerbots.Natural.Reaction both run (both
# contexts), the skill's stretch of the check interval (Playerbots.Skill.React*) is off (factor 1) and the reaction
# model carries the skill; elsewhere the stretch stays as the cheap fallback. No check is woken for a reaction that
# comes due. While it runs, the cure and dispel triggers and the party dispel value look at least every CheckMs
# (else once a second). NearRealPlayerYards (0 = off) is reserved for open-world bots near a real player: the bots
# cache no proximity flag yet, so it has no effect. Contexts as in Playerbots.Natural.Reaction.Contexts. With
# Playerbots.PerfMonEnabled the rows NaturalTiming::Checks (scope) and NaturalTiming::Checks (combat) (counts in the
# blocks column), NaturalTiming::Time (combat) (the bot time in combat in scope, not a cost: checks per second per
# bot = Checks (combat) / its total in seconds), NaturalTiming::UpdateAIInternal (scope), NaturalReaction::HasReacted
# and NaturalReaction::EventStart show the cost; the NaturalTiming rows also while Enable is 0. On a running server
# .reload config then .playerbots rndbot reload change it.
# SkillStretch (G6d-a) 1 keeps the skill's stretch where the cadence and the reaction model both run: the cadence's
# CheckMs is then multiplied by the bot's factor (Playerbots.Skill.ReactFactorAtSkill1 .. AtSkill99, e.g. 3.0 .. 0.5:
# 300 ms at skill 1, 50 ms at skill 99 with CheckMs 100), as is the reaction engine's reset delay, on top of the
# reaction model; 0 leaves the factor 1 there.
# Default: 0 (off: upstream's interval and stagger, the stretch everywhere), CheckMs 100, StaggerMs 20,
# Contexts "Arena,Battleground", NearRealPlayerYards 0, SkillStretch 0
Playerbots.Natural.Cadence.Enable = 0
Playerbots.Natural.Cadence.CheckMs = 100
Playerbots.Natural.Cadence.StaggerMs = 20
Playerbots.Natural.Cadence.Contexts = "Arena,Battleground"
Playerbots.Natural.Cadence.NearRealPlayerYards = 0
Playerbots.Natural.Cadence.SkillStretch = 0

# Natural facing and turning (G2a): in Contexts (a tactic scope; PvP fights only unless OutsidePvpInSight) a bot that
# turns to its target at the four combat facing points (attack start, the facing action, a cast's start and a cast in
# progress) no longer snaps to it at once: a turn is a minimum-jerk flick (angle(t) = from + d * (10u^3 - 15u^4 +
# 6u^5), u = t / duration), its duration from the angle and the bot's Dexterity (MsFor180AtSkill1..99 for 180 degrees,
# at least MinMs, about 15 % spread), an aim error drawn once per turn (log-normal, ErrorDegAtSkill1..99 degrees,
# spread ErrorSigmaPct, less for a narrow turn), an optional correction sub-flick CorrectionDelayMinMs..MaxMs later
# (chance CorrectionPctAtSkill1..99, leaving CorrectionResidualPct of the error), and a low-skill bot sometimes turns
# at a constant KeyboardDegPerS (chance KeyboardPctAtSkill1..99). A cast needing facing waits while its target is
# outside the core's 180-degree arc (the bot tries again after CastRetryMs); swings wait for the core's own arc. The
# server orientation is written at every map update; a heartbeat packet follows only on a change of more than
# PacketMinDeg at least PacketMinMs after the last one, and the turn's end goes out as soon as that rate allows.
# Mode 1: heartbeat packets (default); Mode 2: one facing spline per leg of at least SplineMinDeg (smaller legs use the
# heartbeat rule). A moving bot keeps the snap (its path sets its facing). OutsidePvpInSight 1: also out of PvP and
# out of dungeons and raids, for a bot with a real player within InSightYards (the answer is kept InSightCacheMs).
# Scripted raid and dungeon facing is untouched. Needs the Natural tactic enabled for the bot
# (Playerbots.Tactics.Natural.Enable) like the other natural layers. .playerbots tactics selftest turn checks the
# curve; tactics show prints a "turn:" line; harness counters tactics.turnFlicks, turnWaitMs, faceFails. With
# Playerbots.PerfMonEnabled the rows NaturalTurn::Step (the pre-gate cost), NaturalTurn::Face, NaturalTurn::Packet
# (heartbeats sent by turns) and NaturalTurn::Snap (snaps at the four points while it is off for the bot) show the
# cost and the packet counts. Default: off (the instant snap).
# Playerbots.Natural.Facing.Enable = 0
# Playerbots.Natural.Facing.Contexts = "Arena,Battleground,World"
# Playerbots.Natural.Facing.OutsidePvpInSight = 0
# Playerbots.Natural.Facing.InSightYards = 60
# Playerbots.Natural.Facing.InSightCacheMs = 1000
# Playerbots.Natural.Facing.Mode = 1
# Playerbots.Natural.Facing.MsFor180AtSkill1 = 450
# Playerbots.Natural.Facing.MsFor180AtSkill99 = 90
# Playerbots.Natural.Facing.MinMs = 40
# Playerbots.Natural.Facing.ErrorDegAtSkill1 = 14
# Playerbots.Natural.Facing.ErrorDegAtSkill99 = 2
# Playerbots.Natural.Facing.ErrorSigmaPct = 40
# Playerbots.Natural.Facing.CorrectionPctAtSkill1 = 70
# Playerbots.Natural.Facing.CorrectionPctAtSkill99 = 35
# Playerbots.Natural.Facing.CorrectionDelayMinMs = 120
# Playerbots.Natural.Facing.CorrectionDelayMaxMs = 250
# Playerbots.Natural.Facing.CorrectionResidualPct = 25
# Playerbots.Natural.Facing.KeyboardPctAtSkill1 = 35
# Playerbots.Natural.Facing.KeyboardPctAtSkill99 = 0
# Playerbots.Natural.Facing.KeyboardDegPerS = 180
# Playerbots.Natural.Facing.PacketMinDeg = 8
# Playerbots.Natural.Facing.PacketMinMs = 80
# Playerbots.Natural.Facing.SplineMinDeg = 25
# Playerbots.Natural.Facing.CastRetryMs = 50
# (Ranges: Mode 1-2, percents 0-100, degrees 0-360, ms 0-60000, InSightYards 0-500, KeyboardDegPerS 0-60000.)

# Natural chasing and tracking (G2b): in Contexts (as above) a bot chasing a target sees it as it was Lag ms ago (a
# ring of the target's past positions, one sample per SampleMs, RingSamples of them), the lag log-normal around
# LagMsAtSkill1..99 (spread LagSigmaPct) and predicts where it is now by skill: below VelocityFromSkill it runs to
# where it last saw the target; from there it extrapolates the velocity with a gain of GainPctAtSkill1..99 per cent of
# the true velocity (spread GainSigmaPct); from TurnRateFromSkill it also reads the turn rate and from PatternFromSkill
# turns and patterns over HistoryMsAtSkill1..99 ms of history. A heading change of JukeDeg degrees between two samples
# is a juke no level predicts. The predicted point is at most MaxLeadYards from the lagged one; a target that moved
# less than MinMoveYards in the half second before what the chaser saw is standing; a chaser out of its reach that for
# StuckMs neither closed 1 yd on the target nor ran 2 yd itself aims at the true position for 1.5 s. The chaser runs
# to the tracked point but stops within reach of the target's true position. Combat chases only (the heal and
# resurrect reach keep the exact point). SkipLeadRule 1: the old 3-yard lead rule of ReachCombatTo is skipped.
# The ring takes a sample at most every SampleMs (wider when RingSamples must reach back over a long lag and history);
# the chaser sees the newest sample at least its lag old. A moving chaser faces its path, so it faces the same point.
# OutsidePvpInSight as in Facing. With Playerbots.PerfMonEnabled the row NaturalMove::Track shows the cost; tactics
# counters trackChases and trackLagMs (the age of what it saw, summed); GM: .playerbots tactics selftest track.
# Default: off (the exact target position).
# Playerbots.Natural.Track.Enable = 0
# Playerbots.Natural.Track.Contexts = "Arena,Battleground,World"
# Playerbots.Natural.Track.OutsidePvpInSight = 0
# Playerbots.Natural.Track.InSightYards = 60
# Playerbots.Natural.Track.InSightCacheMs = 1000
# Playerbots.Natural.Track.LagMsAtSkill1 = 500
# Playerbots.Natural.Track.LagMsAtSkill99 = 110
# Playerbots.Natural.Track.LagSigmaPct = 25
# Playerbots.Natural.Track.VelocityFromSkill = 35
# Playerbots.Natural.Track.PatternFromSkill = 65
# Playerbots.Natural.Track.TurnRateFromSkill = 50
# Playerbots.Natural.Track.GainPctAtSkill1 = 0
# Playerbots.Natural.Track.GainPctAtSkill99 = 90
# Playerbots.Natural.Track.GainSigmaPct = 20
# Playerbots.Natural.Track.HistoryMsAtSkill1 = 0
# Playerbots.Natural.Track.HistoryMsAtSkill99 = 1500
# Playerbots.Natural.Track.RingSamples = 16
# Playerbots.Natural.Track.SampleMs = 50
# Playerbots.Natural.Track.MaxLeadYards = 6
# Playerbots.Natural.Track.SkipLeadRule = 1
# Playerbots.Natural.Track.MinMoveYards = 1
# Playerbots.Natural.Track.JukeDeg = 60
# Playerbots.Natural.Track.StuckMs = 3000
# Playerbots.Natural.Track.RefreshMs = 250
# (Ranges: skills 0-100, RingSamples 4-32, percents 0-100, degrees 0-360, ms 0-60000, yards 0-500, SkipLeadRule 0-1.)
# RefreshMs (13e-decide): while the bot waits for its last tracked chase move (MoveTo's destination hold), a new
# tracked point replaces it once that move is RefreshMs old and the point moved more than 1 yd; 0 keeps the hold.

# Natural paths (G2c): moving bots do not run in perfect straight lines. With Enable 1 the interior waypoints of a
# bot's mmap path are moved sideways by a draw of OffsetYardsAtSkill1..99 yards (larger at low skill, spread
# OffsetSigmaPct per cent), each point validated by the collision check and a ground probe and dropped on failure; a
# path shorter than MinLegYards stays straight. Needs the Natural tactic here (Playerbots.Tactics.Natural.Enable) and
# the bot in Contexts (Arena,Battleground,World); OutsidePvpInSight, InSightYards and InSightCacheMs as in Facing.
# Offsets.Enable 0 turns the offsets off while keeping the other parts. Each part below has its own flag, default 0:
#   Curves.Enable  catmullrom curves on open ground
#   Strafe.Enable  strafe splines (SetFacing) for ranged bots from Strafe.FromSkill, a leg of LegMinYards..LegMaxYards,
#                  every EveryMsAtSkill50..99 ms, never while casting
#   Hops.Enable    cosmetic hops on flat validated ground while running or kiting from Hops.FromSkill, every
#                  EveryMsAtSkill60..99 ms, a leg of at most MaxLegYards, never within EdgeYards of an edge
#   Walk.Enable    walking on short legs (at most Walk.MaxLegYards) out of combat
# With Playerbots.PerfMonEnabled the rows NaturalPath::* show the cost; tactics counters pathOffsets, pathStrafes,
# pathHops and pathHopsRefused; GM: .playerbots tactics selftest path. Default: off (straight paths).
# Playerbots.Natural.Path.Enable = 0
# Playerbots.Natural.Path.Contexts = "Arena,Battleground,World"
# Playerbots.Natural.Path.OutsidePvpInSight = 0
# Playerbots.Natural.Path.InSightYards = 60
# Playerbots.Natural.Path.InSightCacheMs = 1000
# Playerbots.Natural.Path.Offsets.Enable = 1
# Playerbots.Natural.Path.OffsetYardsAtSkill1 = 1.5
# Playerbots.Natural.Path.OffsetYardsAtSkill99 = 0.4
# Playerbots.Natural.Path.OffsetSigmaPct = 30
# Playerbots.Natural.Path.MinLegYards = 12
# Playerbots.Natural.Path.Curves.Enable = 0
# Playerbots.Natural.Path.Strafe.Enable = 0
# Playerbots.Natural.Path.Strafe.FromSkill = 50
# Playerbots.Natural.Path.Strafe.LegMinYards = 2
# Playerbots.Natural.Path.Strafe.LegMaxYards = 4
# Playerbots.Natural.Path.Strafe.EveryMsAtSkill50 = 4000
# Playerbots.Natural.Path.Strafe.EveryMsAtSkill99 = 1500
# Playerbots.Natural.Path.Hops.Enable = 0
# Playerbots.Natural.Path.Hops.FromSkill = 60
# Playerbots.Natural.Path.Hops.EveryMsAtSkill60 = 12000
# Playerbots.Natural.Path.Hops.EveryMsAtSkill99 = 5000
# Playerbots.Natural.Path.Hops.EdgeYards = 8
# Playerbots.Natural.Path.Hops.MaxLegYards = 6
# Playerbots.Natural.Path.Walk.Enable = 0
# Playerbots.Natural.Path.Walk.MaxLegYards = 6
# (Ranges: skills 0-100, percents 0-100, ms 0-60000, yards 0-500, OffsetYards 0-20.)

# Honest world travel of persistent bots (Playerbots.Population.Persistent = 1; arena instances with
# Playerbots.ArenaOnly.Enable keep their own cycle). These bots are never resurrected in place, never take the stuck
# teleport (a bot that makes no progress toward its destination records a Stuck event in the world log, gives
# the destination up for StuckAvoidSeconds and goes IDLE) and are never randomized, refreshed or teleported while their
# RPG is busy (not IDLE) or a real player is their master. A dead bot runs back to its corpse; after CorpseRunFailures
# runs that ended in another death it walks to the spirit healer. Every teleport that remains (level-up, hub, city,
# graveyard) is skipped while a real player is within SightYards of the bot or of the destination, and tried again
# later; other setups keep the old 150 yd check around the bot. (Ranges: SightYards 0-2000, 0 = no sight check;
# CorpseRunFailures 0-100; StuckAvoidSeconds 0-86400.) Defaults: 300, 2, 600
Playerbots.WorldTravel.SightYards = 300
Playerbots.WorldTravel.CorpseRunFailures = 2
Playerbots.WorldTravel.StuckAvoidSeconds = 600

# Route planning over the shipped travel graph, costed in seconds (walk, portal, flight with its fare, ship or
# zeppelin, hearthstone). RouteThreads workers (read at startup) search off the map threads; an edge on which a bot
# recorded a Stuck event costs StuckPenalty times more for StuckAvoidSeconds (after 3 such events it is skipped); a ship
# or zeppelin costs TransportWaitSeconds of waiting (half its period) plus the crossing. (Ranges: RouteThreads 1-8;
# StuckPenalty 1-100; TransportWaitSeconds 0-3600.) Defaults: 1, 5, 120
Playerbots.WorldTravel.RouteThreads = 1
Playerbots.WorldTravel.StuckPenalty = 5
Playerbots.WorldTravel.TransportWaitSeconds = 120

# Items, slots and bags of persistent bots. Every item has a worth in copper: what a vendor pays for what the bot
# would sell, the buy price of what it uses (upgrades, consumables, reagents, ammo); quest items, kept items, upgrades
# and the hearthstone are never destroyed. A free slot is worth the inventory-trip minutes it saves per hour times the
# bot's earning rate, plus a share of what the bot destroys or leaves behind for lack of space; with F free slots
# after an emptying trip the bot makes about LootPerHour / F trips of TripMinutes each. Until a bot has measured its
# own loot rate (one-hour windows, in memory) it uses the defaults of its level band; each list holds one value per
# band: levels 1-19, 20-39, 40-59, 60-69, 70-80. A bag is worth the slots it adds over the bag it replaces for
# HorizonHours. The bot equips looted or quest-reward bags that add slots and buys a vendor bag when its price is at
# most its worth and at most BudgetPercent of the money left after a reserve (repairs, training, travel, ammo,
# guild) scaled by ThriftPercent; it buys at most one bag per vendor visit and records an Inventory event bag_bought.
# A full bot destroys its lowest-worth item for better loot: in an instance when the loot is worth more, in the
# world when it is worth MarginPercent more (Inventory event destroyed_for_space). New persistent bots get no free
# bags. Defaults are estimates: the loot rate in slots per hour, minutes per trip, copper per minute and horizon
# hours were chosen so that a bot buys the small vendor bags while levelling and the 2 g 10-slot bag only when it
# is short of room. (Ranges: list values 0-1000000, ThriftPercent 0-1000, BudgetPercent 0-100, MarginPercent
# 0-1000.)
Playerbots.WorldTravel.Slots.LootPerHour = 15,20,25,25,30
Playerbots.WorldTravel.Slots.TripMinutes = 10,10,8,8,6
Playerbots.WorldTravel.Slots.EarnCopperPerMinute = 30,100,250,500,1000
Playerbots.WorldTravel.Bags.HorizonHours = 20,30,40,40,100
Playerbots.WorldTravel.Bags.ThriftPercent = 100
Playerbots.WorldTravel.Bags.BudgetPercent = 50
Playerbots.WorldTravel.Destroy.MarginPercent = 50

# Inventory errands of persistent bots. A bot whose general bags are at least 80% full checks, at most every 5
# minutes, whether a trip to the nearest friendly vendor on its map (at most a 10-minute walk) is worth it: the slots
# that selling frees are worth (as above) for NextStopMinutes, the minutes until it would pass a vendor anyway, and
# the trip costs its usual trip minutes (measured from its own errands, TripMinutes until then) plus the walk, at
# EarnCopperPerMinute. A worthwhile trip walks there (no teleport), sells, buys (a bag by worth) and repairs (paid),
# and records an Inventory event errand_run; a trip given up after 20 minutes records errand_abort. The same rule
# tells a full bot looting in the world not to destroy items when a trip is worth it. (Range: 0-1440; 0 = no trip
# just for selling.) Default: 30
Playerbots.WorldTravel.Errands.NextStopMinutes = 30

# Every bot has a personality (30 traits and one to three interests, rolled once per bot and stored in
# playerbots_bot_traits); the GM command `.playerbots traits <bot>` shows it. AllowEdit lets the same command set or
# reroll a bot's traits (`set <trait> <value>`, `reroll`): a switch for test servers. (Range: 0-1.) Default: 0
Playerbots.WorldTravel.Traits.AllowEdit = 0

# The planner of persistent bots. Threads workers (read at startup) run planning jobs off the map threads on a
# snapshot of the bot, built on its map thread when its situation changes (level, zone, life, group), a goal ends, or
# SnapshotMinutes have passed. A result is used only while the bot is alive, its situation unchanged, the result at
# most ResultStaleSeconds old and the bot within RecheckYards of where the snapshot was taken; otherwise, and until
# the planner has an answer, the bot picks its next activity as before. NoopSeconds > 0 runs a no-op job at most that
# often per bot: a test switch that proves the machinery and changes nothing. Crowding.RefreshSeconds: how often the
# live crowding data the planner reads is rebuilt. `.playerbots planner status` shows the counters. (Ranges: Threads
# 1-8; SnapshotMinutes 1-60; ResultStaleSeconds 5-600; RecheckYards 10-2000; NoopSeconds 0-3600, 0 = off;
# Crowding.RefreshSeconds 1-300.) Defaults: 2, 5, 30, 100, 0, 5
# Goals: persistent bots outside the A/B group (character guid % 10 = 0 keeps the weighted pick) take their next
# activity from the planner's ranked goals; 0 = every bot picks as before (a test switch). Default: 1
Playerbots.WorldTravel.Planner.Threads = 2
Playerbots.WorldTravel.Planner.SnapshotMinutes = 5
Playerbots.WorldTravel.Planner.ResultStaleSeconds = 30
Playerbots.WorldTravel.Planner.RecheckYards = 100
Playerbots.WorldTravel.Planner.NoopSeconds = 0
Playerbots.WorldTravel.Planner.Goals = 1
Playerbots.WorldTravel.Crowding.RefreshSeconds = 5

# Honest upkeep of persistent bots: free handouts (food, ammo, repairs, trainer spells, riding, gold, attunements,
# keys, reputation, glyphs, talent resets and the like) end
# kind by kind for them, and they buy and train what they need. HandoutShare keeps this percent of persistent bots on
# every handout, chosen by guid so that the world log names the same bots as a cohort: a bot is in the share when
# (((guid * 2654435761) & 0xFFFFFFFF) >> 16) % 100 < HandoutShare. A test switch for comparisons and forced checks
# (0-100). Default: 0
Playerbots.Upkeep.HandoutShare = 0

# World PvP of persistent bots in the open world (battlegrounds, arenas and dungeons keep their own rules). Every
# open-world map keeps a fight book: its active fights (a cluster of PvP combat with two sides, its starter and
# reason, participants, deaths and end), shown by `.playerbots fight list`, and its ended fights for CalmMinutes.
# Each bot remembers the enemy players it saw; one not seen for MeetingMemorySeconds is a new meeting (a fight_start
# row in the world log); RecentEnemies is how many it remembers (the oldest is forgotten). A fight takes in combat
# within its radius (FightRadiusYards at the start, following the participants up to FightRadiusMaxYards), holds at
# most MaxParticipants, a map at most MaxActiveFights; one still in PvP combat after MaxFightMinutes ends as
# stalemate_cap. A fight ends as combat_over once none of its participants has been in PvP combat for
# EndGraceSeconds (combat within the grace continues the same fight; its length runs to the last PvP combat; of the
# rules' ends below only wiped comes before it). The other world PvP numbers are declared in
# src/Ai/World/Pvp/WorldPvpConfig.h and come here with the steps that read them.
# (Ranges: MeetingMemorySeconds 0-86400; RecentEnemies 1-32; MaxActiveFights 1-1000; MaxParticipants 2-1000;
# FightRadiusYards and FightRadiusMaxYards 1-2000; MaxFightMinutes 1-1440; EndGraceSeconds 0-600; CalmMinutes
# 0-1440.) Defaults: 600, 16, 32, 40, 40, 150, 30, 10, 15
Playerbots.WorldPvp.MeetingMemorySeconds = 600
Playerbots.WorldPvp.RecentEnemies = 16
Playerbots.WorldPvp.Book.MaxActiveFights = 32
Playerbots.WorldPvp.Book.MaxParticipants = 40
Playerbots.WorldPvp.Book.FightRadiusYards = 40
Playerbots.WorldPvp.Book.FightRadiusMaxYards = 150
Playerbots.WorldPvp.Book.MaxFightMinutes = 30
Playerbots.WorldPvp.Book.EndGraceSeconds = 10
Playerbots.WorldPvp.CalmMinutes = 15

# Starting a fight (persistent bots in the open world; battlegrounds, arenas, dungeons, other bots and PvpTest's
# fighters keep today's attack on sight). Such a bot attacks another player only in a fight it is in or when it
# starts one: an enemy player within ScanYards that it has not seen for MeetingMemorySeconds is a meeting, and a
# meeting is a chance when the hard rules pass (the bot is not in a group with a real player or a real master, leads
# its bot group, is in no fight, is not within GraveyardYards of a graveyard; its last fight ended MinGapMinutes ago;
# the enemy is PvP flagged, attackable and seen, neither grey nor red to the bot, not within GraveyardYards of a
# graveyard, and was not rolled for in the last RollAgainSeconds). A bot that cannot start now skips the scan and
# meets nobody. The chance's probability is 1 - exp(-rate x the play hours since the bot's last chance), at most
# ChanceCap; the rate comes from the bot's aggression (-1..+1): none at or below AggressionOffBelow, once per
# HoursAtZero hours at 0, once per HoursAtOne at +1 (4^a in between). "Once per 4 h" and "four times" describe this
# budget curve: real starts are rarer, as a chance starts at most one fight, the cap trims long quiet times and the
# soft factors lower it: the colour (Colour.Green, Colour.Yellow; orange from Colour.OrangeDaring for the most daring
# bot to Colour.OrangeCareful for the most careful one), the bot's courtesy (a courteous bot leaves an enemy alone
# that fights a monster or is below half health) and the odds (OddsCaution below). (Ranges: ScanYards 1-200;
# RollAgainSeconds 0-86400; MinGapMinutes 0-1440; GraveyardYards 0-2000; AggressionOffBelow -1-1; HoursAtZero and
# HoursAtOne 0.01-1000; ChanceCap and the colour factors 0-1.) Defaults: 40, 600, 30, 80, -0.5, 3.4, 0.85, 0.333,
# 0.5, 1, 1, 0
Playerbots.WorldPvp.ScanYards = 40
Playerbots.WorldPvp.RollAgainSeconds = 600
Playerbots.WorldPvp.MinGapMinutes = 30
Playerbots.WorldPvp.GraveyardYards = 80
Playerbots.WorldPvp.AggressionOffBelow = -0.5
Playerbots.WorldPvp.HoursAtZero = 3.4
Playerbots.WorldPvp.HoursAtOne = 0.85
Playerbots.WorldPvp.ChanceCap = 0.333
Playerbots.WorldPvp.Colour.Green = 0.5
Playerbots.WorldPvp.Colour.Yellow = 1
Playerbots.WorldPvp.Colour.OrangeDaring = 1
Playerbots.WorldPvp.Colour.OrangeCareful = 0

# Joining a fight (persistent bots in the open world). A bot within JoinYards of a fight's nearest participant that
# is not in it decides once per fight whether to join (the fight book asks every 3 s; a bot that is dead, in another
# fight or cannot see the fight is asked again later). It always joins when a participant attacks it, its group is
# in the fight or its real master is; it may pick any enemy then. By chance (the Join weights below) only a bot that
# could start fights itself joins (not with a real player, not a bot group's member that is not its leader, outside
# Playerbots.PvpProhibitedZoneIds), on an enemy that is not red to it (grey ones too); when every enemy is red it
# stays out. Joining spends no budget; the bot's MinGapMinutes counts from the end of the fight. (Range: 1-200.)
# Default: 60
Playerbots.WorldPvp.JoinYards = 60

# The shape weights of the fight rules (src/Ai/World/Pvp/FightRules.h), read now so lab nights can tune them (the
# start uses OddsCaution, joining the Join weights, the retreat the Retreat weights). OddsCaution: a bot needs its
# side's share of the strength it sees to be 0.5 + OddsCaution x its caution (-1..+1) for its full start chance.
# A bystander joins a fight with Join.Base x (1 + Join.Aggression x aggression) x (1 + Join.Helpfulness x
# helpfulness, when its side is losing or a player of its faction is the target) x (1 - Join.Goal x the value of
# its current goal, 0..1); bad odds lower it by caution. A participant retreats (Ending a fight, below) when its
# health is below Retreat.HealthPercent x (1 + Retreat.CautionHealth x caution) while its side's share of the
# strength it sees is below Retreat.Odds + Retreat.CautionOdds x caution, never above 0.5 (never while its side is
# ahead). A value out of range keeps the default. (Ranges: OddsCaution 0-0.5; the Join weights 0-1;
# Retreat.CautionHealth 0-1; Retreat.CautionOdds 0-0.5.) Defaults: 0.12, 0.4, 0.75, 0.75, 0.75, 0.5, 0.1
Playerbots.WorldPvp.OddsCaution = 0.12
Playerbots.WorldPvp.Join.Base = 0.4
Playerbots.WorldPvp.Join.Aggression = 0.75
Playerbots.WorldPvp.Join.Helpfulness = 0.75
Playerbots.WorldPvp.Join.Goal = 0.75
Playerbots.WorldPvp.Retreat.CautionHealth = 0.5
Playerbots.WorldPvp.Retreat.CautionOdds = 0.1

# Ending a fight (persistent bots in the open world). A participant that starts fights by the rules retreats when
# its health is low and its side is losing by what it sees (the retreat lines above, Retreat.HealthPercent and
# Retreat.Odds): it drops its target, moves away from the enemies for 15 s (it waits while it cannot move and gives
# the retreat up only when every direction is blocked) and does not rejoin that fight (it still defends itself). A
# winner chasing a retreated enemy stops ChaseSeconds after the enemy's retreat or ChaseYards beyond the fight's
# radius, both x (1 + 0.5 x aggression - 0.5 x courtesy), also when the enemy hits back; it calls its pet off too and
# leaves the enemy alone for 30 s unless it attacks; a bot that comes to the fight later does not take it up. A fight
# ends wiped as soon as one side has nobody on the map, alive and not retreated (a retreated participant still in
# PvP combat counts: the chase is part of the fight); as timeout after NoHitSeconds without a hit between the sides
# (its length to that hit); as stalemate after StalemateSeconds; then the bots still in PvP combat disengage (they
# step away for 15 s). No bot starts a fight within CalmYards of where a fight ended in the last CalmMinutes (from
# its own place; joining and self-defence still happen there). (Ranges: Retreat.HealthPercent 1-100; Retreat.Odds
# 0-0.5; ChaseSeconds 0-600; ChaseYards 0-2000; NoHitSeconds 1-600; StalemateSeconds 1-86400; CalmYards 0-2000.)
# Defaults: 30, 0.5, 15, 40, 30, 300, 200
Playerbots.WorldPvp.Retreat.HealthPercent = 30
Playerbots.WorldPvp.Retreat.Odds = 0.5
Playerbots.WorldPvp.ChaseSeconds = 15
Playerbots.WorldPvp.ChaseYards = 40
Playerbots.WorldPvp.NoHitSeconds = 30
Playerbots.WorldPvp.StalemateSeconds = 300
Playerbots.WorldPvp.CalmYards = 200

# The flight from enemy players (FleeAttackersAction). A bot that flees runs from the enemy players in PvP combat with
# it. Its flight ends as escaped when it is out of PvP combat or Flee.EscapeYards from every one of them; as cornered
# when its nearest attacker got no farther from it for Flee.CorneredSeconds (the best distance so far, in steps of
# 1 yd: a bot that cannot shake a pursuer turns and fights; the time it cannot move, rooted or stunned, does not
# count, and the measure starts again when it can move); or by its bound after Flee.BoundSeconds. After cornered or
# the bound it stands and fights and does not flee again in that PvP combat. (Ranges: EscapeYards 1-2000;
# CorneredSeconds 1-600; BoundSeconds 1-600.) Defaults: 40, 6, 30
Playerbots.Flee.EscapeYards = 40
Playerbots.Flee.CorneredSeconds = 6
Playerbots.Flee.BoundSeconds = 30

# No camping (persistent bots in the open world). No bot starts a fight on a player resurrected in the last
# ResurrectedSeconds (any player, by any resurrection; nor near a graveyard, GraveyardYards above). The ghost of a bot
# whose corpse has an enemy player (alive, of the other team, flagged or not) within GhostEnemyYards waits as a ghost
# and checks again every GhostRecheckSeconds; once the enemy has gone it runs to its corpse, and
# GhostSpiritHealerSeconds after its release (counted from the release, never reset by a recheck) it takes the spirit
# healer instead. ResurrectedSeconds is read when a map's fight book is made (at the map's creation), so a
# .reload config changes it only for maps made afterwards. (Ranges: ResurrectedSeconds 0-86400; GhostEnemyYards
# 0-2000; GhostRecheckSeconds 1-600; GhostSpiritHealerSeconds 0-86400.)
# Defaults: 300, 40, 15, 300
Playerbots.WorldPvp.ResurrectedSeconds = 300
Playerbots.WorldPvp.GhostEnemyYards = 40
Playerbots.WorldPvp.GhostRecheckSeconds = 15
Playerbots.WorldPvp.GhostSpiritHealerSeconds = 300

# Enthusiasm (persistent bots in the open world; the rules exist, the fight decisions start reading them in later
# steps). Every bot has one value on a scale of 0 to Max points; it is not saved and starts at a random level at
# login. While the bot is not engaged (in PvP combat or holding an enemy player as its target) it rises by
# RecoveryPerHour points per hour of play; while engaged it falls by DepletionPerMinute points per minute times the
# local balance's factor. A PvP death costs DeathEdit points at confidence 0, DeathEditConfident for the most
# confident bot and DeathEditUnconfident for the least (linear between); a kill of an enemy player gives KillEdit; a
# group member's PvP death within GroupDeathYards yd costs GroupDeathShare (a fraction) of the bot's own death edit.
# The numbers are starting values that lab nights tune. (Ranges: Max 1-1000; RecoveryPerHour 0-1000;
# DepletionPerMinute 0.1-1000; the edits 0-1000; GroupDeathYards 0-2000; GroupDeathShare 0-1.)
# Defaults: 100, 15, 20, 50, 25, 75, 10, 60, 0.3
Playerbots.WorldPvp.Enthusiasm.Max = 100
Playerbots.WorldPvp.Enthusiasm.RecoveryPerHour = 15
Playerbots.WorldPvp.Enthusiasm.DepletionPerMinute = 20
Playerbots.WorldPvp.Enthusiasm.DeathEdit = 50
Playerbots.WorldPvp.Enthusiasm.DeathEditConfident = 25
Playerbots.WorldPvp.Enthusiasm.DeathEditUnconfident = 75
Playerbots.WorldPvp.Enthusiasm.KillEdit = 10
Playerbots.WorldPvp.Enthusiasm.GroupDeathYards = 60
Playerbots.WorldPvp.Enthusiasm.GroupDeathShare = 0.3

# Enthusiasm's thresholds, in points. A bot attacks an enemy player when its enthusiasm is above its join threshold
# for that target: JoinBase - JoinAggression x aggression (-1..+1; at the scale's top the bot never starts a fight);
# when the target already attacks a player of the bot's faction or a member of its group, the Aggression term counts
# at AggressionJoinFactor of its size (a factor, 0-1: the most peaceable bot still joins); + JoinGreen for a green
# target; - JoinFactionAttacked when the target attacks a player of the bot's faction, and up to
# JoinFactionHelpfulness more for the most helpful bot (none for the least); - JoinGroupAttacked
# when it attacks a member of the bot's group; + JoinGraveyard within GraveyardYards of a graveyard or spirit healer;
# from - JoinBalanceMax when the bot's side clearly leads to + JoinBalanceMax when it is clearly behind. An engaged
# bot leaves the fight when its enthusiasm falls below its flee threshold: FleeBase + FleeCaution x caution (below 0
# it never flees), FleeGroupHold lower while a living member of its group within GroupHoldYards yd is engaged.
# (Ranges: all points 0-1000; AggressionJoinFactor 0-1; GroupHoldYards 0-2000.) Defaults: 60, 40, 0.25, 20, 30, 15,
# 50, 40, 30, 15, 20, 15, 40
Playerbots.WorldPvp.Enthusiasm.JoinBase = 60
Playerbots.WorldPvp.Enthusiasm.JoinAggression = 40
Playerbots.WorldPvp.Enthusiasm.AggressionJoinFactor = 0.25
Playerbots.WorldPvp.Enthusiasm.JoinGreen = 20
Playerbots.WorldPvp.Enthusiasm.JoinFactionAttacked = 30
Playerbots.WorldPvp.Enthusiasm.JoinFactionHelpfulness = 15
Playerbots.WorldPvp.Enthusiasm.JoinGroupAttacked = 50
Playerbots.WorldPvp.Enthusiasm.JoinGraveyard = 40
Playerbots.WorldPvp.Enthusiasm.JoinBalanceMax = 30
Playerbots.WorldPvp.Enthusiasm.FleeBase = 15
Playerbots.WorldPvp.Enthusiasm.FleeCaution = 20
Playerbots.WorldPvp.Enthusiasm.FleeGroupHold = 15
Playerbots.WorldPvp.Enthusiasm.GroupHoldYards = 40

# Enthusiasm's local balance: the living players of each faction within BalanceYards yd of the bot, the bot
# included, each weighted by its level colour to the bot (Weight.*) times its health share; the balance is the bot's
# side's share of the total, 0.5 when even. The bot's side clearly leads at a share of BalanceLead or more and is
# clearly behind at BalanceBehind or less; the depletion factor goes linearly from DepletionFactorLead there through 1
# at even to DepletionFactorBehind, and the join threshold's balance term likewise from - JoinBalanceMax through 0 to
# + JoinBalanceMax. (Ranges: BalanceYards 1-2000; Weight.* 0-100; DepletionFactorLead 0.01-1; DepletionFactorBehind
# 1-100; BalanceLead 0.51-1; BalanceBehind 0-0.49.) Defaults: 40, 0.25, 0.5, 1, 2, 4, 0.5, 3, 0.75, 0.25
Playerbots.WorldPvp.Enthusiasm.BalanceYards = 40
Playerbots.WorldPvp.Enthusiasm.Weight.Grey = 0.25
Playerbots.WorldPvp.Enthusiasm.Weight.Green = 0.5
Playerbots.WorldPvp.Enthusiasm.Weight.Yellow = 1
Playerbots.WorldPvp.Enthusiasm.Weight.Orange = 2
Playerbots.WorldPvp.Enthusiasm.Weight.Red = 4
Playerbots.WorldPvp.Enthusiasm.DepletionFactorLead = 0.5
Playerbots.WorldPvp.Enthusiasm.DepletionFactorBehind = 3
Playerbots.WorldPvp.Enthusiasm.BalanceLead = 0.75
Playerbots.WorldPvp.Enthusiasm.BalanceBehind = 0.25

# Mail and bank visits of persistent bots. A bot knows that mail waits and what it expects from it, not what is
# inside; an unread mail whose content it does not know counts Mail.DefaultWorthCopper. A bank item counts as kept for
# later while the level it is due at is at most Bank.KeepLevelHorizon levels above the bot's. A visit (the walk
# included) is given up after Mail.VisitDeadlineSeconds or Bank.VisitDeadlineSeconds; one step of it (a take from a
# mail, a deposit) waits at most VisitStepSeconds for the server's answer; one mailbox visit opens at most
# Mail.PerVisit mails. (Ranges: DefaultWorthCopper 0-10000; KeepLevelHorizon 0-20; VisitDeadlineSeconds 60-3600;
# VisitStepSeconds 1-60; PerVisit 1-100.) Defaults: 100, 5, 900, 900, 10, 50
Playerbots.BankMail.Mail.DefaultWorthCopper = 100
Playerbots.BankMail.Bank.KeepLevelHorizon = 5
Playerbots.BankMail.Mail.VisitDeadlineSeconds = 900
Playerbots.BankMail.Bank.VisitDeadlineSeconds = 900
Playerbots.BankMail.VisitStepSeconds = 10
Playerbots.BankMail.Mail.PerVisit = 50

# Seconds a depart may wait (members queued, in a battleground or not yet logged out) before it is cancelled: the
# members log in again and the move ends as failed (5-86400). Default: 600
Playerbots.Ladder.DepartTimeoutSeconds = 600

# Minutes a real player's direct contact with a random bot (whisper, party chat, trade, duel, a group the player
# invited it to) pins the bot's arena team (0-1440; 0 = no contact pins): depart refuses the team and a depart in
# progress is cancelled. The contacts come from the acquaintance event hooks, so they need
# Playerbots.Acquaintance.Enable = 1. A team is also pinned while a member is in a group, battleground or arena with a
# real player, or duels or trades with one (whatever this option says). Ignored while the moves are off.
# Default: 15
Playerbots.Ladder.ContactMinutes = 15

# Main role (Playerbots.Ladder.Role = 1): the number of 2v2 teams in the ladder pool (0-5000). A pool team is two
# random bots at the maximum level that are in no other arena team; the teams away on an arena server count. While
# the pool is short, main pairs free bots at the maximum level of one faction into new 2v2 teams every 30 s (at most
# 10 per check; a pair of offline bots is founded by an online bot below the maximum level, which leaves at once), and
# the random bot arena team assignment leaves such bots to the pool. Pool teams stay out of the random bot team joins
# and the formation. An automatic Playerbots.RandomBotAccountCount counts 2 bots per pool team on top of
# MaxRandomBots, so main still fills its online cap while the pool is away. Ignored with any other role.
# Commands: .playerbots ladder pool status|build|selftest
# Default: 0 (no pool)
Playerbots.Ladder.PoolTeams = 0

# Main: answers each 2v2 arena queue of a real player's group (rated, and skirmish with
# Playerbots.Ladder.Matchmaker.Skirmish) with one resident pool team (Playerbots.Ladder.PoolTeams), queued a few
# seconds later, so the core pairs the two: set the worldserver's Arena.MaxRatingDifference = 0 and keep bot rated
# arena auto-join off (Playerbots.Ladder.Role = 1 does that). The team is drawn at random around the group's MMR,
# weighted by 1 / (1 + (distance / MmrWidth)^2), inside a window of Window + WindowGrowth per second of the
# player's wait (an empty window doubles until it holds a team). Never drawn: one of the last RecentOpponents teams
# a player of the group faced (when only those are free, all but the last one), a pinned team
# (Playerbots.Ladder.ContactMinutes) and a team with a member offline, in a battleground or its queue, a dungeon or
# raid, the dungeon finder, another level bracket, or moving between servers. A drawn team that has not formed its
# group, or not been paired, within TimeoutSeconds leaves the queue and another is drawn, up to MaxPicks per queue.
# When the player leaves the queue the team leaves it too; its group is dissolved then and after the match. A group
# with fewer players than the arena type is not answered. The recent opponents are kept in memory only. Never on
# an arena server (Role = 2). Commands: .playerbots ladder matchmaker status|candidates [mmr]|selftest
# Default: 0 (off)
Playerbots.Ladder.Matchmaker.Enable = 0

# Seconds from the player's queue to the pick: a random value in this range (0-600)
# Default: 3, 8
Playerbots.Ladder.Matchmaker.DelayMinSeconds = 3
Playerbots.Ladder.Matchmaker.DelayMaxSeconds = 8

# MMR distance at which a team is half as likely as a team at the group's MMR (1-5000)
# Default: 150
Playerbots.Ladder.Matchmaker.MmrWidth = 150

# MMR window around the group at its queue (1-5000) and its growth per second of wait (0-1000)
# Default: 200, 5
Playerbots.Ladder.Matchmaker.Window = 200
Playerbots.Ladder.Matchmaker.WindowGrowth = 5

# Number of teams a player faced last that are not drawn again (0-20)
# Default: 3
Playerbots.Ladder.Matchmaker.RecentOpponents = 3

# Seconds a drawn team has to form its group, and then to be paired, before it leaves the queue (5-3600)
# Default: 60
Playerbots.Ladder.Matchmaker.TimeoutSeconds = 60

# Teams drawn at most for one queue of the player (1-100)
# Default: 3
Playerbots.Ladder.Matchmaker.MaxPicks = 3

# Answer skirmish (unrated) queues too, drawn without the MMR weight
# Default: 1
Playerbots.Ladder.Matchmaker.Skirmish = 1

# Draw only pool teams (Playerbots.Ladder.PoolTeams, the ladder residents in memory here). 0: every 2v2 team of
# random bots in memory, also the formation rosters of up to 4 (the captain and the next free members play; a
# member in a battleground or its queue still makes the team busy)
# Default: 1
Playerbots.Ladder.Matchmaker.PoolOnly = 1

# PvP gear for ladder bots (a random bot at the maximum level in an arena team; real players and their bots are never
# touched). When 1, the server builds a catalogue at startup from the PvP vendors (npc_vendor rows whose ExtendedCost
# asks for honor and/or arena points; token costs and items that need a 3v3 or 5v5 rating are left out), grouped into
# the tiers of Playerbots.PvpGear.TierOrder, and keeps for every ladder bot a stored PvP loadout: one item entry per
# equipment slot, chosen for the bot's class and spec, in the playerbots table playerbots_pvp_loadout. A missing
# loadout is created at the base tier at the bot's login. Playerbots.PvpGear.Buy.Enable lets the bots buy upgrades;
# Playerbots.PvpGear.Wear decides whether the loadout is worn.
# All loadouts are loaded with one query at startup; a login reads memory only, writes are asynchronous.
# Commands: .playerbots pvpgear status | reset [season] [tier] | show <bot> | check [count] [all] | selftest |
# stats [count] | grant <bot|all> <honor> <arena points>
# reset starts a season: every online ladder bot gets the given tier (default Playerbots.PvpGear.BaseTier) at once, the
# other loadouts are deleted and rebuilt at the bot's next login (at the reset's tier until the restart).
# Default: 0 (off: no catalogue, no rows)
Playerbots.PvpGear.Enable = 0

# The tiers, lowest first, comma-separated. A tier lists one or more item name prefixes separated by "/": an item named
# "<prefix> Gladiator's ..." belongs to that tier; an item without such a name (e.g. the faction medallions) belongs to
# the highest tier whose named items start at or below its item level. Unknown prefixes simply match nothing.
# Default: "Hateful/Savage,Deadly,Furious,Relentless,Wrathful"
Playerbots.PvpGear.TierOrder = "Hateful/Savage,Deadly,Furious,Relentless,Wrathful"

# The tier every ladder bot starts a season with (and gets at its first login): a tier name or prefix from
# Playerbots.PvpGear.TierOrder. A slot the tier has no item for (e.g. the Hateful/Savage vendors sell no weapons) takes
# the lowest tier above that has one. The slot of the PvP trinket (the medallion that breaks crowd control) is always
# filled when a tier has one, also for races with a racial that does the same. Within a tier a bot gets only items its
# arena rating allows (e.g. the Furious weapons are all item level 239 at rating 2350); a slot with no such item takes
# one from the tiers above, then from the tiers below, and only then one that needs a higher rating.
# Default: "" (the first tier)
Playerbots.PvpGear.BaseTier = ""

# Ladder bots buy PvP gear upgrades with their honor and arena points at the vendor prices and rating requirements
# (needs Playerbots.PvpGear.Enable). After every rated arena match and every
# Playerbots.PvpGear.Buy.CheckIntervalMinutes, a few bots per world tick: an upgrade is an item of a higher tier or,
# within a tier, of a higher item level, of the same kind (no switch between a two-hander and one-handers; trinket 1
# stays the PvP trinket; the rings differ), usable by the bot, whose rating requirement the bot meets (the best of
# min(personal rating, team rating) over its arena teams, the vendor's rule). Per slot the bot aims at the best
# upgrade its rating allows. The honor and arena points are taken from the character and the loadout row changes; a
# bot that wears its loadout (in a match, or on an arena server) swaps the slot at once. One log line per purchase;
# the PvE gear is never touched. Bots earn currency only from battleground honor and the arena point distribution
# (worldserver Arena.AutoDistributePoints).
# Default: 0 (off: nothing is bought)
Playerbots.PvpGear.Buy.Enable = 0

# The slots in the order the bots buy for them, comma-separated: weapon (main and off hand; a hunter's ranged slot
# takes the place before its main hand), ranged, head, neck, shoulders, chest, waist, legs, feet, wrists, hands, back,
# rings, trinkets, or one slot ("ring 1", "trinket 2", "main hand"). Slots left out follow in the default order
# (the value below lists the first ten; neck, rings, trinkets and ranged follow).
# Default: "weapon,chest,legs,head,shoulders,hands,feet,waist,wrists,back,neck,rings,trinkets,ranged"
Playerbots.PvpGear.Buy.SlotPriority = "weapon,chest,legs,head,shoulders,hands,feet,waist,wrists,back"

# 1: a bot saves toward the best upgrade its rating allows: while it cannot pay it, it buys no lesser piece for that
# slot, and the slots after it in the priority spend only what is left after that piece's price. A piece that needs a
# currency the bot has none of left is not saved toward (the slot gets the best upgrade the bot can pay): with no
# arena points, the honor still buys honor pieces. 0: in priority order, each slot gets the best upgrade the bot can
# pay.
# Default: 1
Playerbots.PvpGear.Buy.SaveTowardBetter = 1

# Minutes between two checks of every online ladder bot (1-1440; the checks after a rated arena match come on top).
# Default: 60
Playerbots.PvpGear.Buy.CheckIntervalMinutes = 60

# Bots checked per world tick (1-100; the match-end checks first).
# Default: 5
Playerbots.PvpGear.Buy.BatchPerTick = 5

# Ladder bots wear their PvP loadout in arenas and battlegrounds (needs Playerbots.PvpGear.Enable). When a ladder bot
# enters an arena or a battleground, a world-thread operation creates the loadout's items and equips them; the PvE
# items they replace go to the bags (a slot whose PvE item does not fit in the bags keeps it, logged). At the leave the
# PvP items are destroyed and the PvE items equipped again. While the loadout is worn, the upgrade actions, the
# level-up gear upkeep, selling and destroying leave the worn and the displaced items alone. Each swapped slot is a row
# in the playerbots table playerbots_pvp_worn, so a crash during a match is repaired at the bot's next login (rows are
# loaded and repaired at every start, also with this option or Playerbots.PvpGear.Enable off). On an arena server
# (Playerbots.Ladder.Role = 2) the hosted ladder bots wear the loadout from login on, also between matches; a depart
# takes it off before the members log out, so a team never leaves in PvP gear. A changed loadout (a pvpgear reset)
# swaps the changed slots of the bots that wear it.
# Default: 0 (off: the bots fight in their PvE gear)
Playerbots.PvpGear.Wear = 0

# Ladder bots keep their PvP loadout on between matches, as on an arena server (needs Playerbots.PvpGear.Wear). For
# servers that host only matches (a lab, Playerbots.ArenaOnly.Enable): the loadout goes on at the bot's login and
# stays on, so no world-thread swap runs at every arena entry and leave. Inside a match the bot wears the same items
# as with 0. Ignored on the main server (Playerbots.Ladder.Role = 1), where the bots wear their PvE gear between
# matches; on an arena server (Role 2) the loadout stays on anyway. A bot that logs out keeps the loadout on (its
# playerbots_pvp_worn rows); with this option at 0 its next login takes it off.
# Default: 0 (the loadout comes off at every leave)
Playerbots.PvpGear.WearBetweenMatches = 0

# Hidden bot skill. When 1, every bot gets a persistent skill 1-99 at its first login (normal distribution, mean 50,
# sd 15, rounded and clamped, seeded from the bot's guid so a reset reproduces it), stored in the playerbots table
# playerbots_bot_profile. All profiles are loaded with one query at startup; a bot login reads memory only, new rows
# are written asynchronously. The skill is hidden: only the GM command
# .playerbots skill [<bot> [set <1-99> | reroll]] and the PvP test harness records show it.
# With 0 (default) nothing is rolled, stored or used, and the harness records carry "skill":null.
Playerbots.Skill.Enable = 0

# Skill knob 1, reaction delay. Needs Playerbots.Skill.Enable = 1. A bot's reaction delay (GetReactDelay and the
# reaction engine's reset delay) is multiplied by a factor that falls linearly from ReactFactorAtSkill1 (skill 1) to
# ReactFactorAtSkill99 (skill 99). For example 2.5 and 0.7: the weakest bots react 2.5 times later, the best 0.7 times
# as late. Each is clamped to 0.1-10. Default 1.0 and 1.0 = no change. Bots with a game-client master are not scaled
# in GetReactDelay while Playerbots.Skill.ExemptRealMasterBots is 1 (the reset delay scales every bot).
Playerbots.Skill.ReactFactorAtSkill1 = 1.0
Playerbots.Skill.ReactFactorAtSkill99 = 1.0

# By default the skill acts in every fight, PvE included. With 1, bots play at full ability (factor 1.0) unless they
# are in a battleground, an arena, a duel or PvP combat; the skill then only shows in PvP.
Playerbots.Skill.FullAbilityInPvE = 0

# Skill knob 2, noticing. Needs Playerbots.Skill.Enable = 1. Interrupts, defensive cooldowns, dispels, crowd control,
# crowd-control breaks (Every Man for Himself, Will of the Forsaken, Escape Artist) and target switches wait until the
# bot has noticed them. Time runs in windows of NoticeWindowMs plus the bot's delay. In each window and category the bot
# notices after a delay of 0 to its NoticeDelayMs, or misses the whole window with its NoticeMissPercent chance; both
# come from a hash of the bot and the window, not a roll per action. Delay and miss chance fall linearly from AtSkill1
# (skill 1) to AtSkill99 (skill 99). A target switch is only delayed when the bot already has a live target. Bots with
# a game-client master are not affected while Playerbots.Skill.ExemptRealMasterBots is 1. Miss chance 0-95, delays
# 0-10000 ms, window 100-60000 ms.
# Default 0 everywhere = no change (the "skill" strategy is not added).
Playerbots.Skill.NoticeMissPercentAtSkill1 = 0
Playerbots.Skill.NoticeMissPercentAtSkill99 = 0
Playerbots.Skill.NoticeDelayMsAtSkill1 = 0
Playerbots.Skill.NoticeDelayMsAtSkill99 = 0
Playerbots.Skill.NoticeWindowMs = 1500

# Skill distribution. Every bot keeps a fixed percentile (from its guid, stored in playerbots_bot_profile.percentile);
# its skill is that percentile mapped through this distribution, rounded and clamped to 1-99. Changing the
# distribution or its parameters only stretches or shrinks the spread at the next start: every bot keeps its rank.
#    normal  = mean Mean, standard deviation Sd (default 50 and 15: exactly the skills rolled before)
#    uniform = evenly from Min to Max
# The GM command .playerbots skill <bot> reroll re-applies the distribution to the bot's percentile (it no longer draws
# a new one); set <1-99> sets the skill and the matching percentile. .playerbots skill selftest checks the mapping.
Playerbots.Skill.Distribution = normal
Playerbots.Skill.Mean = 50
Playerbots.Skill.Sd = 15
Playerbots.Skill.Min = 1
Playerbots.Skill.Max = 99

# Real-master exemption. With 1 (default, as before) a bot whose master plays through a game client (a real player or
# a self-bot) plays at full ability: no reaction factor in GetReactDelay, no notice delay or miss, every tactic known
# and used, full effort. With 0 the bots in a real player's group keep their skill like every other bot.
Playerbots.Skill.ExemptRealMasterBots = 1

# Skill growth (needs Playerbots.Skill.Enable = 1). With 1 every bot that plays an arena or battleground to its end
# (draws count, a leaver does not) grows its hidden skill: GainPerMatch points per match, RealPlayerFactor times that
# with a real player (or the headless test player) on its team, shrinking linearly to 0 at the bot's potential: its
# first roll (its percentile through the distribution above; growth never changes the percentile) plus a gap of
# PotentialMin..PotentialMax drawn from its guid, at most 99. Fractions round up with their chance, so the mean gain is
# exact; with the defaults about 30 matches (10 beside a real player) cover 60 % of the gap. Harness matches
# (.playerbots pvptest) never count, and a lab (Playerbots.Ladder.ServerId labN) ignores the option. The learnable
# attributes (Wisdom, Foresight, Knowledge, Teamwork; Dexterity at half) read the grown skill, the fixed ones (Speed,
# Focus, Discipline, Grit, the traits) the first roll. The new skill is saved at once and reaches a logged-in bot
# outside a fight. With 1 a start keeps a stored skill that lies above the first roll and at most at the potential;
# with 0 every skill goes back to its first roll at the next start (as before), so turning growth off drops it, and
# .playerbots skill <bot> reroll drops it too. .playerbots skill <bot> shows the first roll and the potential,
# .playerbots skill the growth counters, .playerbots tactics selftest growth checks the curve.
Playerbots.Skill.Growth.Enable = 0
Playerbots.Skill.Growth.GainPerMatch = 0.8
Playerbots.Skill.Growth.RealPlayerFactor = 3.0
Playerbots.Skill.Growth.PotentialMin = 10
Playerbots.Skill.Growth.PotentialMax = 40

# Skill curve. Every lerp from AtSkill1 to AtSkill99 (the reaction factor, the notice miss chance and delay, the
# tactics' use chances, effort) runs along position' = 1 - (1 - position)^CurveExponent, where position goes from 0 at
# skill 1 to 1 at skill 99. 1.0 (default) is the straight line, as before. Above 1 most of the ability comes early
# (at 2.0 skill 50 sits 75 % of the way), below 1 late. Clamped to 0.1-10.
Playerbots.Skill.CurveExponent = 1.0

# Tactic knowledge, effort and style: the skill gate of Playerbots.Tactics.* (hidden: only .playerbots tactics show
# lists them). Needs Playerbots.Skill.Enable = 1; a bot without a skill plays at full ability.
#   KnowledgeSpread: a tactic's KnownFromSkill (see Playerbots.Tactics) moves per bot and tactic by a fixed amount
#     from -KnowledgeSpread to +KnowledgeSpread (a hash of the guid and the tactic), so knowledge is patchy: a skill-45
#     bot may know one tactic of threshold 50 and miss another of threshold 40. 0-50, default 15.
#   EffortAtSkill1/99: how hard a bot tries, 0-100, lerped over skill (100: drinks, resets, uses every cooldown and
#     consumable, plays on when behind; low: gives up). EffortSpread moves it per bot by -EffortSpread..+EffortSpread
#     (from the guid), clamped to 0-100. Defaults 100, 100 and 0: every bot at full effort.
#   StyleSpread: three hidden traits per bot (aggression, caution, patience), each 50 plus a fixed amount from
#     -StyleSpread to +StyleSpread from the guid only, never from the skill: equal skill does not mean equal play.
#     0-50, default 0: every trait 50 (neutral).
# No tactic reads effort or style yet; the later tactics do.
Playerbots.Skill.KnowledgeSpread = 15
Playerbots.Skill.EffortAtSkill1 = 100
Playerbots.Skill.EffortAtSkill99 = 100
Playerbots.Skill.EffortSpread = 0
Playerbots.Skill.StyleSpread = 0

# Attributes (G0j): the hidden skill is a bot's latent general ability, and each bot draws eight abilities and four
# personality traits from it (hidden: only .playerbots skill <bot> and .playerbots tactics show <bot> list them). In
# normal scores an attribute is z = Loading x z_skill + Spread x sqrt(1 - Loading^2) x e, where z_skill is the skill's
# score through Playerbots.Skill.Distribution and e the attribute's own part: a standard normal from the guid hash,
# drawn at each skill load (login, .playerbots skill set; no per-tick cost), correlated with the other own parts by the
# Corr entries. An ability goes back onto the 1-99 scale through the same distribution; a trait is
# 50 + 50 x clamp(z / 3, -1, 1), its Spread inside z once (Spread 1: three standard deviations reach 0 or 100).
#   Abilities (1-99) and what reads them: Speed the natural reaction's draw (Playerbots.Natural.Reaction), the
#     reaction factor (ReactFactorAtSkill*) and the notice delay (NoticeDelayMsAtSkill*); Focus the notice miss
#     chance (NoticeMissPercentAtSkill*); Knowledge the tactics' KnownFromSkill test (KnowledgeSpread's jitter stays
#     on top); Discipline the tactics' use chance; Grit the effort (EffortAtSkill*; EffortSpread applies only while
#     Grit's Loading is 1); Wisdom, Foresight and Dexterity are read by later tactics.
#   Traits (0-100, 50 neutral): Aggression, Caution, Patience (the style traits: StyleSpread's uniform draw applies
#     only while the trait's Spread is 0; a Spread above 0 replaces it with the normal draw above) and Teamwork
#     (read by later tactics).
#   Loading.<Name>: 0-1, the attribute's correlation with the skill when its Spread is 1. Default 1 for the abilities
#     (the ability is the skill itself, exactly: its own part has weight 0, so the Corr entries do not touch it) and
#     0 for the traits.
#   Spread.<Name>: 0-3, the weight of the own part (1: the attribute spreads like the skill). Default 0: an ability
#     with a Loading below 1 then only moves toward the mean (Loading x z_skill); a trait stays at 50.
#   Corr.<A>-<B>: the correlation of two own parts, -0.99 to 0.99, either order, any pair (default 0). The matrix is
#     factorised (Cholesky) at load; a matrix that is not positive definite is refused with an error line and the own
#     parts are drawn uncorrelated. The entries below are the proposed links; at the default Loadings and Spreads
#     they change nothing.
#   Learnable (DT.14, for practice later, G6b): Knowledge, Wisdom, Foresight and Teamwork at the full rate,
#     Dexterity at half; Speed, Focus, Discipline, Grit and the traits fixed. No growth yet.
# Proposed starting values (not the defaults; G6a tunes them): Loading 0.8 for Knowledge, Wisdom and Foresight, 0.7
# Teamwork, 0.6 Focus, Discipline and Grit, 0.5 Speed and Dexterity, 0 the traits; every Spread 1.
# .reload config then .playerbots rndbot reload change them; a logged-in bot draws again at its next skill load or
# at .playerbots attributes reapply [<bot>|all]. .playerbots tactics selftest attributes checks the model.
# Lab copies (G0j-b, GM only, in memory, only where Playerbots.Ladder.ServerId is lab*): .playerbots attributes pin
# <template> <bot>[,<bot>...] gives bots of the template's class, race and level its skill, attributes, talents and
# stored PvP loadout (unpin <bot>[,...]|all, the copy's logout and the server shutdown put its own back; show [<bot>];
# logout <bot> logs a random bot out); pvptest arena copyA=<template> / copyB=<template> does it for a match, and the
# match records carry copyOf (the template's guid). A crash while pinned leaves the template's talents on the copy.
Playerbots.Skill.Attributes.Loading.Speed = 1.0
Playerbots.Skill.Attributes.Loading.Wisdom = 1.0
Playerbots.Skill.Attributes.Loading.Focus = 1.0
Playerbots.Skill.Attributes.Loading.Dexterity = 1.0
Playerbots.Skill.Attributes.Loading.Foresight = 1.0
Playerbots.Skill.Attributes.Loading.Knowledge = 1.0
Playerbots.Skill.Attributes.Loading.Discipline = 1.0
Playerbots.Skill.Attributes.Loading.Grit = 1.0
Playerbots.Skill.Attributes.Loading.Aggression = 0.0
Playerbots.Skill.Attributes.Loading.Caution = 0.0
Playerbots.Skill.Attributes.Loading.Patience = 0.0
Playerbots.Skill.Attributes.Loading.Teamwork = 0.0
Playerbots.Skill.Attributes.Spread.Speed = 0.0
Playerbots.Skill.Attributes.Spread.Wisdom = 0.0
Playerbots.Skill.Attributes.Spread.Focus = 0.0
Playerbots.Skill.Attributes.Spread.Dexterity = 0.0
Playerbots.Skill.Attributes.Spread.Foresight = 0.0
Playerbots.Skill.Attributes.Spread.Knowledge = 0.0
Playerbots.Skill.Attributes.Spread.Discipline = 0.0
Playerbots.Skill.Attributes.Spread.Grit = 0.0
Playerbots.Skill.Attributes.Spread.Aggression = 0.0
Playerbots.Skill.Attributes.Spread.Caution = 0.0
Playerbots.Skill.Attributes.Spread.Patience = 0.0
Playerbots.Skill.Attributes.Spread.Teamwork = 0.0
Playerbots.Skill.Attributes.Corr.Wisdom-Teamwork = 0.3
Playerbots.Skill.Attributes.Corr.Wisdom-Patience = 0.3
Playerbots.Skill.Attributes.Corr.Speed-Dexterity = 0.3
Playerbots.Skill.Attributes.Corr.Focus-Discipline = 0.3
Playerbots.Skill.Attributes.Corr.Aggression-Caution = -0.2

# Bot tactics. With 0 (default) no tactic runs, nothing is probed per update and the bots' strategies are today's.
# With 1, a tactic acts only when it is in the bot's tactic mask (the tactics whose own Enable is 1; the PvP test
# harness overrides the mask per side with tacticsA= / tacticsB=) and the bot's current context is in its Scope.
# Every bot uses the enabled tactics, the bots in a real player's group included.
# GM commands: .playerbots tactics show <bot> | stats [reset] | selftest [scope|gate|reaction|attributes|focus]
Playerbots.Tactics.Enable = 0

# Per tactic (all keys optional): Playerbots.Tactics.<Name>.Enable (default 0) and Playerbots.Tactics.<Name>.Scope,
# a comma list of the contexts it acts in: Arena, Battleground, World (open-world PvP: duels and PvP combat outside
# battlegrounds), Pve, or All / None. An unknown context logs a warning and keeps the default. The names and their
# default scopes:
#   Hold        Arena,Battleground,World   target hold
#   Plan        Arena,Battleground         team plan (kill and crowd-control marks)
#   Cc          Arena,Battleground,World   crowd control use and chains
#   OwnCc       All                        own crowd control kept
#   Trinket     Arena,Battleground,World   trinket and racials on crowd control that matters
#   Dispel      All                        partner's crowd control dispelled first
#   Interrupt   All                        interrupt choice and timing
#   Defensive   All                        defensives on burst
#   Protect     Arena,Battleground,World   partner protection
#   Fake        Arena,Battleground,World   fake casts
#   Los         Arena,Battleground,World   line of sight regained
#   Pillar      Arena                      pillar play
#   Kite        Arena,Battleground,World   kiting
#   Drink       Arena,Battleground         drinking
#   Natural     All                        natural reaction, facing, tracking, paths (PvE: in sight of a real player)
#   Jump        Arena                      tactical jumps
#   FocusTarget Arena,Battleground,World   kicks and crowd control on a focus target, the own target kept (G4e)
# The skill gate (needs Playerbots.Skill.Enable = 1): Playerbots.Tactics.<Name>.KnownFromSkill, 0-100 (default 0 =
# every bot knows it; 100 = no bot), the skill from which a bot knows the tactic, moved per bot by
# Playerbots.Skill.KnowledgeSpread; below it the bot never uses the tactic. Playerbots.Tactics.<Name>.UseChanceAtSkill1
# and .UseChanceAtSkill99, 0-100 % (default 100 and 100): the chance that a bot that knows the tactic uses it in a
# window of Playerbots.Skill.NoticeWindowMs, lerped by skill from skill 1 to skill 99 (Playerbots.Skill.CurveExponent
# applies). One answer per bot, tactic and window (a hash, not a roll per update). The defaults leave a tactic as its
# Enable and Scope make it.
# Example (the defaults):
# Playerbots.Tactics.Hold.Enable = 0
# Playerbots.Tactics.Hold.Scope = Arena,Battleground,World
# Playerbots.Tactics.Hold.KnownFromSkill = 0
# Playerbots.Tactics.Hold.UseChanceAtSkill1 = 100
# Playerbots.Tactics.Hold.UseChanceAtSkill99 = 100
# Playerbots.Tactics.Plan.Enable = 0
# Playerbots.Tactics.Plan.Scope = Arena,Battleground
# Playerbots.Tactics.Plan.KnownFromSkill = 0
# Playerbots.Tactics.Cc.Enable = 0
# Playerbots.Tactics.Cc.Scope = Arena,Battleground,World
# Playerbots.Tactics.Cc.KnownFromSkill = 0
# Playerbots.Tactics.OwnCc.Enable = 0
# Playerbots.Tactics.OwnCc.Scope = All
# Playerbots.Tactics.Trinket.Enable = 0
# Playerbots.Tactics.Trinket.Scope = Arena,Battleground,World
# Playerbots.Tactics.Trinket.KnownFromSkill = 0
# Playerbots.Tactics.Dispel.Enable = 0
# Playerbots.Tactics.Dispel.Scope = All
# Playerbots.Tactics.Dispel.KnownFromSkill = 0
# Playerbots.Tactics.Kite.Enable = 0
# Playerbots.Tactics.Drink.Enable = 0
# Playerbots.Tactics.Jump.Enable = 0
# Playerbots.Tactics.Natural.Enable = 0

# Target hold and team plan: the numbers of the Hold and Plan tactics (all keys optional, the defaults below; read only
# where those tactics are enabled). The defaults are proposals, not tuned yet (G6a tunes them). An ...AtSkill1 /
# ...AtSkill99 pair is lerped over the bot's Wisdom (judgement; the re-mark delay over its Speed) along
# Playerbots.Skill.CurveExponent; with the attribute defaults that is the skill, and skill 0 takes the skill-99 value.
# The personality traits move some values (neutral 50 moves nothing): Patience lengthens both holds (up to x1.25),
# Aggression raises both execute thresholds (up to 10 points: an earlier execute), Caution widens the swap off a
# defensive (up to 15 points), Teamwork raises the chance to follow the partner (up to x1.5), shortens the follow delay
# (down to x0.7) and raises the margin a bot other than the planner needs to re-mark (up to x1.5).
#
# Hold (one bot's target, every context in Playerbots.Tactics.Hold.Scope): a bot keeps its target for HoldMs, then
# switches only to a candidate that scores HysteresisPct points better (a point is one percent of health; a switch's
# reaction cost adds a point per 100 ms). It always switches when the target dies, leaves range, is out of its sight
# for longer than LosLostMs or turns immune. A candidate at or below ExecPct % health (its target above it, no
# defensive up) overrides the hold with ExecChance % per 3 s window. Low skill shows tunnel vision (long hold, a
# hysteresis of 100 that health alone never reaches, no execute): it switches only for death, range and immunity.
# Without marks, FollowChance % (one answer per 10 s window) is the chance to take the partner's target once the
# partner has had it for FollowDelayMs: none at low skill, sometimes and late at mid skill.
# Playerbots.Tactics.Hold.HoldMsAtSkill1 = 20000
# Playerbots.Tactics.Hold.HoldMsAtSkill99 = 1500
# Playerbots.Tactics.Hold.HysteresisPctAtSkill1 = 100
# Playerbots.Tactics.Hold.HysteresisPctAtSkill99 = 8
# Playerbots.Tactics.Hold.ExecPctAtSkill1 = 15
# Playerbots.Tactics.Hold.ExecPctAtSkill99 = 25
# Playerbots.Tactics.Hold.ExecChanceAtSkill1 = 0
# Playerbots.Tactics.Hold.ExecChanceAtSkill99 = 90
# Playerbots.Tactics.Hold.FollowChanceAtSkill1 = 0
# Playerbots.Tactics.Hold.FollowChanceAtSkill99 = 80
# Playerbots.Tactics.Hold.FollowDelayMsAtSkill1 = 4000
# Playerbots.Tactics.Hold.FollowDelayMsAtSkill99 = 1000
# Playerbots.Tactics.Hold.LosLostMs = 1500
#
# Focus (the team plan, arenas): the group's target icons carry the plan, skull = kill target, moon = crowd-control
# target (moon only when the team can control). The planner is the team's alive bot with the higher skill (ties: the
# lower guid) at or above Playerbots.Tactics.Plan.KnownFromSkill (the Plan tactic's gate key above; 40 is the proposal
# when the plan is on; there is no Focus.KnownFromSkill); with a real player in the group he marks and no bot plans.
# The planner re-plans every PlanIntervalMs and keeps the kill target for HoldMs; after the hold another enemy must
# score HysteresisPct points better (health, healer, range and sight of the team's bots, defensives, trinket, physical
# immunity for a physical team, stun or fear). It switches at once when the kill target dies, turns immune to
# everything, falls into the team's breakable crowd control (never a kill target) or is out of every own bot's sight
# for longer than LosLostMs; an enemy at or below ExecPct % health (no defensive up) overrides the hold with
# ExecChance % per 3 s window; a kill target with a defensive up is left for an enemy within DefensiveSwapPct points
# of its health. Marks are set at the start and change only on events (the kill target dies or turns immune, a big
# opening), at most once per MinRemarkSeconds, RemarkDelayMs after the event (a human delay), never within
# HumanMarkRespectSeconds of a real player's mark. Any other bot, in a real player's group too, re-marks only when its
# own judgement beats the marked target by StrongMargin score points, so rarely.
# Playerbots.Tactics.Focus.PlanIntervalMsAtSkill1 = 2300
# Playerbots.Tactics.Focus.PlanIntervalMsAtSkill99 = 300
# Playerbots.Tactics.Focus.HoldMsAtSkill1 = 5300
# Playerbots.Tactics.Focus.HoldMsAtSkill99 = 2000
# Playerbots.Tactics.Focus.HysteresisPctAtSkill1 = 28
# Playerbots.Tactics.Focus.HysteresisPctAtSkill99 = 8
# Playerbots.Tactics.Focus.ExecPctAtSkill1 = 15
# Playerbots.Tactics.Focus.ExecPctAtSkill99 = 25
# Playerbots.Tactics.Focus.ExecChanceAtSkill1 = 30
# Playerbots.Tactics.Focus.ExecChanceAtSkill99 = 90
# Playerbots.Tactics.Focus.RemarkDelayMsAtSkill1 = 2500
# Playerbots.Tactics.Focus.RemarkDelayMsAtSkill99 = 800
# Playerbots.Tactics.Focus.StrongMarginAtSkill1 = 50
# Playerbots.Tactics.Focus.StrongMarginAtSkill99 = 30
# Playerbots.Tactics.Focus.MinRemarkSeconds = 8
# Playerbots.Tactics.Focus.HumanMarkRespectSeconds = 10
# Playerbots.Tactics.Focus.LosLostMs = 1500
# Playerbots.Tactics.Focus.DefensiveSwapPct = 25
# The planner's snapshot of an enemy is what its team sees (health, auras, cast bars, sight); from
# AddonKnowledgeFromSkill (the planner's Knowledge, the skill with the attribute defaults; skill 0 always) it also
# remembers what an addon would: a defensive seen used this match counts as spent.
# Playerbots.Tactics.Focus.AddonKnowledgeFromSkill = 40
# The moon: MoonMode 1 marks one whenever the team has a class with a crowd-control option (G1b's rule); 0 never
# marks one; 2 marks one only for a team that plays crowd control (the planner's Cc tactic enabled here) and keeps it
# only while a CC lands on it or a teammate's cast bar shows one at it: MoonGraceMs after the mark or the last such
# sight the planner clears it (the team's damage may go there again) and sets none for MoonRetryMs. In mode 2 the
# target hold also lets a bot leave the skull for a moon that is not controlled. The mode is read at each match's
# start; ".playerbots tactics moon <0|1|2>" switches it on a running server from the next match (a restart or
# ".playerbots rndbot reload" restores this value; ".reload config" alone does not re-read it).
# Playerbots.Tactics.Focus.MoonMode = 1
# Playerbots.Tactics.Focus.MoonGraceMs = 5000
# Playerbots.Tactics.Focus.MoonRetryMs = 10000
# (Ranges: ms keys 0-120000, percents 0-100, StrongMargin 0-255, seconds 0-600, AddonKnowledgeFromSkill 0-99, MoonMode
# 0-2; larger values are capped.)

# Crowd control and its avoidance: the numbers of the Cc, OwnCc and Trinket tactics (all keys optional, the defaults
# below; the Cc tactic reads them from G4b, OwnCc and Trinket in later steps). The defaults are proposals, not tuned
# yet. With the Cc tactic enabled and known at the bot's skill (arena, battleground, open-world PvP), the strategy
# "tactic cc" casts the bot's longest-lasting usable CC (its highest known rank; a loss of control before a root, no
# root on a rooted target or on the moon; a healer waits while a teammate is below CriticalHealth) on the team's CC
# target: the moon in an arena, else the strongest enemy other than its own target and the skull; the old "cc"
# strategy's actions are
# muted there ("pvp cc"); outside the scope, or below Cc.KnownFromSkill, "cc" acts as before. An
# ...AtSkill1 / ...AtSkill99 pair is lerped over one attribute of the bot along Playerbots.Skill.CurveExponent (with the
# attribute defaults that is the skill; skill 0 takes the skill-99 value and passes every ...FromSkill threshold).
# When a bot knows crowd control at all is Playerbots.Tactics.Cc.KnownFromSkill (the gate key above; 30 is the
# proposal when the tactic is on).
#
# Cc: from DrAwareFromSkill (Knowledge) a bot remembers the CC it saw land on each enemy, like a DR addon (never the
# server's own counters): it casts nothing its memory says lands immune or for less than MinExpectedMs (the third CC
# of a group, a quarter of its duration), and not the DR group already on the target. Below it the bot casts into DR.
# DrMissPct is the share of CC seen landing on a started count that the memory misses (Knowledge). From
# ChainsFromSkill (Knowledge) a bot chains: it starts its CC so that it lands ChainLeadMs before the one on the target
# ends (Foresight); below it, it waits until the target is free. WrongTargetPct: the CC goes on whoever is near instead
# of the CC target (Wisdom; one answer per bot and 10 s). A patient bot (the Patience trait above 50) holds its CC up
# to PatientHoldMs x its patience for the kill window; a bot whose effort is below 50 stops controlling when its team
# is BehindStopPct health points behind.
# Playerbots.Tactics.Cc.DrAwareFromSkill = 40
# Playerbots.Tactics.Cc.ChainsFromSkill = 65
# Playerbots.Tactics.Cc.MinExpectedMs = 3000
# Playerbots.Tactics.Cc.DrMissPctAtSkill1 = 40
# Playerbots.Tactics.Cc.DrMissPctAtSkill99 = 0
# Playerbots.Tactics.Cc.ChainLeadMsAtSkill1 = 0
# Playerbots.Tactics.Cc.ChainLeadMsAtSkill99 = 300
# Playerbots.Tactics.Cc.WrongTargetPctAtSkill1 = 50
# Playerbots.Tactics.Cc.WrongTargetPctAtSkill99 = 0
# Playerbots.Tactics.Cc.PatientHoldMs = 3000
# Playerbots.Tactics.Cc.BehindStopPct = 30
#
# Chains (G4c): with ChainEnable = 1 a bot from ChainsFromSkill also casts on a target its team holds in a loss of
# control: a CC of another DR group than the one on it (the memory says which still lands), started so that it lands
# ChainLeadMs before the team's CC ends (the visible aura), never over a teammate's CC on his cast bar; a bot whose
# memory says the rest lands immune waits. 0 keeps G4b's rule (no CC on a controlled target). With
# OpponentMemoryEnable = 1 (G4c-b) a chaining bot also remembers per enemy how soon it dispels or trinkets the team's
# CC this match and, after OpponentMinEvents of them, lands the next CC DispelMarginMs before the expected dispel.
# Playerbots.Tactics.Cc.ChainEnable = 0
# Playerbots.Tactics.Cc.OpponentMemoryEnable = 0
# Playerbots.Tactics.Cc.OpponentMinEvents = 2
# Playerbots.Tactics.Cc.DispelMarginMs = 300
#
# Avoid: OwnBreakPct is the share of the bot's damage that breaks its team's breakable CC (Focus); from
# OwnBreakNeverFromSkill (Focus) a bot never breaks it (100: every bot below full ability can). A bot breaks a CC on
# itself (trinket, racials) when it matters: a stun, fear, horror, incapacitate, disorient, sleep or cyclone with
# MinLeftMs or more left while the bot or its partner is at or below LowHealthPct % health or being burst; any other
# CC it breaks with WastedBreakPct (Wisdom; one answer per bot and 10 s), except that from IgnoreRootsFromSkill
# (Wisdom) it never breaks a root, snare or silence.
# Playerbots.Tactics.Avoid.OwnBreakPctAtSkill1 = 60
# Playerbots.Tactics.Avoid.OwnBreakPctAtSkill99 = 5
# Playerbots.Tactics.Avoid.OwnBreakNeverFromSkill = 65
# Playerbots.Tactics.Avoid.WastedBreakPctAtSkill1 = 70
# Playerbots.Tactics.Avoid.WastedBreakPctAtSkill99 = 0
# Playerbots.Tactics.Avoid.IgnoreRootsFromSkill = 65
# Playerbots.Tactics.Avoid.MinLeftMs = 2500
# Playerbots.Tactics.Avoid.LowHealthPct = 40
#
# Trinket and Dispel (G5a; Playerbots.Tactics.Trinket.Enable / Dispel.Enable): a bot that knows the Trinket tactic
# breaks a CC on it as above with its PvP trinket ("pvp trinket", an item with spell 42292; "use trinket" then never
# spends it as a boost) or a racial (every man for himself, will of the forsaken, escape artist), the trinket first;
# below the tactic's known skill it does not tell a CC that matters and breaks any CC with WastedBreakPct. From
# WastedBreakNeverFromSkill (Wisdom) a bot breaks only a CC that matters. CautiousLowHealthPct moves the low-health
# line of a bot's own breaks by its Caution (Caution 100: LowHealthPct + CautiousLowHealthPct, Caution 0: minus it;
# 0 = every bot at LowHealthPct). A cleanser (priest, paladin, shaman) that knows the Dispel tactic frees a party
# member (itself first) from a loss of control or a root its class removes ("dispel cc on party") before its other
# cleanses. EnsureTrinket (harness matches only): 1 gives a bot without a PvP trinket one at the fight start (after
# the PvP gear's wear; not Human or Undead: their racial shares its cooldown) and takes it back at the end, the leave
# or the logout (a crash: at the next login, by the item's mark), 2 withholds every bot's PvP trinket (the racial and
# dispel fallbacks), 0 leaves the gear as it is; .playerbots tactics ensuretrinket 0|1|2 switches it on a running
# server (the next fight start takes it).
# Playerbots.Tactics.Avoid.WastedBreakNeverFromSkill = 65
# Playerbots.Tactics.Avoid.CautiousLowHealthPct = 0
# Playerbots.Tactics.Avoid.EnsureTrinket = 0
#
# OwnCc's own-break guards (G4c-b; 1 = on, 0 = G4b's behaviour): AoeGuardEnable mutes an area, cone or chain spell
# whose reach (its radius + AoeGuardMarginYards) covers an enemy the bot keeps out; DotGuardEnable casts no CC that
# damage breaks on a target the team's periodic damage hits; PetCallOffEnable calls the bot's pet off a kept-out
# enemy; ExcludeFightEnemies also keeps out the team's CC'd enemies of "fight enemies" (not only the bot's attackers,
# its target and the skull). AoeGuardExemptClasses and DotGuardExemptClasses (G6d-a) are class masks (the sum of
# 1 << (class - 1): warrior 1, paladin 2, hunter 4, rogue 8, priest 16, death knight 32, shaman 64, mage 128,
# warlock 256, druid 1024) whose bots skip that guard, e.g. 272 (priest and warlock): their periodic damage is on every
# enemy, so the DoT guard takes their fear away whenever they keep their team's CC; 0 = every bot keeps the guard.
# Playerbots.Tactics.Avoid.AoeGuardEnable = 0
# Playerbots.Tactics.Avoid.AoeGuardMarginYards = 2
# Playerbots.Tactics.Avoid.AoeGuardExemptClasses = 0
# Playerbots.Tactics.Avoid.DotGuardEnable = 0
# Playerbots.Tactics.Avoid.DotGuardExemptClasses = 0
# Playerbots.Tactics.Avoid.PetCallOffEnable = 0
# Playerbots.Tactics.Avoid.ExcludeFightEnemies = 0
# (Ranges: ms keys 0-120000, percents 0-100, ...FromSkill 0-100 (100: no bot below full ability), switches 0-1,
# OpponentMinEvents 0-20, AoeGuardMarginYards 0-20, EnsureTrinket 0-2; larger values are capped.)
#
# Interrupt (G5b; Playerbots.Tactics.Interrupt.Enable, scope All: PvE too). Off (the default), every interrupt
# trigger kicks the first interruptible cast it sees, and "X on enemy healer" the first helpful cast of an attacker
# other than the target. On, a bot below Interrupt.KnownFromSkill, or one whose Wisdom takes the shortcut (G0h3's
# think depth, Playerbots.Natural.Reaction.Think*), still does so; a bot that judges the cast kicks crowd control at
# once (CcSharePct of the bar), a heal late (HealSharePct, lerped by skill; a heal on a friend at or below UrgentHpPct
# % health as a CC), a damage cast at DamageSharePct but not while an enemy healer (a healer class seen healing) is in
# reach and sight (HoldForHealer 1), and nothing else. The commit share gets a log-normal noise (SigmaPct, per cent of
# sigma, lerped by skill), CancelSharePct times the caster's fake rate (cancels seen per cast, from CancelMinCasts
# casts seen; the opponent memory, Playerbots.Natural.Reaction.Memory*) and, for heals and damage, PatienceSharePct
# by the Patience trait (100: +, 0: -, 50: none); never above MaxSharePct. With Playerbots.Natural.Reaction.EndToEnd 1
# the kick lands at the later of the commit point and the reaction model's due time, both from the bar's start (a bar
# older than 3 s counts from the first query); without it the model counts from the first query, which is the commit
# point, and the kick lands at the commit point plus the reaction time. "X on enemy healer" takes the best cast of the
# fight's enemies other than the target (a heal on a low friend, a CC, a heal, damage), kept HealerCacheMs ms.
# Playerbots.Tactics.Interrupt.Enable = 0
# Playerbots.Tactics.Interrupt.KnownFromSkill = 0
# Playerbots.Tactics.Interrupt.HealSharePctAtSkill1 = 30
# Playerbots.Tactics.Interrupt.HealSharePctAtSkill99 = 70
# Playerbots.Tactics.Interrupt.DamageSharePct = 50
# Playerbots.Tactics.Interrupt.CcSharePct = 0
# Playerbots.Tactics.Interrupt.MaxSharePct = 90
# Playerbots.Tactics.Interrupt.SigmaPctAtSkill1 = 40
# Playerbots.Tactics.Interrupt.SigmaPctAtSkill99 = 15
# Playerbots.Tactics.Interrupt.UrgentHpPct = 30
# Playerbots.Tactics.Interrupt.CancelSharePct = 15
# Playerbots.Tactics.Interrupt.CancelMinCasts = 3
# Playerbots.Tactics.Interrupt.PatienceSharePct = 10
# Playerbots.Tactics.Interrupt.HoldForHealer = 1
# Playerbots.Tactics.Interrupt.HealerCacheMs = 200
#
# The use draw (G5c-c): per cast, a bot notices it with UsePctAtSkill1..99 % (lerped by skill; the rest it lets go,
# "unnoticed"), on the shortcut and the judging path alike. 100 and 100 (the defaults): every cast, as before.
# Playerbots.Tactics.Interrupt.UsePctAtSkill1 = 100
# Playerbots.Tactics.Interrupt.UsePctAtSkill99 = 100
# The attention gap (G5c-c): once its kick is ready, a bot notices interruptible casts only after a gap, drawn per
# ready window (exponential, at most 3 means) with the mean AttentionMsAtSkill1..99 ms, lerped by skill on a convex
# curve (the gap shrinks fast with skill: at 30000 and 0 the mean is about 19 s at skill 20, 7.5 s at 50, 1.1 s at
# 80). A cast it does not notice it lets go ("unnoticed"); this keeps weak bots from kicking at every cooldown.
# 0 and 0 (the defaults): no gap, as before.
# Playerbots.Tactics.Interrupt.AttentionMsAtSkill1 = 0
# Playerbots.Tactics.Interrupt.AttentionMsAtSkill99 = 0
#
# The hold policy (G5c-c). HoldPolicy 0 (the default): the HoldForHealer rule above. HoldPolicy 1: a judging bot holds
# its kick on a damage cast only while a cast heal of an enemy healer in reach and sight is likely and its window
# reachable. Pressure decides the need for a cast heal: 0 with every enemy at or above HoldHpHighPct % health, full at
# or below HoldHpLowPct, linear between. Seen within HoldRecentCastHealMs starting a cast heal the bot recognises, the
# healer evidently uses them: HoldHpHighPct counts HoldRecentHpShiftPct points higher and its instants are no cover;
# else instant heals or absorbs of the healer the bot recognises, seen within HoldInstantSeenMs, lower HoldHpHighPct
# by HoldInstantCoverPct % of the way down to HoldHpLowPct (at or below HoldHpLowPct the need stays full: an instant
# does not save a nearly dead friend). The window is reachable when the bot's reaction to the heal it waits for (the
# reaction median, ping and display, the button and the deep check, shortened by Foresight) lands HoldWindowMarginMs
# before the heal's end; the heal's cast time is the last one seen, else the class's usual one, else
# HoldAssumedCastMs. A bot knows a spell (its cast time, that it heals, that it is instant) with
# HoldKnowPctAtKnowledge1..99 % (one draw per bot and spell) and its motivation is scaled by
# HoldMotivationPctAtKnowledge1..99 %; it holds with that motivation (one draw per cast) for at most
# HoldMsAtPatience0..100 ms per episode (by the Patience trait), then kicks damage again; the episode ends HoldResetMs
# after its last held cast (or after it ran out), and the bot may hold again. The trend: the need is read from the
# health the bot expects when its kick is back, the lowest enemy's health minus its net loss per second over the last
# 2 s times HoldTrendHorizonMs (about the kick's cooldown; a burst that takes the enemy into cast heal range within it
# counts now, so the kick is not spent on a damage cast just before the heal), times HoldTrendPctAtKnowledge1..99 %
# (a bot that knows less reads the trend less far ahead). 0: the current health only.
# Playerbots.Tactics.Interrupt.HoldPolicy = 0
# Playerbots.Tactics.Interrupt.HoldKnowPctAtKnowledge1 = 40
# Playerbots.Tactics.Interrupt.HoldKnowPctAtKnowledge99 = 100
# Playerbots.Tactics.Interrupt.HoldAssumedCastMs = 2000
# Playerbots.Tactics.Interrupt.HoldInstantSeenMs = 8000
# Playerbots.Tactics.Interrupt.HoldHpHighPct = 80
# Playerbots.Tactics.Interrupt.HoldHpLowPct = 40
# Playerbots.Tactics.Interrupt.HoldRecentCastHealMs = 6000
# Playerbots.Tactics.Interrupt.HoldRecentHpShiftPct = 10
# Playerbots.Tactics.Interrupt.HoldInstantCoverPct = 80
# Playerbots.Tactics.Interrupt.HoldWindowMarginMs = 300
# Playerbots.Tactics.Interrupt.HoldMotivationPctAtKnowledge1 = 30
# Playerbots.Tactics.Interrupt.HoldMotivationPctAtKnowledge99 = 100
# Playerbots.Tactics.Interrupt.HoldMsAtPatience0 = 1000
# Playerbots.Tactics.Interrupt.HoldMsAtPatience100 = 6000
# Playerbots.Tactics.Interrupt.HoldResetMs = 6000
# Playerbots.Tactics.Interrupt.HoldTrendHorizonMs = 10000
# Playerbots.Tactics.Interrupt.HoldTrendPctAtKnowledge1 = 50
# Playerbots.Tactics.Interrupt.HoldTrendPctAtKnowledge99 = 100
#
# SeeCancelLag (13e-decide): 1 = a cast bar that ends (finished, cancelled or cut) stays in the judging kicker's view
# for its reaction delay (the reaction model's median plus ping, display and the deep check), so a kick it committed on
# that bar goes on the ended bar while it cannot yet see the end (a fake's cancel baits it; the kick is spent); a kick
# committed while the bar was in view goes out when the kicker's reaction passes, until the bar as seen would have run
# out (at most 1.5 s after the commit). 0 (the default) reads the bar's end live, as before. (Range 0-1.)
# Playerbots.Tactics.Interrupt.SeeCancelLag = 0
#
# With the Interrupt tactic enabled (or the PvP harness on), the strategy "tactic interrupt" adds the class kicks the
# specs' own strategies lack, all through the decision above: the mage's counterspell on the current target, the death
# knight's strangulate (30 yards; mind freeze is 5, so strangulate is the long-range kick and the backup while mind
# freeze is not ready), a priest's silence outside Shadow and a hunter's silencing shot outside Marksmanship, for
# every spec that knows the spell. An Arms warrior has no kick in Battle stance (pummel needs Berserker stance):
# ArmsPummel 1 lets it swap into Berserker stance for a kick worth taking (the battle stance trigger swaps back), at
# the cost of the stance change's rage and one tick. 0 (the default): an Arms warrior never interrupts. Read when the
# bot's engine is built (login or strategy reset), not on a config reload.
# Playerbots.Tactics.Interrupt.ArmsPummel = 0
# (Ranges: percents 0-100, CancelMinCasts 0-20, HoldForHealer and HoldPolicy 0-1, HealerCacheMs 0-5000,
# HoldAssumedCastMs 0-10000, HoldWindowMarginMs 0-2000, AttentionMs and the other Hold ms keys 0-60000.)
#
# Focus target (G4e; Playerbots.Tactics.FocusTarget.Enable, scope Arena,Battleground,World). On, a bot from
# Playerbots.Natural.Reaction.Ease.FocusDexterity keeps a focus target (in an arena the moon, taken over the enemy
# healer with MoonPctAtTeamwork1..99 % by Teamwork; else the enemy healer or the CC target) and kicks or controls it
# at the focus ease, its own target kept; an interrupt on the focus scores KickBonus over other casts of its kind.
# Below the threshold the action is priced as a new target. Off (the default): no focus target.
# Playerbots.Tactics.FocusTarget.Enable = 0
# Playerbots.Tactics.FocusTarget.MoonPctAtTeamwork1 = 50
# Playerbots.Tactics.FocusTarget.MoonPctAtTeamwork99 = 100
# Playerbots.Tactics.FocusTarget.KickBonus = 50
# (Ranges: percents 0-100, KickBonus 0-255.)
#
# Defensives on burst and the partner protected (G5d; Playerbots.Tactics.Defensive.Enable, scope All, and
# Playerbots.Tactics.Protect.Enable, scope Arena,Battleground,World). With Defensive on, the strategy "tactic
# defensive" presses the class's self-defensives (mage ice block, paladin divine shield, rogue cloak or evasion, death
# knight icebound fortitude, hunter deterrence, druid barkskin or survival instincts, disc priest pain suppression,
# shadow priest dispersion, protection warrior shield wall; healthstones and potions with PotionEnable) when health is
# at or below HpPctAtSkill1..99 per cent AND (the bot is under burst OR focused). Burst: health lost within
# BurstWindowMs of at least BurstLossPctAtSkill1..99 per cent, from a ring of 16 health samples taken every SampleMs.
# Focused: at least FocusedMinEnemies enemy players whose victim or cast target is the bot (what the combat log and the
# cast bars show; read in Arena, Battleground and open-world PvP only); a focused bot presses FocusedHpBonusPct points
# earlier. A low-skill bot presses only at CriticalHpPct, or at the gates opening with the chance
# OpenerPctAtSkill1..99; low effort waits LateMsAtEffort0..100 ms after the trigger holds; Caution moves the threshold
# by up to CautionShiftPct points; two presses are at least MinGapMs apart; no press while a defensive is up or every
# self-defensive is on cooldown. With Protect on, PartyMemberToProtect returns a partner (PvP scope only: hand of
# protection drops a tank's threat) that an enemy within Protect.DistanceYards attacks now (its victim or cast target),
# whose health is at or below Protect.HpPctAtSkill1..99 per cent and who has no defensive of its own up; the existing
# protect actions (hand of protection, pain suppression, intervene) use it with their own cooldowns. A disc priest
# with Protect on and a living partner keeps pain suppression for the partner: on itself only at CriticalHpPct (the
# Defensive tactic's opener, burst and focused presses skip it). Opponent memory (Foresight; from skill
# Opponent.FromSkill): the bot remembers when each enemy was last seen with a major defensive up (immunities: ice
# block, divine shield, deterrence, dispersion; physical stops: evasion, hand of protection; magic stops: cloak of
# shadows, anti-magic shell). It holds its burst while a defensive that stops its own damage is up (an immunity, or the
# stop of its damage type: melee and hunters physical, casters magic; minor reductions such as barkskin or pain
# suppression never hold), and while the enemy owns such a defensive not seen up within Opponent.ExpireMs (believed
# ready) until the enemy uses it: at most BurstHoldMaxMs from the first such hold since its last use (0: no such hold)
# and never with the enemy at or below BurstHoldFloorPct per cent health. A stop that is up (not an immunity) holds
# the burst under the same cap, counted per episode of the aura, and the same floor (13e-polish; an immunity holds while
# it lasts). "Focused" counts only against an enemy team
# of at least FocusedMinTeam players at the match's start (the arena's size; battlegrounds and the open world always):
# in 2v2 both enemies on the bot are the normal case, so there only burst and the plain line press. Opponent.Enable 0
# turns the memory off. Protect.AttackedWithinMs, Protect.MinGapMs, Opponent.MinEvents and
# Opponent.LeadPctAtForesight99 (the lead of the hold before 13e-decide) are read but not used.
# Playerbots.Tactics.Defensive.Enable = 0
# Playerbots.Tactics.Protect.Enable = 0
# Playerbots.Tactics.Defensive.BurstWindowMs = 2000
# Playerbots.Tactics.Defensive.BurstLossPctAtSkill1 = 55
# Playerbots.Tactics.Defensive.BurstLossPctAtSkill99 = 30
# Playerbots.Tactics.Defensive.SampleMs = 250
# Playerbots.Tactics.Defensive.FocusedMinEnemies = 2
# Playerbots.Tactics.Defensive.FocusedMinTeam = 3
# Playerbots.Tactics.Defensive.HpPctAtSkill1 = 25
# Playerbots.Tactics.Defensive.HpPctAtSkill99 = 60
# Playerbots.Tactics.Defensive.FocusedHpBonusPct = 15
# Playerbots.Tactics.Defensive.CriticalHpPct = 20
# Playerbots.Tactics.Defensive.OpenerPctAtSkill1 = 40
# Playerbots.Tactics.Defensive.OpenerPctAtSkill99 = 0
# Playerbots.Tactics.Defensive.LateMsAtEffort0 = 1200
# Playerbots.Tactics.Defensive.LateMsAtEffort100 = 0
# Playerbots.Tactics.Defensive.CautionShiftPct = 10
# Playerbots.Tactics.Defensive.MinGapMs = 1500
# Playerbots.Tactics.Defensive.PotionEnable = 1
# Playerbots.Tactics.Defensive.PotionHpPct = 35
# Playerbots.Tactics.Defensive.Protect.HpPctAtSkill1 = 20
# Playerbots.Tactics.Defensive.Protect.HpPctAtSkill99 = 40
# Playerbots.Tactics.Defensive.Protect.AttackedWithinMs = 3000
# Playerbots.Tactics.Defensive.Protect.DistanceYards = 30
# Playerbots.Tactics.Defensive.Protect.MinGapMs = 2000
# Playerbots.Tactics.Defensive.Opponent.Enable = 1
# Playerbots.Tactics.Defensive.Opponent.LeadPctAtForesight99 = 20
# Playerbots.Tactics.Defensive.Opponent.MinEvents = 1
# Playerbots.Tactics.Defensive.Opponent.FromSkill = 40
# Playerbots.Tactics.Defensive.Opponent.ExpireMs = 120000
# Playerbots.Tactics.Defensive.BurstHoldMaxMs = 8000
# Playerbots.Tactics.Defensive.BurstHoldFloorPct = 30
# (Ranges: percents 0-100, ms 0-120000, FocusedMinEnemies and FocusedMinTeam 0-8, Protect.DistanceYards 0-100,
# PotionEnable and Opponent.Enable 0-1, Opponent.MinEvents 0-20, Opponent.FromSkill 0-100.)
#
# Fake casts (G5e; Playerbots.Tactics.Fake.Enable, scope Arena,Battleground,World). With it on, a bot from
# KnownFromSkill (Knowledge) that starts a kickable cast of at least MinCastMs sees whether an enemy player of its
# fight could kick it (its class has a kick aimed at one enemy; it is within that kick's reach (melee 5, Wind Shear
# 25, Counterspell and Silence 30, Silencing Shot 35 yards) capped at KickerRangeYards, plus KickerRangeSlackYards;
# and it faces the bot or targets it when KickerNeedFacing is 1) and has seen no kick used within KickSeenMs (bots
# from KickMemoryFromSkill remember the kicks they saw used within 40 yards); it then fakes with the chance
# ChancePctAtSkill70..99 per cent and cancels the cast at a drawn point of the bar (CancelPctAtPatience0..100 per cent
# of the cast time, log-normal spread CancelSigmaPct; never earlier than CancelMinMs into the cast and never within
# CancelMinLeftMs of its end), on the bot's first update at that instant, if the kicker still threatens it (else the
# cast finishes). The next fake is at least RepeatMsAtPatience0..100 ms later (jitter RepeatJitterPct per cent), at
# most MaxPerMinute a minute. A kick at the bot within BaitedWindowMs after the cancel counts as baited (counters
# fakes, kicksBaited, kickSeen). Nothing tells a kicker it faces a fake; its own memory of seen cancels is all it has
# (Playerbots.Tactics.Interrupt). HealGuardPct (13e-decide): a heal is never faked while its target is below this
# health, nor, by the group's only healer, while any friend is below it. Only fight casts are faked: in combat, and no
# conjure, created item, pet summon, enchant or trade skill (13e-polish).
# Playerbots.Tactics.Fake.Enable = 0
# Playerbots.Tactics.Fake.KnownFromSkill = 70
# Playerbots.Tactics.Fake.MinCastMs = 1500
# Playerbots.Tactics.Fake.CancelPctAtPatience0 = 35
# Playerbots.Tactics.Fake.CancelPctAtPatience100 = 75
# Playerbots.Tactics.Fake.CancelSigmaPct = 15
# Playerbots.Tactics.Fake.CancelMinMs = 300
# Playerbots.Tactics.Fake.CancelMinLeftMs = 250
# Playerbots.Tactics.Fake.RepeatMsAtPatience0 = 4000
# Playerbots.Tactics.Fake.RepeatMsAtPatience100 = 10000
# Playerbots.Tactics.Fake.RepeatJitterPct = 30
# Playerbots.Tactics.Fake.MaxPerMinute = 6
# Playerbots.Tactics.Fake.KickerRangeYards = 30
# Playerbots.Tactics.Fake.KickerRangeSlackYards = 3
# Playerbots.Tactics.Fake.KickerNeedFacing = 1
# Playerbots.Tactics.Fake.KickSeenMs = 8000
# Playerbots.Tactics.Fake.KickMemoryFromSkill = 40
# Playerbots.Tactics.Fake.ChancePctAtSkill70 = 40
# Playerbots.Tactics.Fake.ChancePctAtSkill99 = 90
# Playerbots.Tactics.Fake.BaitedWindowMs = 300
# Playerbots.Tactics.Fake.HealGuardPct = 70
# (Ranges: skills 0-100, percents 0-100, ms 0-120000, MaxPerMinute 0-600, yards 0-100, KickerNeedFacing 0-1.)

# Line of sight and pillar play (G2e, G2f; Playerbots.Tactics.Los.Enable, scope Arena,Battleground,World, and
# Playerbots.Tactics.Pillar.Enable, scope Arena). Los: a ranged bot that loses sight of its target, or a healer of an
# alive partner, moves to a point that sees it again instead of running into melee or not healing (cover points in
# arenas), known from KnownFromSkill; the lower the skill the later (LateMsAtSkill1..99 ms) and the more often into the
# open (IntoOpenPctAtSkill1..99); from HidesFromCasterFromSkill the point also hides the bot from the enemy caster; a
# healer below EffortMin stays put. A point is held at least HoldMs, at most MaxRelocs relocations per RelocWindowMs
# (else counter relocGuards); a cover search runs at most every SearchIntervalMs with at most MaxRaysPerSearch rays;
# the cover plan takes at most RaysPerSecond rays per bot and second; a regain not finished in TimeoutMs is a timeout.
# Pillar: a bot that an enemy casts at (a cast of HardCastMs or more, or crowd control) that no interrupt can stop steps
# behind a pillar (one hop of at most StepYards) and a melee chaser is pulled round it, from KnownFromSkill; below it
# the bot hides at random (RandomHidePctAtSkill1..59) or never; the cautious style hides CautiousEarlyMs earlier;
# Ring of Valor: no move in the first RvIdleMs (the elevators). The notice delay of these moves is the Positioning part
# of Playerbots.Natural.Reaction.*. Counters losRegains, losTimeouts, partnerLosLostMs, losBreaks, castsLosBroken,
# pillarSteps, relocGuards. Default: off.
# Playerbots.Tactics.Los.Enable = 0
# Playerbots.Tactics.Los.KnownFromSkill = 25
# Playerbots.Tactics.Los.LateMsAtSkill1 = 2500
# Playerbots.Tactics.Los.LateMsAtSkill99 = 500
# Playerbots.Tactics.Los.IntoOpenPctAtSkill1 = 25
# Playerbots.Tactics.Los.IntoOpenPctAtSkill99 = 0
# Playerbots.Tactics.Los.HidesFromCasterFromSkill = 70
# Playerbots.Tactics.Los.EffortMin = 25
# Playerbots.Tactics.Los.HoldMs = 2500
# Playerbots.Tactics.Los.MaxRelocs = 3
# Playerbots.Tactics.Los.RelocWindowMs = 10000
# Playerbots.Tactics.Los.SearchIntervalMs = 1500
# Playerbots.Tactics.Los.MaxRaysPerSearch = 40
# Playerbots.Tactics.Los.RaysPerSecond = 5
# Playerbots.Tactics.Los.TimeoutMs = 6000
# Playerbots.Tactics.Pillar.Enable = 0
# Playerbots.Tactics.Pillar.KnownFromSkill = 60
# Playerbots.Tactics.Pillar.HardCastMs = 1500
# Playerbots.Tactics.Pillar.StepYards = 6
# Playerbots.Tactics.Pillar.RandomHidePctAtSkill1 = 30
# Playerbots.Tactics.Pillar.RandomHidePctAtSkill59 = 5
# Playerbots.Tactics.Pillar.CautiousEarlyMs = 300
# Playerbots.Tactics.Pillar.RvIdleMs = 21000
# (Ranges: skills 0-99, percents 0-100, ms 0-120000, rays and relocations 0-1000, yards 0-1000.)

# Kiting, drinking and jumps (G3a, G3b, G2g; the Drink tactic works (G3b), Kite and Jump read their numbers only so far).
# Playerbots.Tactics.Kite.Enable (scope Arena,Battleground,World), Playerbots.Tactics.Drink.Enable (scope
# Arena,Battleground) and Playerbots.Tactics.Jump.Enable (scope Arena) are the tactic table's switches (default 0).
# Kite: a healer or caster with an enemy melee on it (within MeleeYards, targeting it) kites: the class snare first
# (SnareFirst), then a pillar step (PillarMaxYards), a tested jump spot (JumpMinSavedYards) or a StepYards step towards
# a partner at least PartnerMinYards away, at most every StepIntervalMs. A bot below EffortMin gives up after
# GiveUpMsAtEffort0, one at effort 100 after GiveUpMsAtEffort100; an episode ends after EpisodeMs. From
# MemoryFromSkill the bot reads where enemies broke line of sight in the last MemoryWindowMs. Below KnownFromSkill
# (PanicBelowSkill) the old flee stays.
# Drink: before the gates open (more than PrepMinLeftMs left, mana below PrepBelowPct, effort at least PrepEffortMin),
# and in a safe window (out of combat, mana below SafeBelowPct, healers SafeBelowPctHealer, no enemy within
# EnemyYards or in sight, none seen for QuietMs, the partner above PartnerMinHpPct, effort at least EffortMin); an
# enemy within BreakEnemyYards stands the bot up. A bot without drinks logs at most every NoDrinkLogMs. With the tactic
# on, a bot that knows it (KnownFromSkill) in an arena or battleground drinks only by these rules: the old food rule's
# drink (mana below HighMana, no look at enemies) is off for it there; below KnownFromSkill the old rule runs unchanged.
# Jump: only measured spots; aggression at least ChaseFromAggression jumps down to chase, caution at least
# EscapeFromCaution to escape; MinSavedYards the way a jump must save; LandingTolX10 the landing tolerance in tenths
# of a yard; Test*: the numbers of `.playerbots tactics jump test`.
# Playerbots.Tactics.Kite.KnownFromSkill = 40
# Playerbots.Tactics.Kite.EffortMin = 20
# Playerbots.Tactics.Kite.MeleeYards = 8
# Playerbots.Tactics.Kite.StepYards = 9
# Playerbots.Tactics.Kite.StepIntervalMs = 1500
# Playerbots.Tactics.Kite.EpisodeMs = 20000
# Playerbots.Tactics.Kite.GiveUpMsAtEffort0 = 3000
# Playerbots.Tactics.Kite.GiveUpMsAtEffort100 = 12000
# Playerbots.Tactics.Kite.SnareFirst = 1
# Playerbots.Tactics.Kite.PillarMaxYards = 12
# Playerbots.Tactics.Kite.PartnerMinYards = 12
# Playerbots.Tactics.Kite.JumpMinSavedYards = 6
# Playerbots.Tactics.Kite.MemoryFromSkill = 60
# Playerbots.Tactics.Kite.MemoryWindowMs = 15000
# Playerbots.Tactics.Kite.PanicBelowSkill = 40
# Playerbots.Tactics.Drink.KnownFromSkill = 45
# Playerbots.Tactics.Drink.EffortMin = 30
# Playerbots.Tactics.Drink.PrepEffortMin = 10
# Playerbots.Tactics.Drink.PrepBelowPct = 95
# Playerbots.Tactics.Drink.PrepMinLeftMs = 12000
# Playerbots.Tactics.Drink.SafeBelowPct = 60
# Playerbots.Tactics.Drink.SafeBelowPctHealer = 70
# Playerbots.Tactics.Drink.EnemyYards = 30
# Playerbots.Tactics.Drink.QuietMs = 2000
# Playerbots.Tactics.Drink.PartnerMinHpPct = 50
# Playerbots.Tactics.Drink.BreakEnemyYards = 20
# Playerbots.Tactics.Drink.NoDrinkLogMs = 60000
# Playerbots.Tactics.Jump.KnownFromSkill = 70
# Playerbots.Tactics.Jump.ChaseFromAggression = 60
# Playerbots.Tactics.Jump.EscapeFromCaution = 40
# Playerbots.Tactics.Jump.MinSavedYards = 6
# Playerbots.Tactics.Jump.LandingTolX10 = 20
# Playerbots.Tactics.Jump.TestJumps = 10
# Playerbots.Tactics.Jump.TestWalkTimeoutMs = 12000
# Playerbots.Tactics.Jump.TestAirTimeoutMs = 6000
# Playerbots.Tactics.Jump.TestSettleMs = 1500
# Playerbots.Tactics.Jump.TestMaxStuckMs = 8000

# SmartScale — automatically reduces active bots when the server is struggling.
# Monitors the server's update time (how long each server tick takes in milliseconds).
# When the server slows down, fewer bots are kept active to reduce load.
#
#   Floor (default 50ms)   - Below this, no reduction. Server is running fine.
#   Ceiling (default 200ms) - At or above this, all non-forced bots are paused.
#   Between floor and ceiling, activity scales down gradually.
#     Example: BotActiveAlone=10, floor=50, ceiling=200
#       Server at 50ms  → ~10% active (no reduction)
#       Server at 125ms → ~5% active (half reduction)
#       Server at 200ms → 0% active (only forced bots remain)
#
# MinLevel/MaxLevel — only bots within this level range are affected by SmartScale.
#   Bots outside the range always use the full BotActiveAlone value.
#   Force rules always win over SmartScale.
#
# Percentile — which tick time SmartScale follows.
#   0 (default) - the maximum of the core's recent update times (the last 500-1000 ticks), as before.
#                 One slow tick lowers the active share until it leaves the table.
#   1-100       - that percentile of the core's last 500 ticks (50 = the median, 95 = ignore the slowest 5%),
#                 computed once per world tick. Lower values react less to single slow ticks.
#   Values above 100 are used as 100.
#   Default: 0
#
Playerbots.botActiveAloneSmartScale = 1
Playerbots.botActiveAloneSmartScaleDiffLimitfloor = 50
Playerbots.botActiveAloneSmartScaleDiffLimitCeiling = 200
Playerbots.botActiveAloneSmartScaleWhenMinLevel = 1
Playerbots.botActiveAloneSmartScaleWhenMaxLevel = 80
Playerbots.botActiveAloneSmartScalePercentile = 0

# Situation budgets — smart scale's floor and ceiling follow what the real players online are doing.
#   About once per IntervalMs the server classifies every real player (the headless test player included) as
#   PvP (arena, battleground, duel or PvP combat), boss (an instance encounter in progress), dungeon (or raid)
#   or open world. The strictest situation present (PvP > boss > dungeon > open world) selects the floor and
#   ceiling smart scale uses; with nobody online the global values above apply.
#   World bosses and Wintergrasp outside a fight count as open world.
#   Needs Playerbots.botActiveAloneSmartScale = 1.
#
#   Enable           - 0 (default): the global floor and ceiling always apply, as before.
#   IntervalMs       - how often the players are classified (100-60000). Default: 1000
#   Force            - empty (default) = detect; pvp, boss, dungeon or open pins that situation (for tests).
#                      The console command ".playerbots situation force <pvp|boss|dungeon|open|off>" overrides it
#                      until the restart; ".playerbots situation status" shows the situation and the values.
#   <Situation>.DiffLimitFloor / .DiffLimitCeiling (Pvp, Boss, Dungeon, OpenWorld)
#                    - the floor and ceiling (ms) in that situation; 0 (default) = the global value.
#
Playerbots.Situation.Enable = 0
Playerbots.Situation.IntervalMs = 1000
Playerbots.Situation.Force =
Playerbots.Situation.Pvp.DiffLimitFloor = 0
Playerbots.Situation.Pvp.DiffLimitCeiling = 0
Playerbots.Situation.Boss.DiffLimitFloor = 0
Playerbots.Situation.Boss.DiffLimitCeiling = 0
Playerbots.Situation.Dungeon.DiffLimitFloor = 0
Playerbots.Situation.Dungeon.DiffLimitCeiling = 0
Playerbots.Situation.OpenWorld.DiffLimitFloor = 0
Playerbots.Situation.OpenWorld.DiffLimitCeiling = 0

