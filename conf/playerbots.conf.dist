Playerbots.RandomBotNonCombatStrategies = ""

# Additional altbot strategies
# Strategies added here are applied to all altbots, in addition (or subtraction) to spec/role-based default strategies.
# These rules are processed after the defaults.
Playerbots.CombatStrategies = ""
Playerbots.NonCombatStrategies = ""

# Reaction engine strategy overrides.
# Strategy modifiers applied to the reaction engine after the defaults.
# Defaults are: "react", "chat".
# ReactStrategies applies to bots with a real player master or that are real players themselves.
# RandomBotReactStrategies applies to all other bots (random bots without a real player master).
# Example: "-chat" stops chat commands being handled as reactions; "+custom_react" adds a custom reaction strategy.
Playerbots.ReactStrategies = ""
Playerbots.RandomBotReactStrategies = ""

