###################################
#                                 #
# GENERAL SETTINGS                #
#                                 #
###################################

####################################################################################################

# Enable or disable Playerbots module
Playerbots.Enabled = 1

# Enable randombot system
Playerbots.RandomBotAutologin = 1

# Randombot count
Playerbots.MinRandomBots = 500
Playerbots.MaxRandomBots = 500

# Randombot accounts
# Set to 0 to automatically calculate needed accounts based on MaxRandomBots and AddClassAccountPoolSize.
# Set manually if you want to create more accounts than needed.
# If the manual value is less than the required, the system will override it with the required value.
# Default: 0 (automatic)
Playerbots.RandomBotAccountCount = 0

# Addclass accounts
# Number of accounts created for bots reserved for the addclass command. As with randombots, each account has
# 10 bots (or 9 if WotLK is disabled), one bot for each class.
Playerbots.AddClassAccountPoolSize = 50

# Prefix for created bot accounts (of any type).
# Do not change this prefix while there are existing bot accounts.
Playerbots.RandomBotAccountPrefix = "rndbot"

# Test names for new random bots. Empty (default): names come from the name pool (playerbots_names). Otherwise every
# new random bot is named this prefix plus a letters-only counter (Testa, Testb, ..., Testaa, Testab, ...), so test
# bots never use up pool names. Letters only: the core's name check rejects digits (a character with an invalid name
# is flagged for a rename). 2-9 letters; names that fail the core's check (three equal letters in a row, reserved,
# profane) or that a character already has are skipped. Applies to characters created from now on, nothing is renamed.
Playerbots.RandomBotTestNamePrefix = ""

# Delete all randombot accounts
# To apply this, set the number to 1 and run the Worldserver. Once deletion is complete, if you would
# like to recreate randombots, set the number back to 0 and rerun the Worldserver.
Playerbots.DeleteRandomBotAccounts = 0

# Disable randombots when no real players are logged in
# Default: 0 (randombots will login when server starts)
# If enabled, randombots will only log in 30 seconds (default) after a real player logs in, and will
# log out 300 seconds (default) after all real players log out
Playerbots.DisabledWithoutRealPlayer = 0
Playerbots.DisabledWithoutRealPlayerLoginDelay = 30
Playerbots.DisabledWithoutRealPlayerLogoutDelay = 300

# Online randombots count change
#   0 = Static:     Fixed random count rolled once at server start, between Min/MaxRandomBots.
#   1 = Variable:   Fluctuating random count rolled at server start, between Min/MaxRandomBots.
#                   Re-rolled again at a time between RandomBotCountChangeMin/MaxInterval.
#   2 = Scheduled:  Fluctuating time-cycled count, ranging from MinRandomBots at RandomBotCountMinTime,
#                   to MaxRandomBots at RandomBotCountMaxTime.
#                   When RandomBotCountMinTime = RandomBotCountMaxTime the count stays at MaxRandomBots.
# When MinRandomBots = MaxRandomBots the count is constant and all modes behave identically.
# Default: 0 (static)
Playerbots.RandomBotCountMode = 0

####################################################################################################

###################################
#                                 #
# PLAYERBOTS SETTINGS             #
#                                 #
###################################

####################################################################################################

####################################################################################################
# GENERAL
#

# The maximum number of bots that a player can control simultaneously
Playerbots.MaxAddedBots = 40

# Enable/Disable creating bots by addclass command (0 = GM only, 1 = enabled)
# Default: 1 (enabled)
Playerbots.AddClassCommand = 1

# Pick a random eligible character each time the addclass command adds a bot of a given class.
# When disabled, addclass keeps adding the same character for a class as long as it is available,
# so a bot geared with init or tweak comes back on the next call.
# Default: 0 (always the same character)
Playerbots.AddClassRandomCharacter = 0

# Bot group invitation permission level (0 = GM only, 1 = accept based on level, 2 = always accept)
# Default: 1 (accept based on level)
Playerbots.GroupInvitationPermission = 1

# Keep altbots in the party even when the master leaves
# 0 = disabled (default behavior)
# 1 = enabled (prevents bots from automatically leaving the group)
Playerbots.KeepAltsInGroup = 0

# Auto-login all player alts as altbots on player login
Playerbots.BotAutologin = 0

# Allow/deny inviting altbots from the player's account
Playerbots.AllowAccountBots = 1

# Allow/deny inviting altbots in the player's guild
Playerbots.AllowGuildBots = 1

# Allow linking accounts for shared altbot control
Playerbots.AllowTrustedAccountBots = 1

# Randombots will create guilds with nearby randombots
# Note: currently, randombots will not invite more bots after a guild is created,
# meaning randombot guilds will have only the 10 initial randombots needed to sign the charter
# Default: 0 (disabled)
Playerbots.RandomBotGuildNearby = 0

# Number of guilds created by randombots
Playerbots.RandomBotGuildCount = 20

# Maximum number of members in randombot guilds (minimum is hardcoded to 10)
Playerbots.RandomBotGuildSizeMax = 15

# Delete all randombot (and any addclass bot) guilds on startup. While enabled,
# no new randombot guilds are created or joined. Set back to 0 and restart the
# server to resume normal random bot guild assignment.
Playerbots.DeleteRandomBotGuilds = 0

# Randombots will invite players to groups/raids/guilds
Playerbots.RandomBotInvitePlayer = 0

# Bots will chat in say/guild when they invite other bots to groups/raids/guilds
Playerbots.InviteChat = 0

# Bots will be automatically summoned to the player when they accept a group invitation
Playerbots.SummonWhenGroup = 1

# Player can be activated as a bot (selfbot)
# Selfbot permission level (0 = disabled, 1 = GM only (default), 2 = all players, 3 = activate on login)
Playerbots.SelfBotLevel = 1

# Non-GM player can only use init=auto to initialize bots based on their own level and gearscore
# Default: 0 (non-GM player can use any intialization commands)
Playerbots.AutoInitOnly = 0

# Allow .bot refresh=raid to unbind instances on player-created alt
# bots (non-addclass bots). When 0, refresh=raid is denied on alts
# with "non-addclass bot" error. UnbindInstance is DB-light, no lag
# risk from enabling this.
# Default: 0
Playerbots.ResetInstanceIdForAltBots = 0

# The upper limit ratio of bot equipment level for init=auto
# Default: 1.0 (same with the player)
Playerbots.AutoInitEquipLevelLimitRatio = 1.0

# AllowLearnTrainerSpells
# Description: Allow the bot to learn trainers' spells as long as it has the money.
# Default: 1 - (enabled)
Playerbots.AllowLearnTrainerSpells = 1

#
#
####################################################################################################

####################################################################################################
# SUMMON OPTIONS
#

# Enable/Disable summoning bots when the master is in combat
# Default: 1 (enabled)
Playerbots.AllowSummonInCombat = 1

# Enable/Disable summoning bots when the master is dead
# Default: 1 (enabled)
Playerbots.AllowSummonWhenMasterIsDead = 1

# Enable/Disable summoning bots when they are dead (0 = only when the bots are ghosts, 1 = always)
# Default: 1 (always)
Playerbots.AllowSummonWhenBotIsDead = 1

# Enable/Disable reviving bots when summoning them (0 = disabled, 1 = disabled in combat, 2 = enabled)
# Default: 1 (disabled in combat)
Playerbots.ReviveBotWhenSummoned = 1

# Enable/Disable bots repairing gear when summoned
# Default: 1 (enabled)
Playerbots.BotRepairWhenSummon = 1

#
#
####################################################################################################

####################################################################################################
# MOUNT
#

# Defines at what level a bot will naturally use its 60% ground mount
# Note: was level 20 during WotLK, 30 during TBC, 40 during Vanilla
# Default: 20
Playerbots.UseGroundMountAtMinLevel = 20

# Defines at what level a bot will naturally use its 100% fast ground mount
# Note: was level 40 during WotLK, 60 during Vanilla
# Default: 40
Playerbots.UseFastGroundMountAtMinLevel = 40

# Defines at what level a bot will naturally use its 150% flying mount
# Note: was level 60 during WotLK, 70 during TBC
# Default: 60
Playerbots.UseFlyMountAtMinLevel = 60

# Defines at what level a bot will naturally use its 280% fast flying mount
# Note: was level 70 during WotLK and TBC
# Default: 70
Playerbots.UseFastFlyMountAtMinLevel = 70

#
#
####################################################################################################

####################################################################################################
# GEAR
#

# Show helmet and cloak on randombots (reset required)
# 0 - Helmet or cloak will be visually hidden on all randombots
# 1 - Helmet or cloak will be visually visible on all randombots
# 2 - Helmet or cloak visibility is random when a randombot is randomized
# Default: 1 (helm/cloak visible on all randombots)
Playerbots.RandomBotShowHelmet = 1
Playerbots.RandomBotShowCloak = 1

# Toggles whether altbots will automatically equip items in their inventory that are sufficient upgrades
# Default: 1 (enabled)
Playerbots.AutoEquipUpgradeLoot = 1

# Threshold for auto equipping upgrades
# Default: 1.1 (Equip when the equipment score of the new item is 1.1 times higher than the currently equipped item)
Playerbots.EquipUpgradeThreshold = 1.1

# Two rounds of equipment initialization to create more suitable gear
Playerbots.TwoRoundsGearInit = 0

#
#
####################################################################################################

####################################################################################################
# LOOTING
#

# Bots keep looting when loot system is set to free for all
# Default: 0 (disabled)
Playerbots.FreeMethodLoot = 0

# Bots' Roll level bots will use for items they Need (0 = pass, 1 = greed, 2 = need)
# Default: 1 (greed)
Playerbots.LootNeedRollLevel = 1

# Enable bots to roll GREED on items (global toggle)
# If disabled, bots will PASS instead of GREED on all items
# Default: 0 (disabled - bots only NEED or PASS)
Playerbots.LootGreedRollLevel = 0

# Enable bots to roll on recipes. Will NEED on learnable profession recipes they don't already know
# Bots will roll GREED on BoE recipes they can't learn if LootRollGreed is enabled.
# Default: 0 (disabled)
Playerbots.LootRollRecipe = 0

# Bots with enchanting will roll DISENCHANT instead of GREED on disenchantable items
# If disabled, bots will GREED on disenchantable items instead
# Default: 0 (disabled)
Playerbots.LootRollDisenchant = 0

# A list of gameobject entries that bots will not interact with.
# Default: Half-Buried Bottle 2560, Waterlogged Envelope 2656, Solid Chest 2857, Water Barrel 3658,
#          Barrel of Milk 3705, Barrel of Sweet Nectar 3706, Food Crate 3719, Defias Gunpowder 17155,
#          Box of Assorted Parts 19020, Large Solid Chest 74448, Large Battered Chest 75293, Tattered Chest 105579,
#          Baelog's Chest 123329, Shallow Grave 128308, Shallow Grave 128403, Witch Doctor's Chest 141596,
#          Relic Coffer 160836, Dark Coffer 160845, Dark Iron Ale Mug 165738, Grim Guzzler Boar 165739,
#          Father Flame 175245, Unforged Runic Breastplate 175970, Malor's Strongbox 176112, Blood of Heroes 176213,
#          Supply Crate 176224, Blacksmithing Plans 176325, Blacksmithing Plans 176327, Battered Foodlocker 179490,
#          Fengus's Chest 179516, Apple Bob 180523, Supply Crate 181085
Playerbots.DisallowedGameObjects = 2560,2656,2857,3658,3705,3706,3719,17155,19020,74448,75293,105579,123329,128308,128403,141596,160836,160845,165738,165739,175245,175970,176112,176213,176224,176325,176327,179490,179516,180523,181085

