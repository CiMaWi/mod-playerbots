#
#
####################################################################################################

####################################################################################################
# TELEPORTS
#

# Map IDs where bots can be teleported to
# Defaults: 0 = Eastern Kingdoms, 1 = Kalimdor, 530 = Outland, 571 = Northrend
Playerbots.RandomBotMaps = 0,1,530,571

# When an idle bot picks a random destination it makes ONE weighted roll across three classes,
# so each value is an exact share of the roll (peers, not nested gates):
#     quest giver   : ProbTeleToQuestGivers
#     city/banker   : ProbTeleToBankers (level >= 10 only; falls through below level 10)
#     innkeeper/hub : 1 - ProbTeleToQuestGivers - ProbTeleToBankers (the remainder)
# A branch that cannot produce a destination (no currently-valid quest giver, below level 10, or
# an empty city cache) falls through to the innkeeper/hub path, which absorbs the unused share.

# Probability bots teleport to banker (city)
# Default: 0.25
Playerbots.ProbTeleToBankers = 0.25

# Probability an idle random bot's random move targets a quest giver it can accept a quest from
# right now (level/faction valid, no unmet prereq, not in progress, quest-log + item room).
# Falls through to the innkeeper/hub path when no valid giver exists. With
# RandomBotConcentrateInPlayerZone, only givers in a player zone are used.
# Default: 0 (off; set above 0 to enable quest-giver teleports)
Playerbots.ProbTeleToQuestGivers = 0

# Control probability weights for bots teleporting to Capital city bankers
# Sum of weights need not be 100. Set to 0 to disable teleporting to the city.
Playerbots.EnableWeightTeleToCityBankers = 1
Playerbots.TeleToStormwindWeight = 2
Playerbots.TeleToIronforgeWeight = 1
Playerbots.TeleToDarnassusWeight = 1
Playerbots.TeleToExodarWeight = 1
Playerbots.TeleToOrgrimmarWeight = 2
Playerbots.TeleToUndercityWeight = 1
Playerbots.TeleToThunderBluffWeight = 1
Playerbots.TeleToSilvermoonCityWeight = 1
Playerbots.TeleToShattrathCityWeight = 1
Playerbots.TeleToDalaranWeight = 1

# How far randombots are teleported after death in yards
Playerbots.RandomBotTeleportDistance = 100

# How many levels below the lowest-level creature in a zone, can a bot be
# This will have no effect if Playerbots.EnableNewRpgStrategy is enabled
# Default: 1 (randombot will leave if they are more than 1 level lower)
Playerbots.RandomBotTeleLowerLevel = 1

# How many levels above the highest-level creature in a zone, can a bot be
# This will have no effect if Playerbots.EnableNewRpgStrategy is enabled
# Default: 3 (randombot will leave if they are more than 3 levels higher)
Playerbots.RandomBotTeleHigherLevel = 3

# Bots automatically teleport to another place for leveling on levelup
# No effect with Playerbots.Population.Persistent = 1 (not ArenaOnly): persistent bots change zones by travelling
# (the planner's move_zone goal), and the periodic hub/city refresh teleports are off for them too. Only a newly
# made bot's first placement (".playerbots population resize") is still a teleport.
# Default: 1 (enabled)
Playerbots.AutoTeleportForLevel = 1

#
#
####################################################################################################

####################################################################################################
# BATTLEGROUNDS & ARENAS & PVP
#

# Enable battlegrounds/arenas for randombots
Playerbots.RandomBotJoinBG = 1

# Allow players to command random bots with no player master on their own team in the same battleground or arena.
# Every such player gets the command access of a master without becoming the bot's master,
# so the bot keeps playing the battleground.
# Default: 0 (disabled)
Playerbots.AllowBattlegroundCommands = 0

# Enable auto-joining of battlegrounds - have bots start battlegrounds and arenas on their own
Playerbots.RandomBotAutoJoinBG = 0

# Required Configuration for RandomBotAutoJoinBG
#
# Known issue: When enabling many brackets in combination with multiple instances, it can lead to more
# instances created by bots than intended (over-queuing).
#
# This section controls the level brackets and automatic bot participation in battlegrounds and arenas.
#
# Brackets:
# - Specify the level ranges for bots to auto-join (bracket IDs are per-BG and start at 0 from each BG's minimum level):
#   - Warsong Gulch    (WS): 0=10-19, 1=20-29, 2=30-39, 3=40-49, 4=50-59, 5=60-69, 6=70-79, 7=80    (Default: 7)
#   - Arathi Basin     (AB): 0=20-29, 1=30-39, 2=40-49, 3=50-59, 4=60-69, 5=70-79, 6=80             (Default: 6)
#   - Alterac Valley   (AV): 0=51-60, 1=61-70, 2=71-79, 3=80                                        (Default: 3)
#   - Eye of the Storm (EY): 0=61-69, 1=70-79, 2=80                                                 (Default: 2)
#   - Isle of Conquest (IC): 0=71-79, 1=80                                                          (Default: 1)
# - Multiple BG brackets can be specified as a comma-separated list (e.g., "0,2,5"). Not applicable for Rated Arena.
#   - Rated Arena:           0=10-14, 1=15-19, 2=20-24, ..., 13=75-79, 14=80-84                     (Default: 14)
#
# Counts:
# - Specify the number of battles to auto-fill per bracket.
# - For battlegrounds, 'Count" is the number of battles per bracket. For example:
#   - RandomBotAutoJoinWSBrackets = 6,7
#   - RandomBotAutoJoinBGWSCount = 1
#   - These configs would create two battles, one for bracket 6 and one for bracket 7.
# - Ensure there are enough eligible bots to meet the specified counts.

# Battleground bracket range possibilities:
# Playerbots.RandomBotAutoJoinWSBrackets = 0,1,2,3,4,5,6,7
# Playerbots.RandomBotAutoJoinABBrackets = 0,1,2,3,4,5,6
# Playerbots.RandomBotAutoJoinAVBrackets = 0,1,2,3
# Playerbots.RandomBotAutoJoinEYBrackets = 0,1,2
# Playerbots.RandomBotAutoJoinICBrackets = 0,1
Playerbots.RandomBotAutoJoinWSBrackets = 7
Playerbots.RandomBotAutoJoinABBrackets = 6
Playerbots.RandomBotAutoJoinAVBrackets = 3
Playerbots.RandomBotAutoJoinEYBrackets = 2
Playerbots.RandomBotAutoJoinICBrackets = 1

# Battlegrounds battles count (per bracket):
Playerbots.RandomBotAutoJoinBGWSCount = 1
Playerbots.RandomBotAutoJoinBGABCount = 1
Playerbots.RandomBotAutoJoinBGAVCount = 0
Playerbots.RandomBotAutoJoinBGEYCount = 1
Playerbots.RandomBotAutoJoinBGICCount = 0

# Arena bracket (single bracket only):
# Custom code changes are required for lower-level arena brackets to function properly.
Playerbots.RandomBotAutoJoinArenaBracket = 14

# Arena battles count:
Playerbots.RandomBotAutoJoinBGRatedArena2v2Count = 0
Playerbots.RandomBotAutoJoinBGRatedArena3v3Count = 0
Playerbots.RandomBotAutoJoinBGRatedArena5v5Count = 0

# Rated arena queue slots: how many matches' worth of bot arena captains may join a rated arena queue (per arena type)
# between two checks of the bot manager (every 35 s), never more than the arena battles count above still allows.
# With 1 at most one rated match forms per check, so the count is reached slowly and few matches run at once; raise it
# (e.g. to the arena battles count) when many bot teams should play at the same time.
# Default: 1 (one match at a time)
Playerbots.RandomBotAutoJoinRatedArenaQueueSlots = 1

# Uncapped rated arena queue, for lab and arena servers (forced off with Playerbots.Ladder.Role = 1). When 1, every
# bot team that is free queues for its rated arena as soon as its captain checks (no queue slots, no arena battles
# count limit; a count above 0 still turns the arena type on). The core's queue pairs teams by rating
# (Arena.MaxRatingDifference), so a team may wait in the queue for a close match; no team idles outside it.
# Default: 0 (the slots and the count above apply)
Playerbots.RandomBotAutoJoinRatedArenaUncapped = 0

# Arena only, for lab and arena servers (forced off with Playerbots.Ladder.Role = 1). When 1, a random bot outside a
# battleground or arena only waits for its next match: its non-combat strategies are reduced to the packet handlers,
# chat commands and the battleground join ("default", "chat", "bg"), so no RPG, questing, grinding, looting, trading,
# vendoring, mail, auction, buffs, food, gear or talent changes; the random bot manager does no randomize, refresh or
# level teleport for it (a bot below Playerbots.RandomBotMinLevel, i.e. a new character, still gets its first
# randomize). Its combat and dead strategies are reduced to "default" and "chat" too (it does not fight, release
# its spirit or run to a corpse outside a match); a bot that dies there is revived where it stands. Its captain
# checks for the next queue every Playerbots.RepeatDelay instead of at random, an invited bot accepts at once (the
# invite trigger runs on every AI pass), and every change of its money is logged ("ARENAONLY money:"). In matches
# nothing changes. PvP gear buying (Playerbots.PvpGear.Buy.Enable) is
# separate. With SpreadContinents 1 (default) each waiting bot stands at one of three safe spots of its faction on
# its team's home
# continent (team id % 4: Eastern Kingdoms, Kalimdor, Outland, Northrend; a bot without a team: guid % 4), moved there
# when it logs in or comes back from a match, so no single continent map carries every waiting bot.
# .playerbots arenaonly status counts the bots in a match, queued and neither, per continent; .playerbots arenaonly
# selftest checks the continent split, the queue rule and the rating seed.
# Default: 0 (off)
Playerbots.ArenaOnly.Enable = 0
Playerbots.ArenaOnly.SpreadContinents = 1

# Form a bot arena captain's group and teleport its team members on the world thread (a queued operation) instead of
# inline on the captain's map thread; the captain joins the rated queue on a later pass, once its group stands.
# Recommended with MapUpdate.Threads > 1, where two map threads may otherwise change the same groups.
# Default: 0 (disabled, the group is formed inline)
Playerbots.RandomBotArenaGroupOnWorldThread = 0

# Randombot arena team count
# Teams are created when bots are initialized on server restart.
# You may need to first delete all arena teams, then reinitialize bots.
# Warning: Reinitializing bots completely resets them (command in game: .playerbots rndbot init)
# Bots only join one arena team to avoid queueing issues. Take that into account when increasing count.
# Default: 2v2: 10 (20 Bots), 3v3: 10 (30 bots), 5v5: 5 (25 bots)
Playerbots.RandomBotArenaTeam2v2Count = 10
Playerbots.RandomBotArenaTeam3v3Count = 10
Playerbots.RandomBotArenaTeam5v5Count = 5

# Arena rating is randomized on team creation.
# Default: Max: 2000, Min: 1000
Playerbots.RandomBotArenaTeamMaxRating = 2000
Playerbots.RandomBotArenaTeamMinRating = 1000

# How the rating of randombot arena teams is set.
#    0 = random: a new team gets a random rating between Min and Max above, and its members' matchmaking rating (MMR)
#        follows it once the team is full (default)
#    1 = earned: a new team keeps the core's start values (Arena.ArenaStartRating, Arena.ArenaStartMatchmakerRating)
#        and climbs by winning rated matches. Min and Max are ignored.
# Teams that already exist keep their ratings when the mode changes. To set all of them to the start values once, run
# the GM command: .playerbots arena resetratings (works from the console)
# Default: 0
Playerbots.RandomBotArenaTeamRatingMode = 0

# Seeded bot team ratings, for test servers (forced off with Playerbots.Ladder.Role = 1). When 1, a bot arena team that
# has just been completed and has never played gets rating = 1500 + Spread * (mean skill percentile of its members
# - 0.5) + a normal noise term with standard deviation NoiseSd, clamped to 0-4000; its members' personal and
# matchmaking ratings follow. The ladder then starts near settled (close matches dominate) while the noise still gives
# a range of skill differences. Works in both rating modes and replaces mode 0's random rating for these teams.
# Default: 0 (off), Spread 800, NoiseSd 100
Playerbots.ArenaTeam.Seed.Enable = 0
Playerbots.ArenaTeam.Seed.Spread = 800
Playerbots.ArenaTeam.Seed.NoiseSd = 100

# Arena team formation (1 = on, 0 = off; only with RandomBotArenaTeamRatingMode = 1, ignored in mode 0)
# When 1, randombot arena teams are formed by partner score instead of at random, and their rosters change over time.
# A score from skill closeness (the hidden skill, Playerbots.Skill.Enable; unknown skill counts as neutral) and class
# synergy (a healer beside damage dealers, tank and healer, no class twice) decides which team a bot joins. A roster may
# hold more members than the team size (up to MaxRoster); every queue takes a random set of the available members
# (the captain is always in: only the captain queues). After a lost match the member with the longest current loss
# streak (then the most losses since joining; skill plays no part) may leave; a leaving captain hands the team over
# first. A bot never joins the team it left last again (remembered in memory until it leaves another team; a restart
# forgets it). Teams short of members recruit online randombots without a team (same faction and arena bracket), the
# teams below MinMembers first. Without Playerbots.Skill.Enable every skill is unknown: no skill closeness and no skill
# tolerance, the score is class synergy only. Teams low on the bot ladder are forgiving (rare leaves, a wide skill tolerance, weighted-random picks: more varied pairings),
# teams at the top strict (frequent leaves, a narrow tolerance, the best-scoring recruit). The values in between follow
# the team's rating rank among the bot teams of its type. Every membership change runs on the world thread every
# UpdateSeconds; loss streaks are kept in memory only (a restart starts them at 0). The starting values below are not
# tuned yet. GM command: .playerbots arena teams (works from the console) lists every bot team and its roster.
#   UpdateSeconds (5..3600): the pass interval.
#   MaxRoster2v2 (2..4), MaxRoster3v3 (3..6), MaxRoster5v5 (5..10): the most members a team holds.
#   MinMembers (2..10, never below the team size): fewer members recruit; a team at this size loses no member.
#   RandomPair (1/0): the queuing members are a random set of the roster, else the roster order (as before).
#   RepickEachQueue (1/0): with RandomPair, a roster larger than the team size re-forms its group with a fresh random
#     set after every match (with RandomBotArenaGroupOnWorldThread = 1), else the standing group stays.
#   LossStreakToConsider (1..50): the loss streak from which a member may leave.
#   LeaveChanceBottom, LeaveChanceTop (0..100 percent): the chance per lost match at the bottom and the top.
#   MinTeamStaySeconds (0..86400): no member leaves a team within this time after its last join or leave.
#   ToleranceBottom, ToleranceTop (1..98 skill points): the largest skill gap to the team's mean a recruit may have.
#   SynergyWeight (0.0..1.0): the share of class synergy in the score (the rest is skill closeness).
#   RecruitsPerPass (0..100): the most recruits per pass, over all teams.
#   RecruitAboveMinChance (0..100 percent): the chance per pass that a team between MinMembers and its max roster takes
#     one more member (not within MinTeamStaySeconds of its last change). 0 = only teams below MinMembers recruit, so
#     after the login fill the rosters only shrink; above 0 members keep leaving and joining.
#
Playerbots.ArenaTeam.Formation.Enable = 0
Playerbots.ArenaTeam.UpdateSeconds = 60
Playerbots.ArenaTeam.MaxRoster2v2 = 4
Playerbots.ArenaTeam.MaxRoster3v3 = 6
Playerbots.ArenaTeam.MaxRoster5v5 = 10
Playerbots.ArenaTeam.MinMembers = 2
Playerbots.ArenaTeam.RandomPair = 1
Playerbots.ArenaTeam.RepickEachQueue = 1
Playerbots.ArenaTeam.LossStreakToConsider = 3
Playerbots.ArenaTeam.LeaveChanceBottom = 20
Playerbots.ArenaTeam.LeaveChanceTop = 50
Playerbots.ArenaTeam.MinTeamStaySeconds = 600
Playerbots.ArenaTeam.ToleranceBottom = 40
Playerbots.ArenaTeam.ToleranceTop = 8
Playerbots.ArenaTeam.SynergyWeight = 0.4
Playerbots.ArenaTeam.RecruitsPerPass = 4
Playerbots.ArenaTeam.RecruitAboveMinChance = 0

# Comp learning (needs Formation.Enable): the partner score above also learns which comps win, from the hub's
# comp-strength.json (tools/comp-strength.js: wins per comp and team-rating band from the ladder's match records). A
# candidate's learned value for a team is the mean, over the playing groups it may form with the other members, of the
# group comp's shrunk win rate in the team's rating band (or the nearest band with games) plus an exploration bonus
# that is large for comps with few games (an upper confidence bound). The score becomes fit * (1 - weight) + learned *
# weight, and the recruit is picked by a softmax over the scores. Weight, exploration and softmax temperature follow the
# team's rating rank among the bot teams of its type: the bottom explores varied comps (low weight, high exploration,
# a warm pick), the top leans on strong comps with some variance (high weight, a cold pick that is never certain). A
# member's comp entry is "class/spec" as the match records name it, from the online bot, else the last one seen, else
# the class alone (pooling every spec of it). A team without a learned term (no rating band with games, a roster too
# small for a playing group) scores and picks as with the option off. The table is read when the option is first seen
# on (startup or a config reload), again within 5 minutes after the file changes (the farm's daily refresh) and by the
# console command below; a missing, broken or oversized (above 16 MB) file keeps learning off (or the previous table);
# rows with numbers out of range are skipped and counted in the load line. 0 = the formation scores and picks exactly
# as before. GM command (works from the console):
# .playerbots arena comps [reload | selftest | teams]: the table, comp diversity per band, reload, the pure selftest,
# every team's playing-group comps. Formation joins log the learned value and the groups' wins/games.
#   Enable (1/0): learn comps.
#   File: the table; empty = comp-strength.json in the configs folder (configs/, beside worldserver.conf); a relative
#     path is relative to that folder.
#   WeightBottom, WeightTop (0.0..1.0): the share of the learned value in the score at the bottom and the top.
#   ExploreBottom, ExploreTop (0.0..2.0): the exploration factor (bonus = factor * sqrt(ln(band games + 1) / (comp
#     games + 1))).
#   TemperatureBottom, TemperatureTop (0.01..10.0): the softmax temperature of the recruit pick.
#
Playerbots.ArenaTeam.CompLearning.Enable = 0
Playerbots.ArenaTeam.CompLearning.File = ""
Playerbots.ArenaTeam.CompLearning.WeightBottom = 0.2
Playerbots.ArenaTeam.CompLearning.WeightTop = 0.5
Playerbots.ArenaTeam.CompLearning.ExploreBottom = 0.3
Playerbots.ArenaTeam.CompLearning.ExploreTop = 0.05
Playerbots.ArenaTeam.CompLearning.TemperatureBottom = 0.25
Playerbots.ArenaTeam.CompLearning.TemperatureTop = 0.05

# Scouting: a real player's arena team invite to a randombot goes through a hidden rule instead of being accepted
# always. The bot accepts only if it is not loyal to a winning team AND the inviting team's rating is near what the bot
# considers its own level, which comes from its hidden skill (a bot without a skill, e.g. with Playerbots.Skill.Enable
# = 0, counts as the population mean 50, so the rule still applies). The acquaintance score
# (Playerbots.Acquaintance.Enable) widens the allowed rating gap but never replaces the test: a big gap always refuses.
# Otherwise the bot refuses in character (texts arena_team_recruit_*, translatable; never a number, never the skill).
# Invites from other bots keep today's behaviour. 0 = every invite is accepted as before.
# The starting values below are not tuned yet (E4).
#   RatingAtSkill1, RatingAtSkill99 (0..10000): the team rating a bot of skill 1 / 99 considers its own level (linear).
#   DeltaBase (0..10000): the rating gap every bot allows. DeltaPerAcquaintancePoint (0.0..1000.0): extra gap per
#     acquaintance score point. DeltaMax (0..10000): the most gap that is ever allowed.
#   LoyaltyMinGames (1..1000), LoyaltyMinWinPercent (0..100): a bot whose team has played at least this many games this
#     season and won at least this share of them is loyal and refuses, whatever the acquaintance.
# GM command (console works): .playerbots arena recruit <bot> <player> [rating <n>] [score <n>] [skill <n>] [loyal 0|1]
# evaluates the rule without an invite (and shows the skill; decisions are logged at debug level, Logger.playerbots=5).
Playerbots.ArenaRecruit.Enable = 0
Playerbots.ArenaRecruit.RatingAtSkill1 = 0
Playerbots.ArenaRecruit.RatingAtSkill99 = 2000
Playerbots.ArenaRecruit.DeltaBase = 300
Playerbots.ArenaRecruit.DeltaPerAcquaintancePoint = 4.0
Playerbots.ArenaRecruit.DeltaMax = 1500
Playerbots.ArenaRecruit.LoyaltyMinGames = 5
Playerbots.ArenaRecruit.LoyaltyMinWinPercent = 55

# Delete all randombot (and any addclass bot) arena teams on startup. While enabled,
# no new randombot arena teams are created or joined. Set back to 0 and restart the
# server to resume normal randombot arena team assignment.
Playerbots.DeleteRandomBotArenaTeams = 0

# PvP Restricted Zones (bots will not initiate PvP or defend themselves if attacked)
Playerbots.PvpProhibitedZoneIds = "2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323,4395,3703,4298,3951"

# PvP Restricted Areas (bots will not initiate PvP or defend themselves if attacked)
Playerbots.PvpProhibitedAreaIds = "976,35,392,2268,4161,4010,4317,4312,3649,3887,3958,3724,4080,3938,3754,3786,3973,4085,4086,4087,4088,251"

# Improve reaction speeds in battlegrounds and arenas (may cause lag)
Playerbots.FastReactInBG = 1

#
#
####################################################################################################

####################################################################################################
# RANDOMBOT TIMING AND BEHAVIOR
#

# How often (in seconds) the randombot manager runs its main update loop
# Default: 20
Playerbots.RandomBotUpdateInterval = 20

# Minimum and maximum seconds before the randombot population count changes, when RandomBotCountMode = 1 or 2.
# Bot count changes randomly at some random time between min and max interval value, when RandomBotCountMode = 1.
# Bot count changes incrementally according to schedule, at every min interval value, when RandomBotCountMode = 2.
# Defaults: 1800 (min), 7200 (max)
Playerbots.RandomBotCountChangeMinInterval = 1800
Playerbots.RandomBotCountChangeMaxInterval = 7200

# Local server time of day when randombot population count is at minimum or maximum, when RandomBotCountMode = 2.
# Range: Integer values from 0 to 23
# Defaults: 5 (min), 20 (max)
Playerbots.RandomBotCountMinTime = 5
Playerbots.RandomBotCountMaxTime = 20

# Some aspects of randombots are periodically randomized while they are logged in and idle,
# including their inventories and, if EquipAndSpecPersistence is disabled, their equipment and specs.
# This config sets the minimum and maximum seconds between such randomization events.
# Defaults: 7200 (min - 2 hours), 1209600 (max - 14 days)
Playerbots.MinRandomBotRandomizeTime = 7200
Playerbots.MaxRandomBotRandomizeTime = 1209600

# Number of bots processed (login, logout, update) per manager update cycle
# Default: 60
Playerbots.RandomBotsPerInterval = 60

# Interval (in seconds) between periodic random bot statistics dumps in the log
# (online count, level/race/class distribution, roles, status). Set to 0 to disable.
# Default: 300
Playerbots.RandomBotPrintStatsInterval = 300

# Minimum and maximum seconds after death before a bot revives
# Defaults: 60 (min), 300 (max)
Playerbots.MinRandomBotReviveTime = 60
Playerbots.MaxRandomBotReviveTime = 300

# Minimum and maximum seconds between bot teleports to new areas or zones
# Persistent bots (Playerbots.Population.Persistent = 1, not ArenaOnly) no longer teleport on this timer; the
# refresh still runs, the teleport is replaced by travelling (move_zone).
# Defaults: 3600 (min), 18000 (max)
Playerbots.MinRandomBotTeleportInterval = 3600
Playerbots.MaxRandomBotTeleportInterval = 18000

