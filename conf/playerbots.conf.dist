#
#
####################################################################################################

###################################
#                                 #
# RAIDS                           #
#                                 #
###################################

####################################################################################################
#
#

# Enable buffs in ICC to make Heroic easier and more casual.
# 30% more damage, 40% damage reduction (tank bots), increased all resistances, reduced threat for
# non-tank bots, increased threat for tank bots.
# Buffs will be applied on LDW, PP, Sindragosa and Lich King.
# Default: 1 (enabled)
Playerbots.EnableICCBuffs = 1

#
#
####################################################################################################

###################################
#                                 #
# PLAYERBOTS SYSTEM SETTINGS      #
#                                 #
###################################

####################################################################################################
# DATABASE & CONNECTIONS
#
#    PlayerbotsDatabaseInfo
#        Description: Database connection settings for the playerbots server.
#        Example:     "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - (Use named pipes on Windows
#                                                                 "enable-named-pipe" to [mysqld]
#                                                                 section my.ini)
#                     ".;/path/to/unix_socket;username;password;database" - (use Unix sockets on
#                                                                           Unix/Linux)
#        Default:     "127.0.0.1;3306;acore;acore;acore_playerbots"       - (PlayerbotDatabaseInfo)

PlayerbotsDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_playerbots"

#    PlayerbotsDatabase.WorkerThreads
#        Description: The amount of worker threads spawned to handle asynchronous (delayed) MySQL
#                     statements. Each worker thread is mirrored with its own connection to the
#                     MySQL server and their own thread on the MySQL server.
#        Default:     1 - (PlayerbotsDatabase.WorkerThreads)

PlayerbotsDatabase.WorkerThreads     = 1

#    PlayerbotsDatabase.SynchThreads
#        Description: The amount of MySQL connections spawned to handle synchronous (blocking) MySQL
#                     statements.
#        Default:     1 - (PlayerbotsDatabase.SynchThreads)

PlayerbotsDatabase.SynchThreads     = 1

#    Playerbots.Updates.EnableDatabases
#        Description: Determined if updates system work with playerbots database.
#
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Playerbots.Updates.EnableDatabases = 1

# Command server port, 0 - disabled
Playerbots.CommandServerPort = 8888

#
#
####################################################################################################

####################################################################################################
# DEBUG SWITCHES
#

Playerbots.SpellDump = 0
Playerbots.LogInGroupOnly = 1
Playerbots.LogValuesPerTick = 0
Playerbots.RandomChangeMultiplier = 1

# Tell which spell is avoiding (experimental)
# Default: 0 (disabled)
Playerbots.TellWhenAvoidAoe = 0

# Enable/Disable performance monitor
Playerbots.PerfMonEnabled = 0

# Measure the busy share of the world thread: its CPU time divided by the wall time per world tick (the rest is
# waiting, mostly for the map update threads). ".playerbots worldthread" prints the cumulative counters (ticks,
# wall, CPU and playerbots-hook time in microseconds) and the core's tick percentiles (p50, p80, p95, max).
# Cost: three clock reads per world tick.
# Default: 0 (disabled)
Playerbots.PerfMonWorldThread = 0

# Log an error (once per call site) when world-thread-only code runs on another thread, e.g. on a map update thread
# with MapUpdate.Threads > 1, and log each event cache load that runs off the world thread
# Default: 0 (disabled)
Playerbots.DebugThreadChecks = 0

# Skip trigger checks that cannot fire: the chat command triggers while the bot has no chat command pending, and
# the "combat start" trigger's attackers lookup while the bot is out of combat with no group, duel, battleground
# or prioritized target. Saves CPU with many bots; commands are answered as before and combat starts are never
# missed, but "combat start" can fire once more within 1 second after the bot leaves combat or feigns death
# (the attackers value is cached for 1 second).
# Default: 0 (disabled)
Playerbots.SkipIdleTriggerChecks = 0

#
#
####################################################################################################

####################################################################################################
# CHAT SETTINGS
#

# Prefix for bot chat commands (e.g., follow, stay)
# A human chat line commands bots only when it starts with "#" (fixed, not an option): "#follow", "#c food",
# "##w follow" for a reply-channel selector. Every other line is ordinary chat. A non-empty prefix is checked after
# the "#" is removed ("#<prefix>follow").
Playerbots.CommandPrefix = ""

# Separator for bot chat commands
Playerbots.CommandSeparator = "\\\\"

# Enable automatic item count/trade trigger when a chat message contains
# item-related keywords. When enabled (1), mentioning items in chat
# (e.g. "food", "potion", "ammo") will automatically show inventory and
# open a trade window with the bot. Explicit "c" and "t" commands still
# work regardless of this setting.
# Default: 1 (enabled)
Playerbots.EnableAutoTradeOnItemMention = 1

# Enable bots talking (say / yell / general chatting / lfg)
Playerbots.RandomBotTalk = 1
# Enable bots emoting
Playerbots.RandomBotEmote = 0
# Enable randombots suggesting dungeons in chat
Playerbots.RandomBotSuggestDungeons = 1
# Bots greet players when invited
Playerbots.EnableGreet = 0
# Chance to reply to toxic links with toxic links (0-100)
Playerbots.ToxicLinksRepliesChance = 30
# Chance to reply to Thunderfury with Thunderfury (0-100)
Playerbots.ThunderfuryRepliesChance = 40
# Chance bots will chat in guild about certain events (int) (0-100)
Playerbots.GuildRepliesRate = 100
# Bots without a master will say their lines
Playerbots.RandomBotSayWithoutMaster = 0
# Bots whisper their master when they eat/drink/feast ("Eating [item] (85%)"). Set to 0 to
# suppress those consumable-use messages (bots still sit and eat, just silently).
# Default: 1 (enabled)
Playerbots.AnnounceConsumableUse = 1

#
#
####################################################################################################

####################################################################################################
# Broadcast rates
#

# Enable/disable broadcasts globally
# Default: 1 (enabled)
Playerbots.EnableBroadcasts = 1

# All broadcast chances should be in range 0-30000
# Value of 0 will disable this particular broadcast
# Setting value to 30000 does not guarantee the broadcast, as there are some internal randoms as well
# Setting channel broadcast chance to 0 will re-route most broadcasts to other available channels
# Setting all channel broadcasts to 0 will disable most broadcasts
Playerbots.BroadcastToGuildGlobalChance = 30000
Playerbots.BroadcastToWorldGlobalChance = 30000
Playerbots.BroadcastToGeneralGlobalChance = 30000
Playerbots.BroadcastToTradeGlobalChance = 30000
Playerbots.BroadcastToLFGGlobalChance = 30000
Playerbots.BroadcastToLocalDefenseGlobalChance = 30000
Playerbots.BroadcastToWorldDefenseGlobalChance = 30000
Playerbots.BroadcastToGuildRecruitmentGlobalChance = 30000

# Individual settings
# Setting one of these to 0 will disable the particular broadcast
Playerbots.BroadcastChanceLootingItemPoor = 30
Playerbots.BroadcastChanceLootingItemNormal = 150
Playerbots.BroadcastChanceLootingItemUncommon = 10000
Playerbots.BroadcastChanceLootingItemRare = 20000
Playerbots.BroadcastChanceLootingItemEpic = 30000
Playerbots.BroadcastChanceLootingItemLegendary = 30000
Playerbots.BroadcastChanceLootingItemArtifact = 30000

Playerbots.BroadcastChanceQuestAccepted = 6000
Playerbots.BroadcastChanceQuestUpdateObjectiveCompleted = 300
Playerbots.BroadcastChanceQuestUpdateObjectiveProgress = 300
Playerbots.BroadcastChanceQuestUpdateFailedTimer = 300
Playerbots.BroadcastChanceQuestUpdateComplete = 1000
Playerbots.BroadcastChanceQuestTurnedIn = 10000

Playerbots.BroadcastChanceKillNormal = 30
Playerbots.BroadcastChanceKillElite = 300
Playerbots.BroadcastChanceKillRareelite = 3000
Playerbots.BroadcastChanceKillWorldboss = 20000
Playerbots.BroadcastChanceKillRare = 10000
Playerbots.BroadcastChanceKillUnknown = 100
Playerbots.BroadcastChanceKillPet = 10
Playerbots.BroadcastChanceKillPlayer = 30

Playerbots.BroadcastChanceLevelupGeneric = 20000
Playerbots.BroadcastChanceLevelupTenX = 30000
Playerbots.BroadcastChanceLevelupMaxLevel = 30000

Playerbots.BroadcastChanceSuggestInstance = 5000
Playerbots.BroadcastChanceSuggestQuest = 10000
Playerbots.BroadcastChanceSuggestGrindMaterials = 5000
Playerbots.BroadcastChanceSuggestGrindReputation = 5000
Playerbots.BroadcastChanceSuggestSell = 300
Playerbots.BroadcastChanceSuggestSomething = 30000

# Bots will say very rude things
Playerbots.BroadcastChanceSuggestSomethingToxic = 0

# Specifically for "<word> [item link]"
Playerbots.BroadcastChanceSuggestToxicLinks = 0

# Prefix is used as a word in "<word> [item link]"
Playerbots.ToxicLinksPrefix = gnomes

# Chance to suggest Thunderfury
Playerbots.BroadcastChanceSuggestThunderfury = 1

# Does not depend on global chance
Playerbots.BroadcastChanceGuildManagement = 30000

#
#
####################################################################################################

####################################################################################################
# LOGS
#

# Custom config to allow logfiles to be created.
# Example: Playerbots.AllowedLogFiles = travelNodes.csv,travelPaths.csv,TravelNodeStore.h,bot_movement.csv,bot_location.csv
Playerbots.AllowedLogFiles = ""

#
#
####################################################################################################

##############################################
# Deprecated Settings (yet still in use)     #
##############################################

# Guild Task system
Playerbots.EnableGuildTasks = 0

# Chance bot chooses RPG (Teleport to random camp for their level) instead of grinding
Playerbots.RandomBotRpgChance = 0.20

# Set randombots movement speed to walking anywhere
Playerbots.RandombotsWalkingRPG = 0

# Set randombots movement speed to walking only inside buildings
Playerbots.RandombotsWalkingRPG.InDoors = 0

Playerbots.MinRandomBotsPriceChangeInterval = 7200
Playerbots.MaxRandomBotsPriceChangeInterval = 172800
Playerbots.MinRandomBotChangeStrategyTime = 180
Playerbots.MaxRandomBotChangeStrategyTime = 720

# How often tasks are changed
Playerbots.MinGuildTaskChangeTime = 172800
Playerbots.MaxGuildTaskChangeTime = 432000

# Mail spam interval
Playerbots.MinGuildTaskAdvertisementTime = 300
Playerbots.MaxGuildTaskAdvertisementTime = 28800

# Delay before reward is sent
Playerbots.MinGuildTaskRewardTime = 300
Playerbots.MaxGuildTaskRewardTime = 3600

# Cleanup of guild tasks interval
Playerbots.GuildTaskAdvertCleanupTime = 300

# Specify max distance between victim and bot when creating guild kill task
Playerbots.GuildTaskKillTaskDistance = 200

# Distance margin for facade calculations
Playerbots.TargetPosRecalcDistance = 0.1

# Allow bots to be summoned near innkeepers
Playerbots.SummonAtInnkeepersEnabled = 1
